{
  "name": "PlatformTool",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "performance_score": {
      "type": "number"
    },
    "cost_tier": {
      "type": "string",
      "enum": [
        "free",
        "freemium",
        "paid",
        "proprietary"
      ]
    },
    "cost_details": {
      "type": "string"
    },
    "africa_available": {
      "type": "string",
      "enum": [
        "yes",
        "limited",
        "no"
      ]
    },
    "base44_compatible": {
      "type": "string",
      "enum": [
        "native",
        "api",
        "none"
      ]
    },
    "production_compatible": {
      "type": "boolean",
      "default": true
    },
    "official_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}