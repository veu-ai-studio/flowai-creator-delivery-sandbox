{
  "name": "Deployment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "live_url": {
      "type": "string"
    },
    "app_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "deploying",
        "live",
        "failed"
      ],
      "default": "deploying"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "slug",
    "live_url"
  ]
}