{
  "name": "AccessibilityAudit",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID of parent QAAuditReport"
    },
    "url": {
      "type": "string",
      "description": "URL audited"
    },
    "wcag_level": {
      "type": "string",
      "enum": [
        "A",
        "AA",
        "AAA"
      ],
      "description": "Target WCAG compliance level"
    },
    "score": {
      "type": "number",
      "description": "Accessibility score 0-100"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "element": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "violations": {
      "type": "integer",
      "description": "Total violation count"
    },
    "passes": {
      "type": "integer",
      "description": "Total passed checks"
    },
    "incomplete": {
      "type": "integer",
      "description": "Checks needing manual review"
    }
  },
  "required": [
    "report_id",
    "url",
    "score"
  ]
}