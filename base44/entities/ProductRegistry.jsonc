{
  "name": "ProductRegistry",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "Display name for this product"
    },
    "url": {
      "type": "string",
      "description": "Product URL"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_score": {
      "type": "number",
      "description": "Most recent final score"
    },
    "last_improvement": {
      "type": "number",
      "description": "Score delta from last run"
    },
    "run_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "owner_email",
    "url"
  ]
}