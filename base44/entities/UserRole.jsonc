{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "email": {
      "type": "string",
      "description": "User email address"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operator",
        "client"
      ],
      "description": "User role assignment"
    },
    "assigned_product": {
      "type": "string",
      "description": "Product scope for client role only"
    },
    "totp_secret": {
      "type": "string",
      "description": "Encrypted TOTP secret for two-factor auth (reserved for future enhancement sprint)"
    },
    "admin_key_hash": {
      "type": "string",
      "description": "Bcrypt hash of Admin Secret Key (admin only)"
    },
    "trusted_devices": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of trusted device records with fingerprint and expiry"
    },
    "created_by": {
      "type": "string",
      "description": "Email of user who created this role assignment"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful login timestamp"
    },
    "last_login_ip": {
      "type": "string",
      "description": "IP address of last login"
    },
    "failed_login_count": {
      "type": "number",
      "default": 0,
      "description": "Consecutive failed login attempts (resets on success)"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Account locked until this timestamp (30 min after 5 failed attempts)"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Account suspended by Admin"
    }
  },
  "required": [
    "email",
    "role"
  ]
}