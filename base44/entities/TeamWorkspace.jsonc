{
  "name": "TeamWorkspace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Workspace name"
    },
    "description": {
      "type": "string",
      "description": "Workspace description"
    },
    "members": {
      "type": "array",
      "description": "Team members with roles",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ]
          }
        }
      }
    },
    "shared_urls": {
      "type": "array",
      "description": "URLs being audited in workspace",
      "items": {
        "type": "string"
      }
    },
    "co_editing_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "members"
  ]
}