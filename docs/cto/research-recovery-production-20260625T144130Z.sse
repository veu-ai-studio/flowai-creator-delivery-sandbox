xt-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/speaking\">Speaking</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/publications\">Publications</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/contact\">Contact</a></div><a title=\"Carbon Footprint Calculator\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/carbon-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf h-4 w-4\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg></a><a title=\"Dr. Udo's Banner &amp; Profile Summary\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/linkedin-banner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-square-user-round h-4 w-4\"><path d=\"M18 21a6 6 0 0 0-12 0\"></path><circle cx=\"12\" cy=\"11\" r=\"4\"></circle><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"></rect></svg></a><div class=\"relative hidden xl:block\"><button title=\"Search books, news...\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=