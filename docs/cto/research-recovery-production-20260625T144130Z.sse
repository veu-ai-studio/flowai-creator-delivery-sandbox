ixed top-16 lg:top-20 left-0 right-0 z-40 bg-accent text-accent-foreground flex items-center justify-center py-1.5 px-8\"><a class=\"text-xs font-semibold hover:underline flex-1 text-center\" href=\"/linkedin-banner\">View Dr. Udo's Profile &amp; Banner Summary →</a><button class=\"absolute right-3 text-accent-foreground/70 hover:text-accent-foreground text-base leading-none\" aria-label=\"Dismiss\">×</button></div><main class=\"flex-1 pt-24 lg:pt-28 transition-all duration-300\"><div><div class=\"relative bg-primary text-white overflow-hidden\"><div class=\"absolute inset-0 bg-cover bg-center bg-no-repeat\" style=\"background-image: url(&quot;https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/0ff53a454_image.png&quot;);\"></div><div class=\"absolute inset-0 bg-primary/25\"></div><div class=\"relative max-w-[1200px] mx-auto px-4 sm:px-6 py-24 lg:py-36\"><div class=\"max-w-5xl\" style=\"opacity: 1;\"><div class=\"overflow-hidden mb-6\" style=\"opacity: 0; transform: translateY(7.22265px);\"><h1 class=\"font-heading text-2xl md:text-3xl lg:text-4xl font-bold whitespace-nowrap\" style=\"transform: none;\"><a class=\"hover:text-accent transition-colors\" href=\"/about#early-career\">Engineer.</a> <a class=\"text-accent hover:text-accent/80 transition-colors\" href=\"/about#career\">Executive.</a> <a class=\"hover:text-accent transition-colors\" href=\"/abasi-people\">Community Leader.</a> <a class=\"text-accent hover:text-accent/80 transition-colors\" href=\"/veu-ai-studio\">AI Builder.</a> <a class=\"hover:text-accent transition-colors\" href=\"/speaking\">Speaker.</a></h1></div><div class=\"space-y-6 mb-10\" style=\"opacity: 0; transform: translateY(12.6556px);\"><p class=\"text-lg lg:text-xl text-white/80 leading-relaxed text-center\">Victor Udo, FNSE, PhD — AI platform builder, sustainability leader, electric power sector executive, and Abasi People Movement champion with 25+ years of impact across business, government, and academia.</p><p class=\"text-xl lg:text-2xl font-bold text-accent leading-relaxed text-center\">Building AI Platforms for Individual and Organizational Impacts</p></div><div class=\"flex flex-wrap gap-4\" style=\"opacity: 0; transform: translateY(19.0991px);\"><a href=\"/platforms\" class=\"inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-xl bg-accent text-accent-foreground hover:bg-accent/90\">Explore My Platforms<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a href=\"/publications\" class=\"inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-xl border-2 border-white text-white hover:bg-white/10\">View My Books<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div><div class=\"relative flex justify-center mb-4\"><div class=\"bg-black/60 backdrop-blur-sm px-4 py-2 rounded-lg\"><p class=\"text-xs text-white font-medium\">Background image taken during a speaking engagement</p></div></div><div class=\"absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-background to-transparent\"></div></div><section class=\"bg-secondary py-14 lg:py-16\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6\"><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0+</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Years of Transformational Leadership</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">AI Platforms Built &amp; Launching</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">~30%</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Carbon Reduction at Bucknell</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0.76 MW</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Solar Farm at Bucknell</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0.8M</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Hectares Under ADC MOU (1.6M Forest + 200K Agriculture)</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Abasi Peoples Unity</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0M+</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Media Reach — POL Radio &amp; TV, Akwa Ibom (2012–2019)</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">~700MW</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Ibom Power Capacity Licensed</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">~155MW</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Ibom Power Macro-Grid Island</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Peer-Reviewed Publications</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">0+</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Citations</div></div><div class=\"text-center\" style=\"opacity: 0; transform: translateY(15px);\"><div class=\"font-heading text-3xl lg:text-4xl font-bold text-primary mb-1.5 tabular-nums\">~3,500</div><div class=\"text-xs text-muted-foreground font-medium leading-snug\">Reads</div></div></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">What Victor Does</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Five Dimensions of Impact</h2></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\" style=\"opacity: 0;\"><div style=\"opacity: 0; transform: translateY(30px);\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group h-full flex flex-col\"><div class=\"w-11 h-11 rounded-lg bg-secondary flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-brain h-5 w-5 text-primary\"><path d=\"M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z\"></path><path d=\"M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z\"></path><path d=\"M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4\"></path><path d=\"M17.599 6.5a3 3 0 0 0 .399-1.375\"></path><path d=\"M6.003 5.125A3 3 0 0 0 6.401 6.5\"></path><path d=\"M3.477 10.896a4 4 0 0 1 .585-.396\"></path><path d=\"M19.938 10.5a4 4 0 0 1 .585.396\"></path><path d=\"M6 18a4 4 0 0 1-1.967-.516\"></path><path d=\"M19.967 17.484A4 4 0 0 1 18 18\"></path></svg></div><h3 class=\"font-heading text-xl font-bold text-foreground mb-3\">AI Platform Builder</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5 flex-1\">Founder of VEU AI Studio, building 4 AI SaaS platforms serving enterprise sustainability, relationship intelligence, community engagement, and publishing.</p><a class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\" href=\"/platforms\">Explore the Platforms <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div style=\"opacity: 0; transform: translateY(30px);\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group h-full flex flex-col\"><div class=\"w-11 h-11 rounded-lg bg-secondary flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf h-5 w-5 text-primary\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg></div><h3 class=\"font-heading text-xl font-bold text-foreground mb-3\">Decarbonization Leader</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5 flex-1\">Chairman/CEO of Afri Decarbonization Corporation, focused on practical pathways to net-zero for organizations and governments across West Africa.</p><a class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\" href=\"/afri-decarbonization\">Learn About ADC <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div style=\"opacity: 0; transform: translateY(30px);\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group h-full flex flex-col\"><div class=\"w-11 h-11 rounded-lg bg-secondary flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 h-5 w-5 text-primary\"><path d=\"M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z\"></path><path d=\"M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2\"></path><path d=\"M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2\"></path><path d=\"M10 6h4\"></path><path d=\"M10 10h4\"></path><path d=\"M10 14h4\"></path><path d=\"M10 18h4\"></path></svg></div><h3 class=\"font-heading text-xl font-bold text-foreground mb-3\">Sustainability Leader</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5 flex-1\">Author of 3 books and 14 papers. Former Director of Sustainability at Bucknell University, chairing the President's Sustainability Council toward carbon neutrality by 2030.</p><a class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\" href=\"/publications\">View Books &amp; Research <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div style=\"opacity: 0; transform: translateY(30px);\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group h-full flex flex-col\"><div class=\"w-11 h-11 rounded-lg bg-secondary flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-briefcase h-5 w-5 text-primary\"><path d=\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg></div><h3 class=\"font-heading text-xl font-bold text-foreground mb-3\">Executive Advisor</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5 flex-1\">25+ years spanning Fortune 500 energy companies (Pepco Holdings), government (Akwa Ibom State), and academic leadership across the USA and Nigeria.</p><a class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\" href=\"/advisory\">Advisory Services <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div style=\"opacity: 0; transform: translateY(30px);\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group h-full flex flex-col\"><div class=\"w-11 h-11 rounded-lg bg-secondary flex items-center justify-center mb-5 group-hover:bg-accent/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 text-primary\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h3 class=\"font-heading text-xl font-bold text-foreground mb-3\">Abasian Nationality Champion</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5 flex-1\">President of the Abasi People Foundation, uniting Ibibio, Annang, Efik, Oro, Ekid, Ekoi, and Obolo peoples under a shared vision of belonging and sustainable development.</p><a class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\" href=\"/abasi-people\">About the Foundation <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></div></section><section class=\"bg-secondary py-10 lg:py-12\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><p class=\"text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground mb-6\">Career Milestones</p><div class=\"flex flex-wrap justify-center gap-3\"><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Atlantic City Electric</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Conectiv Power Delivery</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Pepco Holdings (now part of Exelon)</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Ibom Power</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Akwa Ibom State Government</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Bucknell University</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">University of Delaware</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">University of Pennsylvania</span><span class=\"px-4 py-2 rounded-full border border-border text-xs font-medium text-muted-foreground bg-card hover:border-primary/40 hover:text-foreground transition-colors\">Howard University</span></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Global Impact</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Work Across Two Continents</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Explore Dr. Victor Udo's projects, initiatives, and leadership across the USA and West Africa — from decarbonization and energy policy to sustainability and community empowerment.</p></div><div class=\"w-full rounded-lg overflow-hidden shadow-lg border border-border\"><div class=\"leaflet-container leaflet-touch leaflet-fade-anim leaflet-grab leaflet-touch-drag leaflet-touch-zoom\" tabindex=\"0\" style=\"height: 600px; width: 100%; position: relative;\"><div class=\"leaflet-pane leaflet-map-pane\" style=\"transform: translate3d(0px, 0px, 0px);\"><div class=\"leaflet-pane leaflet-tile-pane\"><div class=\"leaflet-layer \" style=\"z-index: 1; opacity: 1;\"><div class=\"leaflet-tile-container leaflet-zoom-animated\" style=\"z-index: 18; transform: translate3d(0px, 0px, 0px) scale(1);\"><img alt=\"\" src=\"https://a.basemaps.cartocdn.com/light_all/3/3/3.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(176px, 191px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://b.basemaps.cartocdn.com/light_all/3/4/3.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(432px, 191px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://c.basemaps.cartocdn.com/light_all/3/3/2.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(176px, -65px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://a.basemaps.cartocdn.com/light_all/3/4/2.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(432px, -65px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://b.basemaps.cartocdn.com/light_all/3/3/4.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(176px, 447px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://c.basemaps.cartocdn.com/light_all/3/4/4.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(432px, 447px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://c.basemaps.cartocdn.com/light_all/3/2/3.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(-80px, 191px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://c.basemaps.cartocdn.com/light_all/3/5/3.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(688px, 191px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://b.basemaps.cartocdn.com/light_all/3/2/2.png\" class=\"leaflet-tile leaflet-tile-loaded\" style=\"width: 256px; height: 256px; transform: translate3d(-80px, -65px, 0px); opacity: 1;\"><img alt=\"\" src=\"https://b.basemaps