pe=\"application/ld+json\" data-schema=\"webpage-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Speaking & Executive Advisory\",\"description\":\"Book Victor Udo, FNSE, PhD for keynotes, panels, and corporate workshops on sustainability, AI, ESG, and leadership.\",\"url\":\"https://victorudo.com/speaking\",\"isPartOf\":{\"@type\":\"WebSite\",\"url\":\"https://victorudo.com\",\"name\":\"Dr. Victor Udo\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorudo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Speaking\",\"item\":\"https://victorudo.com/speaking\"}]}}</script><script type=\"application/ld+json\" data-schema=\"professional-service-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Speaking Engagements with Victor Udo, FNSE, PhD\",\"provider\":{\"@type\":\"Person\",\"name\":\"Victor Udo, FNSE, PhD\",\"email\":\"info@victorudo.com\",\"url\":\"https://victorudo.com/speaking\"},\"serviceType\":[\"Keynote Presentations\",\"Panel Discussions\",\"Corporate Workshops\",\"University Lectures\",\"Government Forums\"],\"areaServed\":[\"US\",\"Nigeria\",\"International\"],\"description\":\"Executive speaking services on AI decision intelligence, sustainability leadership, ESG governance, decarbonization, and African development.\"}</script></head>\n <body>\n  <div id=\"root\"><div class=\"min-h-screen flex flex-col\"><div class=\"fixed top-0 left-0 right-0 z-50\"><nav class=\"transition-all duration-500 bg-primary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"flex items-center justify-between h-16 lg:h-20\"><a class=\"flex-shrink-0\" href=\"/\"><div class=\"text-white\"><div class=\"font-heading text-lg lg:text-xl font-bold leading-tight\">Dr. Victor Udo</div><div class=\"text-white/60 text-[10px] tracking-wide hidden sm:block whitespace-nowrap\">Executive · AI Builder · Author · Community Leader</div></div></a><div class=\"hidden lg:flex items-center gap-1\"><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/\">Home</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/about\">About</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/veu-ai-studio\">VEU AI Studio</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/abasi-people\">Abasi People</a><div class=\"absolute left-0 mt-0 w-52 bg-primary border border-white/20 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50\"><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-colors\" href=\"/abasi-people\">Abasi People Foundation</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-colors\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></div></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white bg-white/15\" aria-current=\"page\" href=\"/speaking\">Speaking</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/publications\">Publications</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/contact\">Contact</a></div><a title=\"Carbon Footprint Calculator\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/carbon-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf h-4 w-4\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg></a><a title=\"Dr. Udo's Banner &amp; Profile Summary\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/linkedin-banner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-square-user-round h-4 w-4\"><path d=\"M18 21a6 6 0 0 0-12 0\"></path><circle cx=\"12\" cy=\"11\" r=\"4\"></circle><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"></rect></svg></a><div class=\"relative hidden xl:block\"><button title=\"Search books, news...\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search h-4 w-4\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></button></div><div class=\"relative group\"><button class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors text-white/75 hover:text-white hover:bg-white/10\" aria-expanded=\"false\" aria-haspopup=\"menu\">More ▾</button><div class=\"absolute right-0 mt-0 w-52 bg-primary border border-white/20 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50\"><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/blog\">Blog &amp; Insights</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/carbon-calculator\">Carbon Calculator</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/afri-decarbonization\">Afri Decarbonization</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/advisory\">Advisory Services</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/news\">News</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/gallery\">Gallery</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/mothers-memorial\">Mother's Memorial</a></div></div></div><div class=\"flex items-center gap-3\"><a href=\"/contact\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold text-xs sm:text-sm px-4 sm:px-6 h-9 sm:h-10 rounded-lg shadow-md\">Work With Victor</button></a><button class=\"lg:hidden text-white p-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></div></nav></div><div class=\"fixed top-16 lg:top-20 left-0 right-0 z-40 bg-accent text-accent-foreground flex items-center justify-center py-1.5 px-8\"><a class=\"text-xs font-semibold hover:underline flex-1 text-center\" href=\"/linkedin-banner\">View Dr. Udo's Profile &amp; Banner Summary →</a><button class=\"absolute right-3 text-accent-foreground/70 hover:text-accent-foreground text-base leading-none\" aria-label=\"Dismiss\">×</button></div><main class=\"flex-1 pt-24 lg:pt-28 transition-all duration-300\"><div><div class=\"relative bg-primary text-white py-20 lg:py-28 overflow-hidden\"><div class=\"absolute inset-0 pointer-events-none\" aria-hidden=\"true\"><div class=\"absolute -top-32 -right-32 w-96 h-96 rounded-full bg-white/[0.03]\"></div><div class=\"absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-accent/[0.07]\"></div></div><div class=\"relative max-w-[1200px] mx-auto px-4 sm:px-6 text-center\"><h1 class=\"font-heading text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight\">Speaking &amp; Executive Advisory</h1><p class=\"text-white/70 text-lg lg:text-xl max-w-3xl mx-auto leading-relaxed\">Victor Udo, FNSE, PhD brings 25 years of cross-sector leadership to keynote stages, boardrooms, and executive programs worldwide.</p></div></div><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 1;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(0.172341px);\">Keynote Topics</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(2.32318px);\">Topics Victor Speaks On</h2></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">AI Platforms for Sustainability</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">How agentic AI is transforming ESG, decarbonization, and sustainable development decision-making.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Decarbonization at Scale</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Practical pathways from carbon commitments to net-zero implementation for enterprises and governments.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">The Future of Electric Power</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Digitalization, decentralization, and decarbonization — the 3Ds reshaping global energy infrastructure.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Leadership in Transition</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Lessons from leading across Fortune 500 corporations, government, and academia in two countries.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Building AI-First Organizations</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">How executives can architect AI-native strategies without losing the human decision-making core.</p></div></div><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Past Engagements</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Past Engagements</h2></div><div class=\"bg-secondary rounded-lg p-8 max-w-3xl mx-auto text-center mb-12\"><p class=\"text-sm text-muted-foreground leading-relaxed\">March Innovation Smart Energy Summit 2022 · Bucknell University President's Sustainability Council · Ibom Power Company Board · Akwa Ibom State Government Advisory.</p></div><div class=\"text-center\"><a href=\"/contact?type=speaking\" class=\"inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-xl bg-accent text-accent-foreground hover:bg-accent/90\">Request to Speak<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Events</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Speaking Engagements</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Past and upcoming conferences, forums, and speaking opportunities where Victor Udo, FNSE, PhD brings his expertise in AI, sustainability, ESG leadership, and transformational change.</p></div><div class=\"flex gap-3 justify-center mb-10\"><button class=\"px-6 py-2.5 rounded-lg font-semibold text-sm transition-colors bg-accent text-accent-foreground\">Upcoming Events</button><button class=\"px-6 py-2.5 rounded-lg font-semibold text-sm transition-colors bg-card border border-border/50 text-foreground hover:bg-secondary\">Past Events</button></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\" style=\"opacity: 1;\"><div style=\"opacity: 0; transform: translateY(0.953294px);\"><div class=\"rounded-lg border shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col bg-accent/5 border-accent/30 ring-1 ring-accent/20\"><div class=\"p-6 flex flex-col flex-1\"><span class=\"text-xs font-semibold bg-accent/10 text-accent px-2.5 py-1 rounded-full w-fit mb-3\">Featured</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2 leading-snug\">AASHE Annual Conference 2026</h3><p class=\"text-sm font-medium text-accent mb-4\">Enterprise Impact Performance: Decision Intelligence for Carbon Neutrality at Scale</p><div class=\"space-y-2 text-sm text-muted-foreground mb-5 flex-1\"><div class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-4 w-4 text-accent flex-shrink-0 mt-0.5\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg><span>October 15, 2026</span></div><div class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-4 w-4 text-accent flex-shrink-0 mt-0.5\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span>Denver, Colorado</span></div></div><p class=\"text-xs text-muted-foreground italic mb-4\">Association for the Advancement of Sustainability in Higher Education</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Keynote presentation on how higher education institutions can move from sustainability reporting to real-time decision intelligence using AI-powered governance frameworks.</p><div class=\"flex flex-wrap gap-3 mt-auto\"></div></div></div></div><div style=\"opacity: 0; transform: translateY(2.98456px);\"><div class=\"rounded-lg border shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col bg-card border-border/50\"><div class=\"p-6 flex flex-col flex-1\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-2 leading-snug\">Smart Energy Decisions — Net Zero Forum 2026</h3><p class=\"text-sm font-medium text-accent mb-4\">Decarbonization &amp; Digital Transformation in the Energy Sector</p><div class=\"space-y-2 text-sm text-muted-foreground mb-5 flex-1\"><div class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-4 w-4 text-accent flex-shrink-0 mt-0.5\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg><span>September 22, 2026</span></div><div class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-4 w-4 text-accent flex-shrink-0 mt-0.5\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span>New York, NY</span></div></div><p class=\"text-xs text-muted-foreground italic mb-4\">Smart Energy Decisions</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Panel discussion on the role of digitalization, decentralization, and nature-based solutions in achieving net-zero energy systems.</p><div class=\"flex flex-wrap gap-3 mt-auto\"></div></div></div></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Broadcast Archive</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">The 'DO' Show — Episode Archive</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">ThePOLwithVictorUdo was broadcast on 2 television stations (AKBC TV Channel 45/StarTimes 113 and NTA Uyo) and 5 radio stations (AKBC Radio 90.5 FM, Comfort FM 95.1 FM, Planet FM 101.1 FM, Atlantic FM 104.5 FM, Inspiration FM 105.9 FM) across Abia, Akwa Ibom, Cross River, and Rivers States — reaching over 10 million people for more than three years.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-5 mb-4\"><div class=\"bg-card rounded-lg p-5 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col\"><p class=\"text-xs text-accent font-semibold mb-2\">Agriculture</p><h3 class=\"font-heading text-sm font-bold text-foreground leading-snug mb-4 flex-1\"><span class=\"text-muted-foreground\">1.</span> Agrobusiness — Encouraging Young Leaders to Engage in Agriculture</h3><a href=\"https://www.youtube.com/watch?v=zIhh18r-tHs\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow px-4 py-2 w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold rounded-lg text-xs h-9\">Watch Episode</button></a></div><div class=\"bg-card rounded-lg p-5 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col\"><p class=\"text-xs text-accent font-semibold mb-2\">Industry &amp; Skills</p><h3 class=\"font-heading text-sm font-bold text-foreground leading-snug mb-4 flex-1\"><span class=\"text-muted-foreground\">2.</span> Challenges &amp; Impediments to Industrialization Among LGAs and States</h3><a href=\"https://www.youtube.com/watch?v=3rupBqIsDV0\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow px-4 py-2 w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold rounded-lg text-xs h-9\">Watch Episode</button></a></div><div class=\"bg-card rounded-lg p-5 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col\"><p class=\"text-xs text-accent font-semibold mb-2\">Governance</p><h3 class=\"font-heading text-sm font-bold text-foreground leading-snug mb-4 flex-1\"><span class=\"text-muted-foreground\">3.</span> Natural Resources in Akwa Ibom State — Converting &amp; Improving the Economy</h3><a href=\"https://www.youtube.com/watch?v=-CD_tqGvAAA\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow px-4 py-2 w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold rounded-lg text-xs h-9\">Watch Episode</button></a></div><div class=\"bg-card rounded-lg p-5 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col\"><p class=\"text-xs text-accent font-semibold mb-2\">Youth &amp; Entrepreneurship</p><h3 class=\"font-heading text-sm font-bold text-foreground leading-snug mb-4 flex-1\"><span class=\"text-muted-foreground\">4.</span> Billion Dollar Ideas — Job Opportunities Using New Media</h3><a href=\"https://www.youtube.com/watch?v=8S1oBZ1ln9E\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow px-4 py-2 w-full bg-primary hover:bg-primary/90 text-primary-foreground font-semibold rounded-lg text-xs h-9\">Watch Episode</button></a></div