th 10M+ media reach across Nigeria and the USA.\" name=\"description\"><script type=\"application/ld+json\" data-schema=\"breadcrumb-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorudo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Speaking\",\"item\":\"https://victorudo.com/speaking\"}]}</script><script type=\"application/ld+json\" data-schema=\"webpage-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Speaking & Executive Advisory\",\"description\":\"Book Victor Udo, FNSE, PhD for keynotes, panels, and corporate workshops on sustainability, AI, ESG, and leadership.\",\"url\":\"https://victorudo.com/speaking\",\"isPartOf\":{\"@type\":\"WebSite\",\"url\":\"https://victorudo.com\",\"name\":\"Dr. Victor Udo\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorudo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Speaking\",\"item\":\"https://victorudo.com/speaking\"}]}}</script><script type=\"application/ld+json\" data-schema=\"professional-service-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Speaking Engagements with Victor Udo, FNSE, PhD\",\"provider\":{\"@type\":\"Person\",\"name\":\"Victor Udo, FNSE, PhD\",\"email\":\"info@victorudo.com\",\"url\":\"https://victorudo.com/speaking\"},\"serviceType\":[\"Keynote Presentations\",\"Panel Discussions\",\"Corporate Workshops\",\"University Lectures\",\"Government Forums\"],\"areaServed\":[\"US\",\"Nigeria\",\"International\"],\"description\":\"Executive speaking services on AI decision intelligence, sustainability leadership, ESG governance, decarbonization, and African development.\"}</script></head>\n <body>\n  <div id=\"root\"><div class=\"min-h-screen flex flex-col\"><div class=\"fixed top-0 left-0 rig