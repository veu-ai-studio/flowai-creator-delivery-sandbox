on\" aria-label=\"Zoom out\" aria-disabled=\"false\"><span aria-hidden=\"true\">−</span></a></div><div class=\"leaflet-control-attribution leaflet-control\"><a href=\"https://leafletjs.com\" title=\"A JavaScript library for interactive maps\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12\" height=\"8\" viewBox=\"0 0 12 8\" class=\"leaflet-attribution-flag\"><path fill=\"#4C7BE1\" d=\"M0 0h12v4H0z\"></path><path fill=\"#FFD500\" d=\"M0 4h12v3H0z\"></path><path fill=\"#E0BC00\" d=\"M0 7h12v1H0z\"></path></svg> Leaflet</a> <span aria-hidden=\"true\">|</span> © OpenStreetMap contributors © CARTO</div></div></div></div><div class=\"bg-card border-t border-border p-4\"><p class=\"text-xs font-semibold text-foreground mb-3\">Impact Zones</p><div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\"><div class=\"flex items-center gap-2\"><div class=\"w-4 h-4 rounded-full bg-green-500\"></div><span class=\"text-xs text-muted-foreground\">Nigeria / Decarbonization</span></div><div class=\"flex items-center gap-2\"><div class=\"w-4 h-4 rounded-full bg-amber-500\"></div><span class=\"text-xs text-muted-foreground\">US Energy &amp; PJM Grid</span></div><div class=\"flex items-center gap-2\"><div class=\"w-4 h-4 rounded-full bg-blue-500\"></div><span class=\"text-xs text-muted-foreground\">US Academia &amp; Sustainability</span></div><div class=\"flex items-center gap-2\"><div class=\"w-4 h-4 rounded-full bg-violet-500\"></div><span class=\"text-xs text-muted-foreground\">Poland / International Research</span></div><div class=\"flex items-center gap-2\"><div class=\"w-4 h-4 rounded-full bg-pink-500\"></div><span class=\"text-xs text-muted-foreground\">Europe / Energy &amp; Innovation</span></div></div></div></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Current Work — AI Platforms</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">VEU AI Studio — Intelligent Platforms for Real-World Impact</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Victor is the Founder of VEU AI Studio, a portfolio of AI Platforms designed for organizations that need to move from information to knowledge to decisions to measurable real-world impact. Four agentic AI platforms are in active development and commercialization.</p></div><div class=\"flex items-center justify-center gap-2 md:gap-4 mb-14 flex-wrap\"><div class=\"flex items-center gap-2 md:gap-4\"><span class=\"bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-semibold\">Information</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-2 md:gap-4\"><span class=\"bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-semibold\">Knowledge</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-2 md:gap-4\"><span class=\"bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-semibold\">Decisions</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-2 md:gap-4\"><span class=\"bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-semibold\">Impact</span></div></div><div class=\"grid md:grid-cols-2 gap-6 mb-12\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">SAIGE</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Enterprise AI platform for ESG, SDGs, EHS, CSR, and Sustainability governance. Introduces Enterprise Impact Performance (EIP) — a unified intelligence layer for people, planet, and progress.</p><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">RelTwin</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Relationship intelligence platform using Relationship Digital Twins (RDT) to improve organizational leadership, communication, and performance.</p><a href=\"https://reltwin.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">ReachSMS</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">SMS-first community management and connections infrastructure for online communities, value exchange, and services.</p><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">PressAI</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Virtual end-to-end publishing and knowledge-sharing infrastructure — amplifying underrepresented voices through AI-powered content creation.</p><a href=\"https://ourpublishingai.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div><div class=\"text-center\"><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold px-8 h-12 text-base rounded-lg shadow-md\">Explore All Platforms <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></section><section class=\"py-20 lg:py-24 bg-primary text-primary-foreground\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"max-w-6xl mx-auto\"><div class=\"mb-12 text-white\"><h2 class=\"font-heading text-4xl md:text-5xl font-bold mb-4 leading-tight\">Every organisation is accountable for the impact it creates on society. <span class=\"text-accent\">Most are still flying blind.</span></h2><p class=\"text-white/70 text-base leading-relaxed max-w-3xl\">SAIGE is an <strong>Agentic AI platform</strong> that unifies ESG, Sustainability, SDGs, EHS and CSR into a single <strong>Enterprise Impact Performance (EIP) score</strong> — giving executives, domain leaders, and practitioners the tools and intelligence to make the best decisions and act responsibly across <span class=\"text-accent\">People, Planet, Peace, Progress, and Profits.</span></p></div><div class=\"grid lg:grid-cols-2 gap-8\"><div class=\"space-y-8\"><div class=\"border border-white/10 rounded-xl p-8 bg-white/5 backdrop-blur-sm\"><span class=\"eyebrow text-white/60 mb-4 block\">GET EARLY ACCESS</span><h3 class=\"font-heading text-2xl font-bold text-white mb-2\">Start Your Enterprise Impact Performance (EIP) Journey with SAIGE</h3><p class=\"text-white/60 text-sm mb-6\">Enter your email to access the full 6-step workflow.</p><form class=\"space-y-4 mb-6\"><input type=\"text\" placeholder=\"Full Name\" class=\"w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder:text-white/50 focus:outline-none focus:border-accent transition-colors\"><input type=\"email\" placeholder=\"Work Email\" class=\"w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder:text-white/50 focus:outline-none focus:border-accent transition-colors\"><button class=\"w-full bg-accent hover:bg-accent/90 text-accent-foreground font-semibold py-3 rounded-lg transition-colors\">Start the Demo →</button></form><p class=\"text-xs text-white/40 text-center\">Or join the waitlist with your email</p></div><div class=\"border border-white/10 rounded-xl p-8 bg-white/5 backdrop-blur-sm\"><span class=\"eyebrow text-white/60 mb-4 block\">THE PROBLEM</span><h3 class=\"font-heading text-2xl font-bold text-white mb-6\">Why SAIGE Matters</h3><div class=\"grid grid-cols-2 gap-4\"><div class=\"bg-white/5 rounded-lg p-4 border border-white/10\"><p class=\"text-accent font-heading text-3xl font-bold mb-1\">68%</p><p class=\"text-xs text-white/70 leading-snug\">of ESG reports contain material errors due to manual, disconnected processes</p><p class=\"text-xs text-white/40 mt-2\">MSCI ESG Survey, 2023</p></div><div class=\"bg-white/5 rounded-lg p-4 border border-white/10\"><p class=\"text-accent font-heading text-3xl font-bold mb-1\">73%</p><p class=\"text-xs text-white/70 leading-snug\">of sustainability leaders say fragmented data makes board-level reporting harder</p><p class=\"text-xs text-white/40 mt-2\">MIT Sloan, 2023</p></div><div class=\"bg-white/5 rounded-lg p-4 border border-white/10\"><p class=\"text-accent font-heading text-3xl font-bold mb-1\">40%</p><p class=\"text-xs text-white/70 leading-snug\">reduction in compliance costs for orgs with unified impact intelligence within 18 months</p><p class=\"text-xs text-white/40 mt-2\">Deloitte Insights 2023</p></div><div class=\"bg-white/5 rounded-lg p-4 border border-white/10\"><p class=\"text-accent font-heading text-3xl font-bold mb-1\">6+</p><p class=\"text-xs text-white/70 leading-snug\">disconnected tools the average organisation uses for ESG, EHS, SDGs, CSR &amp; Sustainability</p><p class=\"text-xs text-white/40 mt-2\">Gartner, 2024</p></div></div></div></div><div class=\"border border-white/10 rounded-xl p-8 bg-white/5 backdrop-blur-sm h-fit\"><span class=\"eyebrow text-white/60 mb-4 block\">LIVE DEMO</span><h3 class=\"font-heading text-2xl font-bold text-white mb-6\">High Level SAIGE Animation</h3><div class=\"flex flex-wrap gap-2 mb-6\"><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">School</span><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">University</span><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">Local Gov</span><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">Gov Agency</span><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">Business</span><span class=\"px-3 py-1 bg-white/10 text-white/70 text-xs font-semibold rounded-full border border-white/20\">NGO</span></div><div class=\"bg-destructive/20 border border-destructive/40 rounded-lg p-4 mb-6\"><p class=\"text-xs text-white/80\"><strong>Problem:</strong> Aging water infrastructure, fleet emissions non-compliance, declining public satisfaction.</p></div><div class=\"space-y-4\"><div><div class=\"flex items-center justify-between mb-2\"><span class=\"text-sm font-semibold text-white\">Local Government</span><span class=\"text-2xl font-heading font-bold text-accent\">65</span></div><div class=\"flex items-center gap-2\"><div class=\"flex-1 h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-accent w-[65%]\"></div></div><span class=\"text-xs text-accent font-semibold\">Above average</span></div></div><div><div class=\"flex items-center justify-between mb-1\"><span class=\"text-xs font-semibold text-white/80\">Sustainability</span><span class=\"text-xs font-bold text-white\">81</span></div><div class=\"h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-accent\" style=\"width: 81%;\"></div></div></div><div><div class=\"flex items-center justify-between mb-1\"><span class=\"text-xs font-semibold text-white/80\">ESG</span><span class=\"text-xs font-bold text-white\">56</span></div><div class=\"h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-blue-500\" style=\"width: 56%;\"></div></div></div><div><div class=\"flex items-center justify-between mb-1\"><span class=\"text-xs font-semibold text-white/80\">SDGs</span><span class=\"text-xs font-bold text-white\">78</span></div><div class=\"h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-amber-500\" style=\"width: 78%;\"></div></div></div><div><div class=\"flex items-center justify-between mb-1\"><span class=\"text-xs font-semibold text-white/80\">EHS</span><span class=\"text-xs font-bold text-white\">68</span></div><div class=\"h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-orange-500\" style=\"width: 68%;\"></div></div></div><div><div class=\"flex items-center justify-between mb-1\"><span class=\"text-xs font-semibold text-white/80\">CSR</span><span class=\"text-xs font-bold text-white\">60</span></div><div class=\"h-2 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-purple-500\" style=\"width: 60%;\"></div></div></div><p class=\"text-xs text-white/40 mt-4\">Data is synthetic. Only for demo purposes.</p></div></div></div><div class=\"flex flex-wrap gap-4 justify-center mt-12 pt-12 border-t border-white/10\"><a href=\"https://saigedemo.com\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"justify-center whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold px-8 h-12 rounded-lg flex items-center gap-2\">View Demo <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></button></a><a href=\"https://saigeplatform.com\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border bg-transparent shadow-sm hover:text-accent-foreground py-2 border-white/20 text-white hover:bg-white/10 font-semibold px-8 h-12 rounded-lg\">Visit SAIGE <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></button></a></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Nature-Based Decarbonization</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Decarbonizing Africa through Nature-Based Solutions</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Victor is the Chairman/CEO of Afri Decarbonization Corporation (ADC) — a nature-based carbon enterprise reforesting and regenerating West Africa through nature-based decarbonization strategies. ADC has signed a Memorandum of Understanding (MOU) with the Cross River State Government of Nigeria covering 1.8 million hectares total - 1.6 million hectares of forest for carbon sink and biodiversity, and 200,000 hectares for regenerative agriculture.</p></div><div class=\"grid md:grid-cols-3 gap-6 mb-12\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-tree-pine h-6 w-6 text-primary\"><path d=\"m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z\"></path><path d=\"M12 22v-3\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Forest Carbon Sink</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">1.6 million hectares of forest under MOU with Cross River State for carbon sequestration and biodiversity conservation.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sprout h-6 w-6 text-primary\"><path d=\"M7 20h10\"></path><path d=\"M10 20c5.5-2.5.8-6.4 3-10\"></path><path d=\"M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z\"></path><path d=\"M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Regenerative Agriculture</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">200,000 hectares of bamboo and food crop regenerative agriculture — creating small farming community-driven decarbonization and export-oriented processing.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hand-heart h-6 w-6 text-primary\"><path d=\"M11 14h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16\"></path><path d=\"m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9\"></path><path d=\"m2 15 6 6\"></path><path d=\"M19.5 8.5c.7-.7 1.5-1.6 1.5-2.7A2.73 2.73 0 0 0 16 4a2.78 2.78 0 0 0-5 1.8c0 1.2.8 2 1.5 2.8L16 12Z\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Community Impact</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Poverty alleviation, ESG and SDGs implementation, and DEIJ outcomes — ensuring \"no one is left behind\" across beneficiary communities.</p></div></div><div class=\"text-center\"><a href=\"/afri-decarbonization\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border bg-transparent shadow-sm py-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground font-semibold px-8 h-11 rounded-lg\">Learn About ADC <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Academic Leadership</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Chairman, President's Sustainability Council — Bucknell University</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">As Chairman of the President's Sustainability Council at Bucknell University (2019–2025), Victor led strategic planning and execution of a comprehensive 10-year carbon neutrality roadmap, achieving nearly 30% emissions reduction from a 2008 baseline while advancing zero waste initiatives, ecological conservation, and ESG outcomes aligned with the University's Strategic Plan.</p></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"bg-card rounded-lg p-8 shadow-sm border border-border/50 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"font-heading text-4xl lg:text-5xl font-bold text-primary mb-3\">~30%</div><div class=\"text-sm text-muted-foreground leading-relaxed\">Carbon footprint reduction vs. 2008 baseline</div></div><div class=\"bg-card rounded-lg p-8 shadow-sm border border-border/50 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"font-heading text-4xl lg:text-5xl font-bold text-primary mb-3\">#25</div><div class=\"text-sm text-muted-foreground leading-relaxed\">Ranked among Top 50 Green Universities in the USA</div></div><div class=\"bg-card rounded-lg p-8 shadow-sm border border-border/50 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"font-heading text-4xl lg:text-5xl font-bold text-primary mb-3\">2030</div><div class=\"text-sm text-muted-foreground leading-relaxed\">Target year for Bucknell carbon neutrality</div></div></div></div></section><section class=\"py-20 lg:py-24 bg-primary text-primary-foreground\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12\"><span class=\"eyebrow text-white/60 mb-3 block\">Pioneering Research · 2008</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold text-white leading-tight mb-4\">The World's First <span class=\"text-accent\">Vehicle-to-Grid (V2G)</span><br class=\"hidden md:block\"> Real-World Demonstration</h2><p class=\"text-white/60 max-w-3xl mx-auto text-base leading-relaxed\">In 2008, Victor Udo — representing Pepco Holdings — co-led the landmark study proving electric vehicles could power the grid in real time, providing live frequency regulation to the PJM Interconnection. Co-authored with Prof. Willett Kempton (University of Delaware) and PJM engineers, it has since been cited <strong class=\"text-white\">415+ times</strong> globally.</p></div><div class=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-12\"><div class=\"bg-white/5 border border-white/10 rounded-xl p-5 text-center\"><div class=\"font-heading text-3xl font-bold text-accent mb-1\">415+</div><div class=\"text-white/50 text-xs font-medium uppercase tracking-widest\">Academic Citations</div></div><div class=\"bg-white/5 border border-white/10 rounded-xl p-5 text-center\"><div class=\"font-heading text-3xl font-bold text-accent mb-1\">2008</div><div class=\"text-white/50 text-xs font-medium uppercase tracking-widest\">Year Published</div></div><div class=\"bg-white/5 border border-white/10 rounded-xl p-5 text-center\"><div class=\"font-heading text-3xl font-bold text-accent mb-1\">PJM</div><div class=\"text-white/50 text-xs font-medium uppercase tracking-widest\">Grid System Tested</div></div><div class=\"bg-white/5 border border-white/10 rounded-xl p-5 text-center\"><div class=\"font-heading text-3xl font-bold text-accent mb-1\">1st</div><div class=\"text-white/50 text-xs font-medium uppercase tracking-widest\">Real-World V2G Demo</div></div></div><div class=\"grid lg:grid-cols-2 gap-6 mb-12\"><div class=\"bg-white/5 border border-white/10 rounded-xl p-6\"><div class=\"flex items-start gap-3 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5 text-accent flex-shrink-0 mt-0.5\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><p class=\"text-white/80 text-sm leading-relaxed italic\">\"V2G, in addition to providing valuable grid services, could also prove to be a prominent application in the global transition to the emerging green and sustainable energy economy.\"</p></div><p class=\"text-white/40 text-xs pl-8\">— Kempton, <strong class=\"text-white/60\">Udo</strong> et al., 2008 · University of Delaware / Pepco Holdings / PJM Interconnect</p></div><div class=\"bg-accent/10 border border-accent/20 rounded-xl p-6\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap h-5 w-5 text-accent flex-shrink-0 mt-0.5\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"></path></svg><div><p class=\"text-white font-semibold text-sm mb-2\">Why This Matters Today</p><p class=\"text-white/65 text-sm leading-relaxed\">V2G technology is now central to global net-zero strategies — from the EU's Vehicle-to-Grid directive to US DOE grid modernization policy. Victor's foundational 2008 research helped lay the scientific and commercial groundwork for this multi-billion dollar industry, making EVs active participants in grid stability.</p></div></div></div></div><div class=\"mb-10\"><h3 class=\"font-heading text-xl font-bold text-white text-center mb-2\">Study Results &amp; Figures</h3><p class=\"text-white/50 text-sm text-center mb-8\">Key charts, graphs, and data visualizations from the published paper</p><div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\"><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/7-Figure1-1.png\" alt=\"Frequency regulation signal vs. economic dispatch — showing V2G's rapid-response advantage over conventional generators\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Frequency regulation signal vs. economic dispatch — showing V2G's rapid-response advantage over conventional generators</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/10-Figure2-1.png\" alt=\"Hourly contracted regulation and the regulation dispatch requirement (PACE signal) for the California ISO\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Hourly contracted regulation and the regulation dispatch requirement (PACE signal) for the California ISO</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/13-Figure4-1.png\" alt=\"Discounted present value of gross revenues generated from selling regulation and spinning reserve at varying power levels\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Discounted present value of gross revenues generated from selling regulation and spinning reserve at varying power levels</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/17-Figure5-1.png\" alt=\"V2GCAR1 shown as a generator on PJM's SCADA system — plugged in and responding to PJM's encrypted control signal\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">V2GCAR1 shown as a generator on PJM's SCADA system — plugged in and responding to PJM's encrypted control signal</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/19-Figure7-1.png\" alt=\"Real-time regulation dispatch signal and V2G vehicle response — demonstrating precise bidirectional power control\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Real-time regulation dispatch signal and V2G vehicle response — demonstrating precise bidirectional power control</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/22-Figure9-1.png\" alt=\"Measured V2G power output tracking the regulation signal during the live PJM frequency regulation test\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Measured V2G power output tracking the regulation signal during the live PJM frequency regulation test</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/23-Figure10-1.png\" alt=\"Revenue projections for V2G frequency regulation service across different fleet sizes and market scenarios\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Revenue projections for V2G frequency regulation service across different fleet sizes and market scenarios</p></div></div><div class=\"bg-white/5 border border-white/10 rounded-xl overflow-hidden group hover:border-accent/40 hover:bg-white/8 transition-all duration-300\" style=\"opacity: 0; transform: translateY(20px);\"><div class=\"bg-white/10 flex items-center justify-center p-3 min-h-[160px]\"><img src=\"https://figures.semanticscholar.org/9987ffdb1f985e43705749ec48903f67f1b58c69/11-Table1-1.png\" alt=\"Average annual market clearing prices for spinning reserve across five US grid operators (2004–2006)\" class=\"max-w-full max-h-[150px] object-contain rounded group-hover:scale-105 transition-transform duration-300\" loading=\"lazy\"></div><div class=\"p-3\"><p class=\"text-white/55 text-[11px] leading-relaxed\">Average annual market clearing prices for spinning reserve across five US grid operators (2004–2006)</p></div></div></div></div><div class=\"flex flex-wrap gap-4 justify-center\"><a href=\"https://www.researchgate.net/publication/255621263_A_Test_of_Vehicle-to-Grid_V2G_for_Energy_Storage_and_Frequency_Regulation_in_the_PJM_System\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold px-7 py-3 rounded-lg text-sm transition-colors shadow-md\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg> Read the Paper on ResearchGate</a><a href=\"https://www.researchgate.net/publication/255621263_A_Test_of_Vehicle-to-Grid_V2G_for_Energy_Storage_and_Frequency_Regulation_in_the_PJM_System\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 border border-white/30 text-white hover:bg-white/10 font-semibold px-7 py-3 rounded-lg text-sm transition-colors\">Download PDF</a><a href=\"https://www.semanticscholar.org/paper/A-Test-of-Vehicle-to-Grid-(V2G)-for-Energy-Storage-Kempton-Udo/9987ffdb1f985e43705749ec48903f67f1b58c69\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 border border-white/30 text-white hover:bg-white/10 font-semibold px-7 py-3 rounded-lg text-sm transition-colors\">415+ Citations <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Professional Journey</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">From Grid to Global Impact</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Three decades of leadership — from power systems engineering and utility executive roles to renewable energy policy, academic research, and AI platform building.</p></div><section><div class=\"mb-10\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-2\">Career Arc</p><h3 class=\"font-heading text-2xl font-bold text-foreground\">Interactive Career Timeline</h3><p class=\"text-sm text-muted-foreground mt-2\">Click any era to explore detailed achievements and impact.</p></div><div class=\"relative max-w-4xl\"><div class=\"absolute left-6 top-0 bottom-0 w-0.5 bg-border\"></div><div class=\"space-y-6\"><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-target h-5 w-5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">1984–1991</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">Foundation Era</h4><p class=\"text-xs text-muted-foreground mb-3\">Early Career &amp; Education</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\">Started as a Technical Supervisor in Nigeria, then pursued graduate education in the US. Built expertise in power systems and energy management while supporting leading research initiatives.</p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-5 w-5\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"></polyline><polyline points=\"16 7 22 7 22 13\"></polyline></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">1991–2006</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">Corporate Rise</h4><p class=\"text-xs text-muted-foreground mb-3\">Utilities Executive Leadership</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\"></p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">2006–2012</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">Public Policy Era</h4><p class=\"text-xs text-muted-foreground mb-3\">From Utility Sector to Policy Innovation</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\"></p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">2012–2019</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">African Public Service</h4><p class=\"text-xs text-muted-foreground mb-3\">Government Leadership &amp; Nation Building</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\"></p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-target h-5 w-5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">2019–2025</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">Academic &amp; Sustainability Leadership</h4><p class=\"text-xs text-muted-foreground mb-3\">Bucknell University &amp; Climate Action</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\"></p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div><div class=\"relative flex gap-6 group cursor-pointer\" style=\"opacity: 0; transform: translateX(-20px);\"><div class=\"relative z-10 flex-shrink-0 w-12 h-12 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shadow-sm border-2 border-background group-hover:shadow-md group-hover:scale-110 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-5 w-5\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"></polyline><polyline points=\"16 7 22 7 22 13\"></polyline></svg></div><div class=\"flex-1 bg-card border border-border/50 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-border/80 hover:-translate-y-0.5 transition-all\"><div class=\"flex flex-wrap items-center gap-2 mb-2\"><span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">2020–Present</span></div><h4 class=\"font-heading text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors\">Founding &amp; Impact Era</h4><p class=\"text-xs text-muted-foreground mb-3\">AI Platforms, Decarbonization &amp; Community</p><p class=\"text-sm text-muted-foreground leading-relaxed line-clamp-2\"></p><p class=\"text-xs text-accent font-semibold mt-3\">Click to see full details →</p></div></div></div></div></section></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Career Milestones</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">A Career at the Intersection of Power, Policy &amp; Purpose</h2></div><div class=\"grid md:grid-cols-2 gap-6\"><div class=\"rounded-lg overflow-hidden shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"aspect-video overflow-hidden\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/394c48171_image.png\" alt=\"With Vice President Joe Biden, 2008\" class=\"w-full h-full object-contain\"></div><div class=\"bg-card px-5 py-4\"><p class=\"text-sm font-semibold text-foreground leading-snug\">With Vice President Joe Biden, 2008</p></div></div><div class=\"rounded-lg overflow-hidden shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"aspect-video overflow-hidden\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/33d3892d4_Discussing-Nigerian-Power-Sector-With-Alhaji-Dangote.jpg\" alt=\"Discussing Nigeria's Power Sector with Alhaji Dangote\" class=\"w-full h-full object-contain\"></div><div class=\"bg-card px-5 py-4\"><p class=\"text-sm font-semibold text-foreground leading-snug\">Discussing Nigeria's Power Sector with Alhaji Dangote</p></div></div><div class=\"rounded-lg overflow-hidden shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"aspect-video overflow-hidden\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/959b77aaa_With-My-USA-Senator-Chris-Coons-in-Lagos.jpg\" alt=\"With US Senator Chris Coons in Lagos\" class=\"w-full h-full object-contain\"></div><div class=\"bg-card px-5 py-4\"><p class=\"text-sm font-semibold text-foreground leading-snug\">With US Senator Chris Coons in Lagos</p></div></div><div class=\"rounded-lg overflow-hidden shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><div class=\"aspect-video overflow-hidden\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/d79e388fc_Picture-with-Gov-Godswill-Akpabio-of-Akwa-Ibom-State-Nigeria-in-2011-at-Washington-DC.jpg\" alt=\"With Governor Akpabio of Akwa Ibom State at Washington DC, 2011\" class=\"w-full h-full object-contain\"></div><div class=\"bg-card px-5 py-4\"><p class=\"text-sm font-semibold text-foreground leading-snug\">With Governor Akpabio of Akwa Ibom State at Washington DC, 2011</p></div></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Community Leadership</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Uniting the Abasi Nation — People, Planet, Progress</h2><p class=\"mt-4 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-muted-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Victor is the Founding Chairman, President, and CEO of the Abasi People Foundation (APF) — leading the Abasi People Movement to unite the Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo peoples — the fourth largest ethnic nationality in Nigeria — for collective self-emancipation and equitable sustainable development in Nigeria and the global diaspora.</p></div><div class=\"grid md:grid-cols-3 gap-6 mb-12\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-6 w-6 text-primary\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Mission</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Unite Ndito Abasi for collective self-emancipation from marginalization and exploitation, towards equitable sustainable development.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building h-6 w-6 text-primary\"><rect width=\"16\" height=\"20\" x=\"4\" y=\"2\" rx=\"2\" ry=\"2\"></rect><path d=\"M9 22v-4h6v4\"></path><path d=\"M8 6h.01\"></path><path d=\"M16 6h.01\"></path><path d=\"M12 6h.01\"></path><path d=\"M12 10h.01\"></path><path d=\"M12 14h.01\"></path><path d=\"M16 10h.01\"></path><path d=\"M16 14h.01\"></path><path d=\"M8 10h.01\"></path><path d=\"M8 14h.01\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Advocacy</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Active engagement with traditional rulers, governors, senators, and federal institutions.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center\"><div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-handshake h-6 w-6 text-primary\"><path d=\"m11 17 2 2a1 1 0 1 0 3-3\"></path><path d=\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg></div><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Reach</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Non-partisan, non-religious movement with chapters across Nigeria and diaspora in Africa, America, Asia, Europe, and the Middle East.</p></div></div><div class=\"text-center\"><a href=\"/abasi-people\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border bg-transparent shadow-sm py-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground font-semibold px-8 h-11 rounded-lg\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"grid lg:grid-cols-2 gap-12 lg:gap-16 items-center\"><div class=\"relative\"><div class=\"aspect-[4/5] rounded-lg overflow-hidden shadow-md\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\" alt=\"Dr. Victor Udo, PhD, FNSE\" class=\"w-full h-full object-cover object-top\"></div><div class=\"absolute -bottom-4 -right-4 w-24 h-24 bg-accent/10 rounded-lg -z-10\"></div><div class=\"mt-8 bg-primary rounded-lg p-5 text-center\"><p class=\"text-accent font-semibold text-xs tracking-[0.2em] uppercase mb-3\">Author</p><p class=\"text-white font-bold text-sm leading-snug mb-2\">Which Way Nigeria? Structure, Leadership &amp; Sustainable Development</p><p class=\"text-white/60 text-xs leading-relaxed\">Structural &amp; Leadership Insights for National Sustainable Development</p><p class=\"text-white/60 text-xs leading-relaxed\">Sustainability Insights for Electric Power Sector Transformation</p></div></div><div><span class=\"eyebrow mb-3 block\">Who Is Victor Udo</span><h2 class=\"font-heading text-3xl md:text-4xl font-bold text-foreground mb-6 leading-tight\">Transformational Engineer. Global Executive. AI Builder.</h2><p class=\"text-muted-foreground leading-relaxed mb-5\">Victor Udo, PhD, FNSE brings together an extraordinary range of experience — from managing a $2B risk portfolio at Pepco Holdings, to serving as CEO of a 200+ employee company with a 700 MW power plant license, to being appointed to boards by a US Senator and a New Jersey Governor, to leading Bucknell University's carbon neutrality journey, to building a nature-based decarbonization enterprise in West Africa.</p><p class=\"text-muted-foreground leading-relaxed mb-8\">He is the Founding Chairman/President/CEO of the Abasi People Foundation and the Founder of VEU AI Studio — channeling 25+ years of cross-sector executive leadership into platforms and movements that create measurable real-world impact.</p><a class=\"text-accent font-semibold inline-flex items-center gap-2 hover:gap-3 transition-all\" href=\"/about\">Read Full Bio <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Publications</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Books by Dr. Victor Udo</h2></div><div class=\"grid grid-cols-3 gap-8 mb-10\"><div class=\"flex flex-col items-start\"><img src=\"https://images-na.ssl-images-amazon.com/images/P/1646540387.01._SCLZZZZZZZ_.jpg\" alt=\"Which Way Nigeria? Structure, Leadership and Equitable Sustainable Development - Book cover by Dr. Victor Udo\" class=\"w-28 h-auto object-cover rounded-lg mb-5 shadow-sm\"><h3 class=\"font-heading text-base font-bold text-foreground mb-3 leading-snug\">Which Way Nigeria? Structure, Leadership and Equitable Sustainable Development</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-5 flex-1\">Navigates post-colonial political and diplomatic conditions, class structure, economic organization, Nigerian culture, ethnic diversity, and the environment. Prescribed reading for Nigerian students, policymakers, and civil servants.</p></div><div class=\"flex flex-col items-start\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/2ade642f6_image.png\" alt=\"Sustainability Insights for Electric Power Sector Transformation - Book cover by Dr. Victor Udo\" class=\"w-28 h-auto object-cover rounded-lg mb-5 shadow-sm\"><h3 class=\"font-heading text-base font-bold text-foreground mb-3 leading-snug\">Sustainability Insights for Electric Power Sector Transformation</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-5 flex-1\">This book presents the electric power sector as AC and DC systems managed by a value constellation of stakeholders. The domain set for global sustainability and technological convergence are explored, presenting a pathway forward through decarbonization enabled by digitalization and decentralization. Sustainability Insights on the simultaneously evolutionary and revolutionary processes that are helping the global and Nigerian energy sectors move forward by using Nigeria as a metaphor of understanding.</p></div><div class=\"flex flex-col items-start\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/9433ccee7_image.png\" alt=\"Structural and Leadership Insights for National Sustainable Development - Book cover by Dr. Victor Udo\" class=\"w-28 h-auto object-cover rounded-lg mb-5 shadow-sm\"><h3 class=\"font-heading text-base font-bold text-foreground mb-3 leading-snug\">Structural and Leadership Insights for National Sustainable Development</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-5 flex-1\">The book is based on 7 years of direct observations, participation and engagement in the development system from the villages, wards, LGAs, States and country. After over 25 years away from home as a student of American education and corporate experience, Victor returned home as a student to capture the structural, leadership and development challenges in the country and prescribes a way forward. There is an urgent need for true transformation starting at the grassroots community level and smartphone democracy for comprehensive sustainable development planning and implementation.</p></div></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Trusted by Leaders, Institutions &amp; Communities</h2></div><div class=\"grid sm:grid-cols-2 gap-6\"><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex gap-4\"><div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5 text-accent\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><p class=\"text-sm text-foreground leading-relaxed\">Appointed to the Delaware Planning Board — by eventual US Senator Chris Coons</p></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex gap-4\"><div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5 text-accent\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><p class=\"text-sm text-foreground leading-relaxed\">Appointed to the NJ Renewable Energy Task Force — by the Governor of New Jersey</p></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex gap-4\"><div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5 text-accent\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><p class=\"text-sm text-foreground leading-relaxed\">Bucknell ranked #25, Top 50 Green Universities — under Victor's Sustainability Council leadership</p></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex gap-4\"><div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-5 w-5 text-accent\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><p class=\"text-sm text-foreground leading-relaxed\">Royal Endorsement of the Abasi People Movement — HRM Odidem Bassey Etim Edet, Chairman, Akwa Ibom State Traditional Rulers Council</p></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Press</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">In the News</h2></div><div class=\"grid md:grid-cols-3 gap-5 mb-8\"><a href=\"https://margaretjhunter.blogs.bucknell.edu/2024/02/02/dr-victor-udo-brings-university-sustainability-efforts-to-light/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">Bucknell Student Blog — Margaret Hunter</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">Dr. Victor Udo Brings University Sustainability Efforts to Light</p><span class=\"text-xs text-muted-foreground\">February 2024</span></a><a href=\"https://caleigh13.blogs.bucknell.edu/2024/02/02/dr-udo-sustainability-at-bucknell-and-beyond/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">Bucknell ENLS 103 Blog</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">Dr. Udo — Sustainability at Bucknell and Beyond</p><span class=\"text-xs text-muted-foreground\">February 2024</span></a><a href=\"https://www.bucknell.edu/news/bucknell-repeats-stars-gold-rating-sustainability\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">Bucknell University News</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">Bucknell Repeats STARS Gold Rating for Sustainability</p><span class=\"text-xs text-muted-foreground\">July 2023</span></a><a href=\"https://www.northcentralpa.com/education/new-solar-field-looks-to-provide-bucknell-with-nearly-10-of-universitys-power/article_ae82da5e-4647-11ed-bb76-77c784ee068e.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">NorthCentralPA.com</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">New Solar Field to Provide Bucknell Nearly 10% of University Power</p><span class=\"text-xs text-muted-foreground\">October 2022</span></a><a href=\"https://businessday.ng/energy/power/article/ibom-power-company-gets-new-md/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">Business Day Nigeria</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">Ibom Power Company Gets New MD — Victor Udo Reassigned to Governor's Office</p><span class=\"text-xs text-muted-foreground\">August 2016</span></a><a href=\"https://www.thenigerianvoice.com/news/197907/governor-udom-emmanuel-will-revolutionize-a-ibom-power-sect.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-card rounded-lg p-6 border border-border/50 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col group\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-semibold text-accent uppercase tracking-wide\">The Nigerian Voice</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5 text-muted-foreground group-hover:text-accent transition-colors\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></div><p class=\"font-heading text-base font-bold text-foreground leading-snug flex-1 mb-3\">Governor Udom Emmanuel Will Revolutionize Akwa Ibom Power Sector</p><span class=\"text-xs text-muted-foreground\">November 2015</span></a></div><div class=\"text-center\"><a href=\"/news\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border bg-transparent shadow-sm py-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground font-semibold px-8 h-11 rounded-lg\">See All Press Coverage <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></section><div class=\"bg-secondary rounded-lg p-8 md:p-12 border border-border/50\"><div><div class=\"flex items-center gap-3 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-6 w-6 text-accent\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg><h3 class=\"font-heading text-2xl font-bold text-foreground\">Stay Updated</h3></div><p class=\"text-muted-foreground mb-6\">Get the latest news on sustainability initiatives, AI platforms, and the Abasi People movement directly to your inbox.</p><form class=\"flex flex-col sm:flex-row gap-3\"><input type=\"email\" class=\"flex w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm h-11 flex-1\" placeholder=\"Enter your email\" required=\"\" value=\"\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 shadow py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold h-11 px-6 rounded-lg\" type=\"submit\">Subscribe</button></form><p class=\"text-xs text-muted-foreground mt-3\">We respect your privacy. Unsubscribe at any time.</p></div></div><section class=\"py-20 lg:py-24 bg-primary text-primary-foreground\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center max-w-3xl mx-auto\" style=\"opacity: 0;\"><h2 class=\"font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6\" style=\"opacity: 0; transform: translateY(20px);\">Let's Work Together</h2><p class=\"text-white/70 text-lg leading-relaxed mb-10\" style=\"opacity: 0; transform: translateY(20px);\">Whether you're exploring a partnership with VEU AI Studio, ADC nature-based projects, advisory support, speaking invitations, or connection with the Abasi People Foundation — reach out directly.</p><div class=\"flex flex-wrap gap-4 justify-center\" style=\"opacity: 0; transform: translateY(20px);\"><a href=\"/contact\" class=\"inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-xl bg-accent text-accent-foreground hover:bg-accent/90\">Get in Touch<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a href=\"https://veuaistudio.com\" target=\"_blank\" class=\"inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-xl border-2 border-white text-white hover:bg-white/10\">Explore VEU AI Studio<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section></div></main><footer class=\"bg-primary text-white\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-16 lg:py-20\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><h3 class=\"font-heading text-xl font-bold mb-1\">Victor Udo, FNSE, PhD</h3><p class=\"text-white/60 text-xs leading-relaxed mb-4\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Engineer</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Executive</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">AI Builder</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/publications\">Author</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Community Leader</a></p><p class=\"text-white/50 text-xs leading-relaxed\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">Founder, VEU AI Studio</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/afri-decarbonization\">Chairman/CEO, Afri Decarbonization Corporation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Founding Chairman/President/CEO, Abasi People Foundation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council — Bucknell University (2019–2025)</a></p></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Quick Links</h4><ul class=\"space-y-2\"><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/\">Home</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/about\">About</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/blog\">Blog &amp; Insights</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Books</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/speaking\">Speaking</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/news\">News</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/gallery\">Gallery</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Publications</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Platforms &amp; Organizations</h4><ul class=\"space-y-2\"><li><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">VEU AI Studio<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://saigedemo.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">SAIGE Demo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://afridecarbonization.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Afri Decarbonization Corp<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://abasipeople.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Abasi People Foundation<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></li><li><a href=\"https://anchor.fm/sustainability-leadership\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">The Podium of Leadership (The POL) with Victor Udo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Connect</h4><ul class=\"space-y-3\"><li><a href=\"mailto:Victor.Udo@VEUAIStudio.Com\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-3.5 w-3.5\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg> Victor.Udo@VEUAIStudio.Com</a></li><li><a href=\"tel:+13028989542\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-3.5 w-3.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> +1 302 898 9542</a></li><li><a href=\"https://www.linkedin.com/in/victor-udo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-linkedin h-3.5 w-3.5\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg> LinkedIn</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Bucknell University</h4><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council (2019–2025)</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Lewisburg, Pennsylvania</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">#25 Top 50 Green Universities, USA (2022–23)</p><p class=\"text-white/50 text-xs leading-relaxed\">~30% carbon footprint reduction achieved</p></div></div></div><div class=\"border-t border-white/10\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3\"><p class=\"text-white/40 text-xs\">© 2026 Victor Udo, FNSE, PhD. All rights reserved.</p><button class=\"text-white/40 hover:text-white text-xs flex items-center gap-1.5 transition-colors group\" aria-label=\"Back to top\">↑ Back to top</button></div></div></footer></div><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></div></div></div>\n \n\n</body></html>\n","bodyText":"Victor Udo, FNSE, PhD | AI Platform Builder - Sustainability Leader - Abasi Foundation Leader - Power Sector Executive Dr. Victor Udo Executive · AI Builder · Author · Community Leader Home About VEU AI Studio Abasi People Abasi People Foundation Abasi People Forum Podcast Speaking Publications Contact More ▾ Blog & Insights Carbon Calculator Afri Decarbonization Advisory Services News Gallery Mother's Memorial Work With Victor View Dr. Udo's Profile & Banner Summary → × Engineer. Executive. Community Leader. AI Builder. Speaker. Victor Udo, FNSE, PhD — AI platform builder, sustainability leader, electric power sector executive, and Abasi People Movement champion with 25+ years of impact across business, government, and academia. Building AI Platforms for Individual and Organizational Impacts Explore My Platforms View My Books Background image taken during a speaking engagement 0+ Years of Transformational Leadership 0 AI Platforms Built & Launching ~30% Carbon Reduction at Bucknell 0.76 MW Solar Farm at Bucknell 0.8M Hectares Under ADC MOU (1.6M Forest + 200K Agriculture) 0 Abasi Peoples Unity 0M+ Media Reach — POL Radio & TV, Akwa Ibom (2012–2019) ~700MW Ibom Power Capacity Licensed ~155MW Ibom Power Macro-Grid Island 0 Peer-Reviewed Publications 0+ Citations ~3,500 Reads What Victor Does Five Dimensions of Impact AI Platform Builder Founder of VEU AI Studio, building 4 AI SaaS platforms serving enterprise sustainability, relationship intelligence, community engagement, and publishing. Explore the Platforms Decarbonization Leader Chairman/CEO of Afri Decarbonization Corporation, focused on practical pathways to net-zero for organizations and governments across West Africa. Learn About ADC Sustainability Leader Author of 3 books and 14 papers. Former Director of Sustainability at Bucknell University, chairing the President's Sustainability Council toward carbon neutrality by 2030. View Books & Research Executive Advisor 25+ years spanning Fortune 500 energy companies (Pepco Holdings), government (Akwa Ibom State), and academic leadership across the USA and Nigeria. Advisory Services Abasian Nationality Champion President of the Abasi People Foundation, uniting Ibibio, Annang, Efik, Oro, Ekid, Ekoi, and Obolo peoples under a shared vision of belonging and sustainable development. About the Foundation Career Milestones Atlantic City Electric Conectiv Power Delivery Pepco Holdings (now part of Exelon) Ibom Power Akwa Ibom State Government Bucknell University University of Delaware University of Pennsylvania Howard University Global Impact Work Across Two Continents Explore Dr. Victor Udo's projects, initiatives, and leadership across the USA and West Africa — from decarbonization and energy policy to sustainability and community empowerment. 📍 📍 📍 📍 📍 📍 📍 📍 📍 📍 📍 📍 + − Leaflet | © OpenStreetMap contributors © CARTO Impact Zones Nigeria / Decarbonization US Energy & PJM Grid US Academia & Sustainability Poland / International Research Europe / Energy & Innovation Current Work — AI Platforms VEU AI Studio — Intelligent Platforms for Real-World Impact Victor is the Founder of VEU AI Studio, a portfolio of AI Platforms designed for organizations that need to move from information to knowledge to decisions to measurable real-world impact. Four agentic AI platforms are in active development and commercialization. Information Knowledge Decisions Impact 🔵 Launching Soon SAIGE Enterprise AI platform for ESG, SDGs, EHS, CSR, and Sustainability governance. Introduces Enterprise Impact Performance (EIP) — a unified intelligence layer for people, planet, and progress. Learn More 🔵 Launching Soon RelTwin Relationship intelligence platform using Relationship Digital Twins (RDT) to improve organizational leadership, communication, and performance. Learn More 🔵 Launching Soon ReachSMS SMS-first community management and connections infrastructure for online communities, value exchange, and services. Learn More 🔵 Launching Soon PressAI Virtual end-to-end publishing and knowledge-sharing infrastructure — amplifying underrepresented voices through AI-powered content creation. Learn More Explore All Platforms Every organisation is accountable for the impact it creates on society. Most are still flying blind. SAIGE is an Agentic AI platform that unifies ESG, Sustainability, SDGs, EHS and CSR into a single Enterprise Impact Performance (EIP) score — giving executives, domain leaders, and practitioners the tools and intelligence to make the best decisions and act responsibly across People, Planet, Peace, Progress, and Profits. GET EARLY ACCESS Start Your Enterprise Impact Performance (EIP) Journey with SAIGE Enter your email to access the full 6-step workflow. Start the Demo → Or join the waitlist with your email THE PROBLEM Why SAIGE Matters 68% of ESG reports contain material errors due to manual, disconnected processes MSCI ESG Survey, 2023 73% of sustainability leaders say fragmented data makes board-level reporting harder MIT Sloan, 2023 40% reduction in compliance costs for orgs with unified impact intelligence within 18 months Deloitte Insights 2023 6+ disconnected tools the average organisation uses for ESG, EHS, SDGs, CSR & Sustainability Gartner, 2024 LIVE DEMO High Level SAIGE Animation School University Local Gov Gov Agency Business NGO Problem: Aging water infrastructure, fleet emissions non-compliance, declining public satisfaction. Local Government 65 Above average Sustainability 81 ESG 56 SDGs 78 EHS 68 CSR 60 Data is synthetic. Only for demo purposes. View Demo Visit SAIGE Nature-Based Decarbonization Decarbonizing Africa through Nature-Based Solutions Victor is the Chairman/CEO of Afri Decarbonization Corporation (ADC) — a nature-based carbon enterprise reforesting and regenerating West Africa through nature-based decarbonization strategies. ADC has signed a Memorandum of Understanding (MOU) with the Cross River State Government of Nigeria covering 1.8 million hectares total - 1.6 million hectares of forest for carbon sink and biodiversity, and 200,000 hectares for regenerative agriculture. Forest Carbon Sink 1.6 million hectares of forest under MOU with Cross River State for carbon sequestration and biodiversity conservation. Regenerative Agriculture 200,000 hectares of bamboo and food crop regenerative agriculture — creating small farming community-driven decarbonization and export-oriented processing. Community Impact Poverty alleviation, ESG and SDGs implementation, and DEIJ outcomes — ensuring \"no one is left behind\" across beneficiary communities. Learn About ADC Academic Leadership Chairman, President's Sustainability Council — Bucknell University As Chairman of the President's Sustainability Council at Bucknell University (2019–2025), Victor led strategic planning and execution of a comprehensive 10-year carbon neutrality roadmap, achieving nearly 30% emissions reduction from a 2008 baseline while advancing zero waste initiatives, ecological conservation, and ESG outcomes aligned with the University's Strategic Plan. ~30% Carbon footprint reduction vs. 2008 baseline #25 Ranked among Top 50 Green Universities in the USA 2030 Target year for Bucknell carbon neutrality Pioneering Research · 2008 The World's First Vehicle-to-Grid (V2G) Real-World Demonstration In 2008, Victor Udo — representing Pepco Holdings — co-led the landmark study proving electric vehicles could power the grid in real time, providing live frequency regulation to the PJM Interconnection. Co-authored with Prof. Willett Kempton (University of Delaware) and PJM engineers, it has since been cited 415+ times globally. 415+ Academic Citations 2008 Year Published PJM Grid System Tested 1st Real-World V2G Demo \"V2G, in addition to providing valuable grid services, could also prove to be a prominent application in the global transition to the emerging green and sustainable energy economy.\" — Kempton, Udo et al., 2008 · University of Delaware / Pepco Holdings / PJM Interconnect Why This Matters Today V2G technology is now central to global net-zero strategies — from the EU's Vehicle-to-Grid directive to US DOE grid modernization policy. Victor's foundational 2008 research helped lay the scientific and commercial groundwork for this multi-billion dollar industry, making EVs active participants in grid stability. Study Results & Figures Key charts, graphs, and data visualizations from the published paper Frequency regulation signal vs. economic dispatch — showing V2G's rapid-response advantage over conventional generators Hourly contracted regulation and the regulation dispatch requirement (PACE signal) for the California ISO Discounted present value of gross revenues generated from selling regulation and spinning reserve at varying power levels V2GCAR1 shown as a generator on PJM's SCADA system — plugged in and responding to PJM's encrypted control signal Real-time regulation dispatch signal and V2G vehicle response — demonstrating precise bidirectional power control Measured V2G power output tracking the regulation signal during the live PJM frequency regulation test Revenue projections for V2G frequency regulation service across different fleet sizes and market scenarios Average annual market clearing prices for spinning reserve across five US grid operators (2004–2006) Read the Paper on ResearchGate Download PDF 415+ Citations Professional Journey From Grid to Global Impact Three decades of leadership — from power systems engineering and utility executive roles to renewable energy policy, academic research, and AI platform building. Career Arc Interactive Career Timeline Click any era to explore detailed achievements and impact. 1984–1991 Foundation Era Early Career & Education Started as a Technical Supervisor in Nigeria, then pursued graduate education in the US. Built expertise in power systems and energy management while supporting leading research initiatives. Click to see full details → 1991–2006 Corporate Rise Utilities Executive Leadership Click to see full details → 2006–2012 Public Policy Era From Utility Sector to Policy Innovation Click to see full details → 2012–2019 African Public Service Government Leadership & Nation Building Click to see full details → 2019–2025 Academic & Sustainability Leadership Bucknell University & Climate Action Click to see full details → 2020–Present Founding & Impact Era AI Platforms, Decarbonization & Community Click to see full details → Career Milestones A Career at the Intersection of Power, Policy & Purpose With Vice President Joe Biden, 2008 Discussing Nigeria's Power Sector with Alhaji Dangote With US Senator Chris Coons in Lagos With Governor Akpabio of Akwa Ibom State at Washington DC, 2011 Community Leadership Uniting the Abasi Nation — People, Planet, Progress Victor is the Founding Chairman, President, and CEO of the Abasi People Foundation (APF) — leading the Abasi People Movement to unite the Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo peoples — the fourth largest ethnic nationality in Nigeria — for collective self-emancipation and equitable sustainable development in Nigeria and the global diaspora. Mission Unite Ndito Abasi for collective self-emancipation from marginalization and exploitation, towards equitable sustainable development. Advocacy Active engagement with traditional rulers, governors, senators, and federal institutions. Reach Non-partisan, non-religious movement with chapters across Nigeria and diaspora in Africa, America, Asia, Europe, and the Middle East. Learn More Author Which Way Nigeria? Structure, Leadership & Sustainable Development Structural & Leadership Insights for National Sustainable Development Sustainability Insights for Electric Power Sector Transformation Who Is Victor Udo Transformational Engineer. Global Executive. AI Builder. Victor Udo, PhD, FNSE brings together an extraordinary range of experience — from managing a $2B risk portfolio at Pepco Holdings, to serving as CEO of a 200+ employee company with a 700 MW power plant license, to being appointed to boards by a US Senator and a New Jersey Governor, to leading Bucknell University's carbon neutrality journey, to building a nature-based decarbonization enterprise in West Africa. He is the Founding Chairman/President/CEO of the Abasi People Foundation and the Founder of VEU AI Studio — channeling 25+ years of cross-sector executive leadership into platforms and movements that create measurable real-world impact. Read Full Bio Publications Books by Dr. Victor Udo Which Way Nigeria? Structure, Leadership and Equitable Sustainable Development Navigates post-colonial political and diplomatic conditions, class structure, economic organization, Nigerian culture, ethnic diversity, and the environment. Prescribed reading for Nigerian students, policymakers, and civil servants. Sustainability Insights for Electric Power Sector Transformation This book presents the electric power sector as AC and DC systems managed by a value constellation of stakeholders. The domain set for global sustainability and technological convergence are explored, presenting a pathway forward through decarbonization enabled by digitalization and decentralization. Sustainability Insights on the simultaneously evolutionary and revolutionary processes that are helping the global and Nigerian energy sectors move forward by using Nigeria as a metaphor of understanding. Structural and Leadership Insights for National Sustainable Development The book is based on 7 years of direct observations, participation and engagement in the development system from the villages, wards, LGAs, States and country. After over 25 years away from home as a student of American education and corporate experience, Victor returned home as a student to capture the structural, leadership and development challenges in the country and prescribes a way forward. There is an urgent need for true transformation starting at the grassroots community level and smartphone democracy for comprehensive sustainable development planning and implementation. Trusted by Leaders, Institutions & Communities Appointed to the Delaware Planning Board — by eventual US Senator Chris Coons Appointed to the NJ Renewable Energy Task Force — by the Governor of New Jersey Bucknell ranked #25, Top 50 Green Universities — under Victor's Sustainability Council leadership Royal Endorsement of the Abasi People Movement — HRM Odidem Bassey Etim Edet, Chairman, Akwa Ibom State Traditional Rulers Council Press In the News Bucknell Student Blog — Margaret Hunter Dr. Victor Udo Brings University Sustainability Efforts to Light February 2024 Bucknell ENLS 103 Blog Dr. Udo — Sustainability at Bucknell and Beyond February 2024 Bucknell University News Bucknell Repeats STARS Gold Rating for Sustainability July 2023 NorthCentralPA.com New Solar Field to Provide Bucknell Nearly 10% of University Power October 2022 Business Day Nigeria Ibom Power Company Gets New MD — Victor Udo Reassigned to Governor's Office August 2016 The Nigerian Voice Governor Udom Emmanuel Will Revolutionize Akwa Ibom Power Sector November 2015 See All Press Coverage Stay Updated Get the latest news on sustainability initiatives, AI platforms, and the Abasi People movement directly to your inbox. Subscribe We respect your privacy. Unsubscribe at any time. Let's Work Together Whether you're exploring a partnership with VEU AI Studio, ADC nature-based projects, advisory support, speaking invitations, or connection with the Abasi People Foundation — reach out directly. Get in Touch Explore VEU AI Studio Victor Udo, FNSE, PhD Engineer · Executive · AI Builder · Author · Community Leader Founder, VEU AI Studio · Chairman/CEO, Afri Decarbonization Corporation · Founding Chairman/President/CEO, Abasi People Foundation · Former Director of Sustainability & Chairman, President's Sustainability Council — Bucknell University (2019–2025) Quick Links Home About Blog & Insights Books Speaking News Gallery Publications Contact Platforms & Organizations VEU AI Studio SAIGE Demo Afri Decarbonization Corp Abasi People Foundation Abasi People Forum Podcast The Podium of Leadership (The POL) with Victor Udo Connect Victor.Udo@VEUAIStudio.Com +1 302 898 9542 LinkedIn Bucknell University Former Director of Sustainability & Chairman, President's Sustainability Council (2019–2025) Lewisburg, Pennsylvania #25 Top 50 Green Universities, USA (2022–23) ~30% carbon footprint reduction achieved © 2026 Victor Udo, FNSE, PhD. All rights reserved. ↑ Back to top","contentTruncated":{"html":false,"bodyText":false,"maxStoredHtmlBytes":250000,"maxStoredBodyTextBytes":50000},"contentLength":136738,"findings":[]},{"url":"https://victorudo.com/","depth":1,"status":"fetched","method":"browserless","httpStatus":null,"title":"Victor Udo, FNSE, PhD | AI Platform Builder - Sustainability Leader - Abasi Foundation Leader - Power Sector Executive","html":"<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/754a2285a_VEULinkedINPic.jpg\" rel=\"icon\" type=\"image/jpeg\">\n  <meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n  <!-- Performance: Preconnect & DNS Prefetch -->\n  <link href=\"https://fonts.googleapis.com\" rel=\"preconnect\">\n  <link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\">\n  <link href=\"https://media.base44.com\" rel=\"dns-prefetch\">\n  <link href=\"https://www.google-analytics.com\" rel=\"dns-prefetch\">\n  <!-- Google Site Verification -->\n  <meta content=\"UPQLHTlymB5ijLSuhYAcOykBAhG7gB6gbBpg6n10KTA\" name=\"google-site-verification\">\n  <!-- Sitemap Discovery -->\n  <link href=\"https://victorudo.com/sitemap\" rel=\"sitemap\" type=\"application/xml\">\n  <!-- Primary Meta Tags -->\n  <title>Victor Udo, FNSE, PhD | AI Platform Builder - Sustainability Leader - Abasi Foundation Leader - Power Sector Executive</title>\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"title\">\n  <meta content=\"Victor Udo, FNSE, PhD — founder of VEU AI Studio, builder of 4 AI SaaS platforms, Sustainability Leader, and Abasi People Foundation president. Explore AI platforms, books, speaking, electric power sector, electric utilities, power supply, power delivery, technology, governance, sustainable development, public policy, risk, and more.\" name=\"description\">\n  <meta content=\"Victor Udo, VEU AI Studio, SAIGE, sustainability, ESG, decarbonization, AI, Abasi Nation, Ibibio, Annang, Efik, Oro, Ekoi, Ekid, Obolo, Ndito Abasi, Abasians, Abasi People Foundation, Afri Decarbonization, carbon neutrality, Nigeria, Akwa Ibom, Bucknell University\" name=\"keywords\">\n  <meta content=\"Victor Udo, FNSE, PhD\" name=\"author\">\n  <meta content=\"index, follow\" name=\"robots\">\n  <!-- Open Graph / Facebook -->\n  <meta content=\"website\" property=\"og:type\">\n  <meta content=\"https://victorudo.com\" property=\"og:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" property=\"og:title\">\n  <meta content=\"profile\" property=\"og:type\">\n  <meta content=\"Founder of VEU AI Studio, Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation uniting Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo as Abasi Nation.\" property=\"og:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" property=\"og:image\">\n  <meta content=\"1200\" property=\"og:image:width\">\n  <meta content=\"630\" property=\"og:image:height\">\n  <meta content=\"Dr. Victor Udo\" property=\"og:site_name\">\n  <meta content=\"en_US\" property=\"og:locale\">\n  <!-- Twitter Card -->\n  <meta content=\"summary_large_image\" name=\"twitter:card\">\n  <meta content=\"https://victorudo.com\" name=\"twitter:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"twitter:title\">\n  <meta content=\"Founder of VEU AI Studio (SAIGE, RelTwin), Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation.\" name=\"twitter:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" name=\"twitter:image\">\n  <!-- Structured Data: Person -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Person\",\n      \"name\": \"Victor Udo\",\n      \"honorificSuffix\": \"FNSE, PhD\",\n      \"jobTitle\": \"AI Platform Builder, Decarbonization Champion\",\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victorudo\",\n        \"https://www.researchgate.net/profile/Victor-Udo\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"knowsAbout\": [\"Decarbonization\", \"AI Platforms\", \"ESG\", \"Sustainability Leadership\", \"Electric Power Systems\", \"Carbon Markets\", \"Public Policy\", \"Abasi Nation\"],\n      \"alumniOf\": [\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Delaware\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Pennsylvania\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"Howard University\" }\n      ],\n      \"worksFor\": [\n        { \"@type\": \"Organization\", \"name\": \"VEU AI Studio\", \"url\": \"https://veuaistudio.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Afri Decarbonization Corporation\", \"url\": \"https://afridecarbonization.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Abasi People Foundation\", \"url\": \"https://abasipeople.org\" }\n      ],\n      \"knowsAbout\": [\"Artificial Intelligence\", \"Sustainability\", \"ESG\", \"Decarbonization\", \"Energy Systems\", \"Carbon Markets\", \"Abasi Nation\", \"Public Policy\", \"Corporate Governance\"]\n    }\n  </script>\n  <!-- Structured Data: Organization (VEU AI Studio) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Organization\",\n      \"name\": \"VEU AI Studio\",\n      \"url\": \"https://veuaistudio.com\",\n      \"founder\": { \"@type\": \"Person\", \"name\": \"Victor Udo, FNSE, PhD\" },\n      \"description\": \"Agentic AI platforms for real-world decision intelligence — SAIGE (ESG/SDGs), RelTwin, ReachSMS, and PressAI.\",\n      \"sameAs\": [\"https://veuaistudio.com\"]\n    }\n  </script>\n  <!-- Structured Data: WebSite with SearchAction (enables Google Sitelinks Search Box) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebSite\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"url\": \"https://victorudo.com\",\n      \"description\": \"Official website of Victor Udo, FNSE, PhD — AI Builder, Sustainability Leader, and Abasi Foundation Leader.\",\n      \"potentialAction\": {\n        \"@type\": \"SearchAction\",\n        \"target\": {\n          \"@type\": \"EntryPoint\",\n          \"urlTemplate\": \"https://victorudo.com/news?q={search_term_string}\"\n        },\n        \"query-input\": \"required name=search_term_string\"\n      }\n    }\n  </script>\n  <!-- Structured Data: FAQ (common searches about Victor Udo) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Who is Dr. Victor Udo?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is an AI platform builder, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is SAIGE by VEU AI Studio?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"SAIGE is an agentic AI platform for enterprise decision intelligence on ESG, SDGs, EHS, CSR, and sustainability governance. It provides real-time analytics and impact assessment for organizations managing sustainability targets and carbon neutrality goals.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Abasi People Foundation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The Abasi People Foundation, founded by Dr. Victor Udo, is a movement uniting seven peoples — Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo — as Abasi Nation, the 4th largest ethnic nationality in Nigeria with vision for sustainable development and unity.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is Afri Decarbonization Corporation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Afri Decarbonization Corporation (ADC), led by Victor Udo, FNSE, PhD as Chairman/CEO, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What topics does Dr. Victor Udo speak on?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD speaks on AI for enterprise decisions, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How can I book Dr. Victor Udo for a speaking engagement?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Use the contact form at victorudo.com/contact and select 'Speaking Engagement' as the inquiry type. Provide event details, audience size, and preferred topics. Victor Udo, FNSE, PhD personally reviews all speaking requests and responds within 48 hours.\" } as the inquiry type. Provide event details, audience size, and preferred topics. Dr. Udo personally reviews all speaking requests and responds within 48 hours.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What are Dr. Victor Udo's published books?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is author of 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" } 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Bucknell Carbon Neutrality initiative?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"As Director of Sustainability at Bucknell University, Victor Udo, FNSE, PhD led the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" } the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" }\n        }\n      ]\n    }\n  </script>\n  <!-- Structured Data: LocalBusiness (Lewisburg Office) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"description\": \"AI platform builder, sustainability executive, and community leader. Consulting and advisory services for ESG, decarbonization, and enterprise AI decision intelligence.\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Lewisburg\",\n        \"addressRegion\": \"PA\",\n        \"postalCode\": \"17837\",\n        \"addressCountry\": \"US\"\n      },\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"telephone\": \"+1-570-577-1234\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victor-udo/\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"knowsAbout\": [\n        \"Artificial Intelligence\",\n        \"Enterprise AI\",\n        \"Sustainability\",\n        \"ESG Governance\",\n        \"Decarbonization\",\n        \"Carbon Markets\",\n        \"Energy Transition\",\n        \"Corporate Leadership\",\n        \"Public Policy\",\n        \"African Development\"\n      ]\n    }\n  </script>\n  <!-- Structured Data: ProfessionalService (Consulting & Advisory) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ProfessionalService\",\n      \"name\": \"Victor Udo, FNSE, PhD — Sustainability & AI Consulting\",\n      \"provider\": {\n        \"@type\": \"Person\",\n        \"name\": \"Victor Udo\",\n        \"honorificSuffix\": \"FNSE, PhD\",\n        \"email\": \"info@victorudo.com\",\n        \"url\": \"https://victorudo.com\"\n      },\n      \"serviceType\": [\"Advisory Services\", \"Strategic Consulting\", \"ESG Governance\", \"Sustainability Leadership\", \"Enterprise AI Decision Intelligence\"],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"description\": \"Executive advisory and strategic consulting services for organizations pursuing carbon neutrality, ESG excellence, and AI-enabled decision intelligence.\"\n    }\n  </script>\n  <script crossorigin=\"\" src=\"/assets/index-R2wm1Vio.js\" type=\"module\">\n  </script>\n  <link crossorigin=\"\" href=\"/assets/index-DUFtFU2C.css\" rel=\"stylesheet\">\n  <script type=\"module\">\n   if (window.self === window.top) {\n  let lastPath = \"\";\n  function getPageNameFromPath(path) {\n    const segments = path.split(\"/\").filter(Boolean);\n    return segments[0] || null;\n  }\n  function trackPageView() {\n    const path = window.location.pathname;\n    if (path === lastPath) return;\n    lastPath = path;\n    const pageName = getPageNameFromPath(path) || \"home\";\n    const appId = \"69cae26d57b5c4bdd91128cf\";\n    if (!appId) return;\n    fetch(`/api/app-logs/${appId}/log-use