w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://afridecarbonization.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Afri Decarbonization Corp<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://abasipeople.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Abasi People Foundation<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></li><li><a href=\"https://anchor.fm/sustainability-leadership\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">The Podium of Leadership (The POL) with Victor Udo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Connect</h4><ul class=\"space-y-3\"><li><a href=\"mailto:Victor.Udo@VEUAIStudio.Com\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-3.5 w-3.5\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg> Victor.Udo@VEUAIStudio.Com</a></li><li><a href=\"tel:+13028989542\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-3.5 w-3.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> +1 302 898 9542</a></li><li><a href=\"https://www.linkedin.com/in/victor-udo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-linkedin h-3.5 w-3.5\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg> LinkedIn</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Bucknell University</h4><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council (2019–2025)</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Lewisburg, Pennsylvania</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">#25 Top 50 Green Universities, USA (2022–23)</p><p class=\"text-white/50 text-xs leading-relaxed\">~30% carbon footprint reduction achieved</p></div></div></div><div class=\"border-t border-white/10\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3\"><p class=\"text-white/40 text-xs\">© 2026 Victor Udo, FNSE, PhD. All rights reserved.</p><button class=\"text-white/40 hover:text-white text-xs flex items-center gap-1.5 transition-colors group\" aria-label=\"Back to top\">↑ Back to top</button></div></div></footer></div><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></div></div></div>\n \n\n</body></html>\n","bodyText":"Abasi People Forum Podcast | Voice of Abasi Nation Dr. Victor Udo Executive · AI Builder · Author · Community Leader Home About VEU AI Studio Abasi People Abasi People Foundation Abasi People Forum Podcast Speaking Publications Contact More ▾ Blog & Insights Carbon Calculator Afri Decarbonization Advisory Services News Gallery Mother's Memorial Work With Victor View Dr. Udo's Profile & Banner Summary → × Abasi People Forum Podcast The Voice of Abasi Nation — Speaking Truth to Power, Uniting a People, Building a Future The Abasi People Forum Podcast (APFP) is the official podcast of the Abasi People Foundation and Movement. Hosted and produced by Destiny Isong, the APFP carries the message of unity and self-emancipation for the Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo peoples as one Abasi Nation — towards equitable sustainable development in Nigeria and the global diaspora. Season 1: 2025–2026. Listen on Facebook Join the APF Community About About the Podcast Host & Producer Destiny Isong is the Host and Producer of the Abasi People Forum Podcast — giving authentic voice to the issues, aspirations, and collective vision of the Abasi Nation across Nigeria and the global diaspora. Who We Speak For The seven peoples of Abasi Nationality — Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo — the fourth largest ethnic nationality in Nigeria, united under one identity: Ndito Abasi. Our Message Self-emancipation of the Abasi Nation from both internal and external marginalization and exploitation, towards equitable sustainable development where no one is left behind. Programming Format Routine Issue-Centric Episodes. Each episode is anchored on a specific issue facing the Abasi Nation — governance, identity, development, culture, unity, youth, or diaspora — with direct, honest, community-driven dialogue. Listen Where to Listen The APFP is available free on the following platforms. Facebook (Primary) All episodes live and archived on the ABASI People Online Facebook page (15,000+ followers). Watch & Listen TikTok Episodes 20–28 available on Ibom Express TV (Reloaded) on TikTok. Watch on TikTok Anchor / Spotify for Podcasters Hosted on Anchor with distribution to major platforms. Subscribe free. Listen on Anchor For partnerships, distribution inquiries, or to suggest episode topics, contact info@victorudo.com . Episodes Episodes — Season 1 (2025–2026) 28 episodes of direct, issue-centric dialogue on emancipation, governance, unity, and equitable development for Ndito Abasi. All Governance Emancipation & Identity Development Unity Culture Youth 1. Introduction to the Abasi People Forum Podcast July 28, 2025 Emancipation & Identity The inaugural episode of the APFP — introducing the podcast, its mission, and the Abasi Nation movement for unity and equitable development. Coming to Archive 2. Who Are the Abasi People? August 4, 2025 Emancipation & Identity A foundational episode establishing the identity, history, and shared heritage of the seven peoples of Abasi Nationality. Coming to Archive 3. Abasi — The Divine Thread of Unity August 11, 2025 Unity \"Abasi is the divine thread that weaves Ibibio, Annang, Efik, Oro, Ekid, Obolo, and Ekoi people into one nationality fabric with a shared identity and culture.\" — Dr. Victor Udo Watch Episode 4. The Case for Abasi Nation Self-Governance August 18, 2025 Governance Examining the structural and political case for greater Abasi Nation self-governance within the Nigerian federal system. Coming to Archive 5. Marginalization and the Path Forward August 25, 2025 Emancipation & Identity A candid conversation on the internal and external forces of marginalization facing the Abasi Nation and the roadmap to collective emancipation. Coming to Archive 6. Shared Identity as the Foundation for Equitable Development September 2025 Emancipation & Identity Why a unified Abasi identity is the non-negotiable foundation for achieving equitable and sustainable development for all Ndito Abasi. Watch Episode 7. Self-Control and Resource Management — The Path to Autonomy September 21, 2025 Governance \"We are not advocating for any form of disintegration in Nigeria. Instead, we emphasize the need for greater self-control and more effective management of human and natural resources to achieve equitable and sustainable development across Abasi Nation.\" — Dr. Victor Udo Watch Episode 8. Building the Abasi People Foundation — Vision and Structure September 2025 Emancipation & Identity An inside look at the founding, structure, and strategic vision of the Abasi People Foundation and its role in uniting Ndito Abasi globally. Coming to Archive 9. Growing the Abasi Nation Movement October 18, 2025 Unity A progress update on the Abasi People Foundation movement — its reach, growing membership, and the momentum building across Nigeria and the diaspora. Watch Episode 10. APF Momentum — A New Season of Mobilization October 27, 2025 Unity Reflecting on a pivotal moment in the APF's growth and calling on all Ndito Abasi to join the movement for collective emancipation. Watch Episode 11. Raising World-Class Talent from Abasi Nation November 2, 2025 Youth How do we produce global superstars — in music, business, sport, and leadership — from Ibibio, Annang, Efik, Oro, Ekid, Obolo, and Ekoi? What must we do differently to develop and celebrate our own? Watch Episode 12. Abasi Nation — Season 1 Episode 12 November 2025 Governance Continuing the conversation on Abasi Nation governance, identity, and the pathway to equitable sustainable development. Watch Episode 13. Abasi Nation — Season 1 Episode 13 November 2025 Emancipation & Identity Issue-centric dialogue on the real challenges and real solutions facing the Abasi Nation. Watch Episode 14. The Kind of Emancipation the Abasi People Foundation is Bringing November 30, 2025 Emancipation & Identity Dr. Victor Udo explains precisely what emancipation means for the Abasi Nation — and what the APF is doing to make it real for every community. Watch Episode 15. Arise and Know Who Is Coming Into Our Communities December 7, 2025 Governance \"Ibibio, Annang, Efik, Oro, Ekid, Obolo, and Ekoi — ARISE AND KNOW WHO'S COMING INTO OUR COMMUNITIES.\" — Dr. Victor Udo. A call to awareness, vigilance, and collective self-protection for Ndito Abasi. Watch Episode 16. Securing Abasi Nation — From Grassroots to Government December 12, 2025 Governance The Abasi People Foundation's approach to securing the Abasi Nation — beginning in villages and LGAs, extending to state government, and across the entire South-South region. Watch Episode 17. Strategies to Unite and Emancipate the Abasi Nation December 22, 2025 Unity A focused episode on the concrete strategies — political, cultural, economic, and social — that will unite the seven Abasi peoples and accelerate collective emancipation. Watch Episode 18. Abasi Nation — Season 1 Episode 18 January 2026 Development Continuing the dialogue on development, unity, and emancipation for the Abasi Nation. Watch Episode 19. Industrialization — The Key to Unlocking Abasi Nation's Greatness January 13, 2026 Development \"Establishing factories and industries across Abasi Nation would empower its people through sustainable, good-paying jobs, promote entrepreneurship, and enhance living standards.\" — Dr. Victor Udo. A call to leaders and investors to unlock the region's immense industrial potential. Watch Episode 20. Abasi Nation — Season 1 Episode 20 January 2026 Emancipation & Identity Issue-centric dialogue on Abasi Nation emancipation and equitable development. Watch Episode 21. Abasi Nation — Season 1 Episode 21 February 2026 Unity Building and sustaining unity across the seven peoples of Abasi Nationality. Watch Episode 22. Abasi Nation — Season 1 Episode 22 February 2026 Governance Direct, honest dialogue on governance and representation for the Abasi Nation. Watch Episode 23. Abasi Nation — Season 1 Episode 23 February 2026 Development Pathways to equitable development across all seven Abasi communities. Watch Episode 24. Abasi Nation — Season 1 Episode 24 March 2026 Emancipation & Identity The ongoing conversation on identity, self-determination, and dignity for all Ndito Abasi. Watch Episode 25. Abasi Nation — Season 1 Episode 25 March 2026 Youth The role of Abasi youth in leading the next generation of the emancipation movement. Watch Episode 26. Abasi Nation Cultural Heritage — Our Shared Ancestry and Collective Future March 20, 2026 Culture The Abasi Nation encompasses Ibibio, Annang, Efik, Oro, Ekid, Obolo, and Ekoi — the fourth largest ethnic bloc in Nigeria. This episode explores the shared heritage, spiritual bonds, and the call on Senators Akpabio and Ekayenyi and Governors Otu and Eno to deliver equitable development as the Ibom Deep Seaport comes online. Watch Episode 27. Abasi Nation — Season 1 Episode 27 March 2026 Governance Continuing the call for equal representation and equitable governance for all Ndito Abasi within Nigeria's national structure. Watch Episode 28. One Abasi Nation — Unity Amplifies Strength March 27, 2026 Emancipation & Identity The Abasi People Foundation reaffirms that the Abasi Nation — as the fourth largest ethnic nationality in Nigeria — commands significant national influence. Identifying as a unified Abasi Nation amplifies collective strength and accelerates development. Fragmentation weakens. Unity wins. Watch Episode Engage Be Part of the Movement The Abasi People Forum Podcast is more than a podcast — it is a platform for the collective voice of Ndito Abasi. Follow, share, and engage. Follow the Podcast Follow ABASI People Online on Facebook to get notified when new episodes drop. Follow on Facebook Join the Community Join the Abasi People Foundation Facebook group to engage directly with APF leadership and fellow Ndito Abasi. Join APF Group Contact APF To suggest episode topics, request appearances, or partner with the APFP. Contact APF The Abasi People Forum Podcast is a production of the Abasi People Foundation. Host & Producer: Destiny Isong. Founding Chairman/President/CEO: Dr. Victor Udo, PhD, FNSE. For partnership and media inquiries: info@victorudo.com Victor Udo, FNSE, PhD Engineer · Executive · AI Builder · Author · Community Leader Founder, VEU AI Studio · Chairman/CEO, Afri Decarbonization Corporation · Founding Chairman/President/CEO, Abasi People Foundation · Former Director of Sustainability & Chairman, President's Sustainability Council — Bucknell University (2019–2025) Quick Links Home About Blog & Insights Books Speaking News Gallery Publications Contact Platforms & Organizations VEU AI Studio SAIGE Demo Afri Decarbonization Corp Abasi People Foundation Abasi People Forum Podcast The Podium of Leadership (The POL) with Victor Udo Connect Victor.Udo@VEUAIStudio.Com +1 302 898 9542 LinkedIn Bucknell University Former Director of Sustainability & Chairman, President's Sustainability Council (2019–2025) Lewisburg, Pennsylvania #25 Top 50 Green Universities, USA (2022–23) ~30% carbon footprint reduction achieved © 2026 Victor Udo, FNSE, PhD. All rights reserved. ↑ Back to top","contentTruncated":{"html":false,"bodyText":false,"maxStoredHtmlBytes":250000,"maxStoredBodyTextBytes":50000},"contentLength":84585,"findings":[]},{"url":"https://victorudo.com/speaking","depth":1,"status":"fetched","method":"browserless","httpStatus":null,"title":"Speaking & Executive Advisory | Victor Udo, FNSE, PhD | AI, Sustainability, ESG & African Development","html":"<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/754a2285a_VEULinkedINPic.jpg\" rel=\"icon\" type=\"image/jpeg\">\n  <meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n  <!-- Performance: Preconnect & DNS Prefetch -->\n  <link href=\"https://fonts.googleapis.com\" rel=\"preconnect\">\n  <link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\">\n  <link href=\"https://media.base44.com\" rel=\"dns-prefetch\">\n  <link href=\"https://www.google-analytics.com\" rel=\"dns-prefetch\">\n  <!-- Google Site Verification -->\n  <meta content=\"UPQLHTlymB5ijLSuhYAcOykBAhG7gB6gbBpg6n10KTA\" name=\"google-site-verification\">\n  <!-- Sitemap Discovery -->\n  <link href=\"https://victorudo.com/sitemap\" rel=\"sitemap\" type=\"application/xml\">\n  <!-- Primary Meta Tags -->\n  <title>Speaking &amp; Executive Advisory | Victor Udo, FNSE, PhD | AI, Sustainability, ESG &amp; African Development</title>\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"title\">\n  \n  <meta content=\"Victor Udo, VEU AI Studio, SAIGE, sustainability, ESG, decarbonization, AI, Abasi Nation, Ibibio, Annang, Efik, Oro, Ekoi, Ekid, Obolo, Ndito Abasi, Abasians, Abasi People Foundation, Afri Decarbonization, carbon neutrality, Nigeria, Akwa Ibom, Bucknell University\" name=\"keywords\">\n  <meta content=\"Victor Udo, FNSE, PhD\" name=\"author\">\n  <meta content=\"index, follow\" name=\"robots\">\n  <!-- Open Graph / Facebook -->\n  <meta content=\"website\" property=\"og:type\">\n  <meta content=\"https://victorudo.com/speaking\" property=\"og:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" property=\"og:title\">\n  <meta content=\"profile\" property=\"og:type\">\n  <meta content=\"Founder of VEU AI Studio, Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation uniting Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo as Abasi Nation.\" property=\"og:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" property=\"og:image\">\n  <meta content=\"1200\" property=\"og:image:width\">\n  <meta content=\"630\" property=\"og:image:height\">\n  <meta content=\"Dr. Victor Udo\" property=\"og:site_name\">\n  <meta content=\"en_US\" property=\"og:locale\">\n  <!-- Twitter Card -->\n  <meta content=\"summary_large_image\" name=\"twitter:card\">\n  <meta content=\"https://victorudo.com/speaking\" name=\"twitter:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"twitter:title\">\n  <meta content=\"Founder of VEU AI Studio (SAIGE, RelTwin), Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation.\" name=\"twitter:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" name=\"twitter:image\">\n  <!-- Structured Data: Person -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Person\",\n      \"name\": \"Victor Udo\",\n      \"honorificSuffix\": \"FNSE, PhD\",\n      \"jobTitle\": \"AI Platform Builder, Decarbonization Champion\",\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victorudo\",\n        \"https://www.researchgate.net/profile/Victor-Udo\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"knowsAbout\": [\"Decarbonization\", \"AI Platforms\", \"ESG\", \"Sustainability Leadership\", \"Electric Power Systems\", \"Carbon Markets\", \"Public Policy\", \"Abasi Nation\"],\n      \"alumniOf\": [\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Delaware\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Pennsylvania\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"Howard University\" }\n      ],\n      \"worksFor\": [\n        { \"@type\": \"Organization\", \"name\": \"VEU AI Studio\", \"url\": \"https://veuaistudio.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Afri Decarbonization Corporation\", \"url\": \"https://afridecarbonization.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Abasi People Foundation\", \"url\": \"https://abasipeople.org\" }\n      ],\n      \"knowsAbout\": [\"Artificial Intelligence\", \"Sustainability\", \"ESG\", \"Decarbonization\", \"Energy Systems\", \"Carbon Markets\", \"Abasi Nation\", \"Public Policy\", \"Corporate Governance\"]\n    }\n  </script>\n  <!-- Structured Data: Organization (VEU AI Studio) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Organization\",\n      \"name\": \"VEU AI Studio\",\n      \"url\": \"https://veuaistudio.com\",\n      \"founder\": { \"@type\": \"Person\", \"name\": \"Victor Udo, FNSE, PhD\" },\n      \"description\": \"Agentic AI platforms for real-world decision intelligence — SAIGE (ESG/SDGs), RelTwin, ReachSMS, and PressAI.\",\n      \"sameAs\": [\"https://veuaistudio.com\"]\n    }\n  </script>\n  <!-- Structured Data: WebSite with SearchAction (enables Google Sitelinks Search Box) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebSite\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"url\": \"https://victorudo.com\",\n      \"description\": \"Official website of Victor Udo, FNSE, PhD — AI Builder, Sustainability Leader, and Abasi Foundation Leader.\",\n      \"potentialAction\": {\n        \"@type\": \"SearchAction\",\n        \"target\": {\n          \"@type\": \"EntryPoint\",\n          \"urlTemplate\": \"https://victorudo.com/news?q={search_term_string}\"\n        },\n        \"query-input\": \"required name=search_term_string\"\n      }\n    }\n  </script>\n  <!-- Structured Data: FAQ (common searches about Victor Udo) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Who is Dr. Victor Udo?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is an AI platform builder, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is SAIGE by VEU AI Studio?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"SAIGE is an agentic AI platform for enterprise decision intelligence on ESG, SDGs, EHS, CSR, and sustainability governance. It provides real-time analytics and impact assessment for organizations managing sustainability targets and carbon neutrality goals.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Abasi People Foundation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The Abasi People Foundation, founded by Dr. Victor Udo, is a movement uniting seven peoples — Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo — as Abasi Nation, the 4th largest ethnic nationality in Nigeria with vision for sustainable development and unity.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is Afri Decarbonization Corporation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Afri Decarbonization Corporation (ADC), led by Victor Udo, FNSE, PhD as Chairman/CEO, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What topics does Dr. Victor Udo speak on?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD speaks on AI for enterprise decisions, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How can I book Dr. Victor Udo for a speaking engagement?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Use the contact form at victorudo.com/contact and select 'Speaking Engagement' as the inquiry type. Provide event details, audience size, and preferred topics. Victor Udo, FNSE, PhD personally reviews all speaking requests and responds within 48 hours.\" } as the inquiry type. Provide event details, audience size, and preferred topics. Dr. Udo personally reviews all speaking requests and responds within 48 hours.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What are Dr. Victor Udo's published books?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is author of 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" } 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Bucknell Carbon Neutrality initiative?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"As Director of Sustainability at Bucknell University, Victor Udo, FNSE, PhD led the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" } the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" }\n        }\n      ]\n    }\n  </script>\n  <!-- Structured Data: LocalBusiness (Lewisburg Office) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"description\": \"AI platform builder, sustainability executive, and community leader. Consulting and advisory services for ESG, decarbonization, and enterprise AI decision intelligence.\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Lewisburg\",\n        \"addressRegion\": \"PA\",\n        \"postalCode\": \"17837\",\n        \"addressCountry\": \"US\"\n      },\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"telephone\": \"+1-570-577-1234\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victor-udo/\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"knowsAbout\": [\n        \"Artificial Intelligence\",\n        \"Enterprise AI\",\n        \"Sustainability\",\n        \"ESG Governance\",\n        \"Decarbonization\",\n        \"Carbon Markets\",\n        \"Energy Transition\",\n        \"Corporate Leadership\",\n        \"Public Policy\",\n        \"African Development\"\n      ]\n    }\n  </script>\n  <!-- Structured Data: ProfessionalService (Consulting & Advisory) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ProfessionalService\",\n      \"name\": \"Victor Udo, FNSE, PhD — Sustainability & AI Consulting\",\n      \"provider\": {\n        \"@type\": \"Person\",\n        \"name\": \"Victor Udo\",\n        \"honorificSuffix\": \"FNSE, PhD\",\n        \"email\": \"info@victorudo.com\",\n        \"url\": \"https://victorudo.com\"\n      },\n      \"serviceType\": [\"Advisory Services\", \"Strategic Consulting\", \"ESG Governance\", \"Sustainability Leadership\", \"Enterprise AI Decision Intelligence\"],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"description\": \"Executive advisory and strategic consulting services for organizations pursuing carbon neutrality, ESG excellence, and AI-enabled decision intelligence.\"\n    }\n  </script>\n  <script crossorigin=\"\" src=\"/assets/index-R2wm1Vio.js\" type=\"module\">\n  </script>\n  <link crossorigin=\"\" href=\"/assets/index-DUFtFU2C.css\" rel=\"stylesheet\">\n  <script t