colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold text-xs sm:text-sm px-4 sm:px-6 h-9 sm:h-10 rounded-lg shadow-md\">Work With Victor</button></a><button class=\"lg:hidden text-white p-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></div></nav></div><div class=\"fixed top-16 lg:top-20 left-0 right-0 z-40 bg-accent text-accent-foreground flex items-center justify-center py-1.5 px-8\"><a class=\"text-xs font-semibold hover:underline flex-1 text-center\" href=\"/linkedin-banner\">View Dr. Udo's Profile &amp; Banner Summary →</a><button class=\"absolute right-3 text-accent-foreground/70 hover:text-accent-foreground text-base leading-none\" aria-label=\"Dismiss\">×</button></div><main class=\"flex-1 pt-24 lg:pt-28 transition-all duration-300\"><div><div class=\"bg-primary text-white py-16 lg:py-24\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"grid lg:grid-cols-2 gap-8 items-center\"><div><h1 class=\"font-heading text-4xl lg:text-5xl font-bold mb-8 leading-tight\">Victor Udo, FNSE, PhD</h1><div class=\"grid grid-cols-2 gap-4\"><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">25+</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">Years Leadership</p></div><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">4</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">AI Platforms</p></div><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">1.8M</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">Hectares MOU</p></div><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">7</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">Peoples United</p></div><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">~30%</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">Carbon Reduction</p></div><div class=\"bg-white/10 rounded-lg p-5 backdrop-blur-sm border border-white/10\"><p class=\"font-heading text-3xl font-bold text-accent mb-1\">415+</p><p class=\"text-xs font-semibold text-white/80 uppercase tracking-wide\">V2G Citations</p></div></div></div><div class=\"flex flex-col items-center\"><div class=\"mb-8\"><img src=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\" alt=\"Dr. Victor Udo\" class=\"w-56 h-56 rounded-full object-cover object-top border-4 border-accent shadow-2xl\"></div><div class=\"text-center\"><span class=\"inline-block px-3 py-1 bg-accent/20 text-accent text-xs font-bold uppercase tracking-widest rounded-full mb-3\">Author</span><div class=\"space-y-2 text-white/70 text-xs leading-relaxed max-w-xs mx-auto\"><p>Which Way Nigeria? Structure, Leadership...</p><p>Sustainability Insights for Electric Power Sector Transformation...</p><p>Structural and Leadership Insights for National Sustainable Development...</p></div></div></div></div></div></div><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Leadership</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Current and Recent Areas of Leadership</h2></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5\"><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"eyebrow text-[10px] block mb-2\">Founder</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">VEU AI Studio</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-3\">Building four AI platforms for organizational and personal leadership, communications, relationships and decisions for better results</p><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-xs inline-flex items-center gap-1\">Visit <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"eyebrow text-[10px] block mb-2\">Chairman/CEO</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Afri Decarbonization Corporation</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-3\">Leading nature-based decarbonization across West Africa. MOU with Cross River State Government covering 1.8 million hectares total — 1.6 million hectares of forest for carbon sink and 200,000 hectares for regenerative agriculture.</p><a href=\"https://afridecarbonization.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-xs inline-flex items-center gap-1\">Visit <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"eyebrow text-[10px] block mb-2\">Director of Sustainability &amp; Chairman, President's Sustainability Council (2019–2025)</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Bucknell University</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-3\">Led the 10-year carbon neutrality roadmap. ~30% reduction achieved. Ranked #25 among Top 50 Green Universities. Both roles held concurrently.</p></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"eyebrow text-[10px] block mb-2\">Founding Chairman/CEO</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Abasi People Foundation</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-3\">Movement uniting seven peoples - Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo as Abasi Nation - the 4th largest ethnic nationality in Nigeria both at home and the global diaspora.</p><a href=\"https://abasipeople.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-xs inline-flex items-center gap-1\">Visit <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div><div class=\"bg-card rounded-lg p-6 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"eyebrow text-[10px] block mb-2\">Senior Advisor</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Advisory &amp; Thought Leadership</h3><p class=\"text-xs text-muted-foreground leading-relaxed mb-3\">Advisor to enterprises, governments, and institutions on sustainability strategy, ESG, energy transition, and AI.</p><a class=\"text-accent font-semibold text-xs inline-flex items-center gap-1\" href=\"/advisory\">View <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3 w-3\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\" mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Biography</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Victor Udo, FNSE, PhD</h2></div><div class=\"max-w-4xl space-y-5 text-muted-foreground leading-relaxed\"><p>Dr. Victor Udo is a transformational executive and founder building AI platforms for real-world decision-making across leadership, communication, relationships, governance, and enterprise impact at the intersection of society, technology, and environment. He has over 25 years of experience spanning engineering, energy, public policy, and sustainable development across the United States and West Africa, with direct P&amp;L and executive leadership responsibilities.</p><p>He is the Founder of VEU AI Studio, where he leads the development of AI-driven platforms including RelTwin, ReachSMS, PressAI, and SAIGE — an enterprise decision intelligence system for ESG, SDGs, EHS, CSR, and sustainability performance. His work focuses on helping individuals and organizations move beyond static reporting to real-time, actionable decisions across people, planet, and progress.</p><p>Previously, as Director of Sustainability at Bucknell University, he led the development and execution of a comprehensive roadmap toward carbon neutrality, zero waste, and ecosystem restoration, contributing to nearly a 30% reduction in emissions from a 2008 baseline and national recognition among top green institutions in the United States.</p><p>He also leads large-scale decarbonization and regenerative development initiatives in Africa as Chairman/CEO of Afri Decarbonization Corporation (ADC), including agreements with the Cross River State Government covering over 1.6 million hectares of forest and 200,000 hectares of agricultural land. These initiatives integrate carbon markets, biodiversity conservation, and community-driven economic development to deliver measurable ESG and SDG outcomes.</p><p>Earlier in his career, Dr. Udo held executive and strategic roles in the energy sector, including managing multi-billion-dollar risk portfolios at Pepco Holdings and serving as CEO of a power generation company with a 700 MW license. He was appointed by then-County Executive Chris Coons (now US Senator for Delaware) to the New Castle County Planning Board, and has worked closely with government leaders across multiple jurisdictions in both the U.S. and Africa.</p><p>Dr. Udo is a published author and continues to focus on building systems that enable equitable, scalable, and measurable impact across people, planet, and progress.</p></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Capabilities</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Areas of Strength &amp; Expertise</h2></div><div class=\"flex flex-wrap gap-3 justify-center\"><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Nature-Based Research, Consulting &amp; Operations</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">P&amp;L Management &amp; Results Orientation</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Collaborative Local, State, National &amp; Global Governance</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Equitable Sustainable Development</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Decarbonization, Decentralization &amp; Digitalization</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">People, Processes &amp; Technology (PPT) Systems</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Energy Infrastructure &amp; Utility Management</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Renewable Energy, Smart Grids &amp; Electric Vehicles</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Climate Change Mitigation</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Risk Management &amp; Investment Strategy</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Public Policy Leadership</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Corporate Governance &amp; BOD Relations</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Multi-Year Business Plan Development &amp; Implementation</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Business Startup, Transformation &amp; Revitalization</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Stakeholder Relations &amp; Customer Satisfaction</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">ESG Governance</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Diversity, Equity, Inclusion &amp; Justice (DEIJ)</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">AI Platform Strategy</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Community Development &amp; Social Advocacy</span><span class=\"bg-secondary text-secondary-foreground px-4 py-2 rounded-full text-sm font-medium border border-border/50\">Planning, Budgeting &amp; ROI Analysis</span></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Purpose</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Mission, Vision &amp; Values</h2></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-xl font-bold text-foreground mb-4\">Mission</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">To provide long-lasting and effective sustainability solutions — and AI-powered decision intelligence — to assist leaders, companies, organizations, and countries. And to unite and empower the Abasi Nation for equitable sustainable development. And to decarbonize Africa through nature-based solutions where no one is left behind.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-xl font-bold text-foreground mb-4\">Vision</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">To be a leading global voice at the intersection of sustainability, governance, nature-based decarbonization, AI, and community leadership — bringing transformational solutions to enterprises and nations across the world.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-xl font-bold text-foreground mb-4\">Values</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Integrity · Excellence · Diligence · Results-Delivery · Unity · Impact · Justice</p></div></div></div></section><section id=\"early-career\" class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Foundation</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Early Career — Building Expertise (1984–2006)</h2></div><div class=\"space-y-8\"><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">1984–1986</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Technical Supervisor</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Sunshine Batteries Ltd — Ikot Ekpene, Nigeria</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Responsible for the plant's 4MW diesel power station including switchgears for synchronizing and controlling the factory's reactive load.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">1986–1987</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Energy Management Assistant</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Miles College — Birmingham, Alabama, USA</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Supporting energy management initiatives and campus operations.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">1987–1991</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Research Assistant</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Energy Network System Laboratory, Howard University — Washington DC</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Under Professor James Momoh. Conducting research on energy systems and network analysis.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">1991–1995</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Senior Engineer, System Planning / Engineer, Power Station</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Atlantic Electric — New Jersey</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Electrical engineering at B.L. England Power Station (450MW). Responsible for load-flow, stability, fault analysis, and contingency modeling. Appointed to NJ Governor's Renewable Energy Taskforce.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">1995–2001</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Business Performance &amp; Senior Marketing Associate</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Atlantic Energy — New Jersey</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Introduced Balanced Scorecard to CEO, senior management, and Board. Strategic business performance management and market development.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2001–2003</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Technology R&amp;D / Manager, Planning &amp; Performance</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Conectiv, Inc. — Delaware</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Pioneered Vehicle-to-Grid (V2G) research. Led planning and performance optimization across the organization.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2003–2004</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Power Delivery Process</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Conectiv, Inc. — Delaware</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Led development of people, process, and technology integration across power delivery systems.</p></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2004–2006</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Business Planning and Research</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Pepco Holdings, Inc. — Washington DC</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Supported Chairman/CEO Team in multi-year strategic business plan development and execution.</p></div></div></div></section><section id=\"career\" class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Career</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Complete Professional Experience (2006–Present)</h2></div><div class=\"max-w-4xl mx-auto bg-secondary rounded-lg p-8 mb-8\"><p class=\"text-sm text-muted-foreground leading-relaxed\"><strong>Born</strong> 1961 in Akwa Ibom State, Nigeria. <strong>Raised</strong> under the mentorship of his maternal grandfather Rev. E.U. Umoh, a Qua Iboe Church minister. <strong>Earned</strong> City &amp; Guilds Certification in Electrical Installation and 8 GCE credits at Government Technical College Abak in 1981.  <strong>Worked</strong> with Ekpo Electric Nigeria Ltd, Calabar from 1981 to 1982.  <strong>Obtained</strong> National Diploma from the Polytechnic, Calabar (PolyCal, Ekpo Abasi) in 1983. <strong>Worked</strong> at Sunshine Batteries, Ikot Ekpene till 1986. <strong>Arrived</strong> in the United States in 1986 to pursue graduate education and a career spanning engineering, energy, sustainability, government service, and AI.</p></div><div class=\"space-y-8\"><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2023 – 2024</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Consultant — New Jersey State Energy Security Plan (NJSESP)</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">New Jersey Board of Public Utilities / Rowan University Department of Electrical and Computer Engineering — New Jersey, USA</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Appointed consultant on the New Jersey State Energy Security Plan (NJSESP) through a contract awarded by the New Jersey Board of Public Utilities (BPU) to Rowan University's Department of Electrical and Computer Engineering. The NJSESP is a federal mandate under Section 40108 of the Bipartisan Infrastructure Law, requiring all U.S. states to assess their energy infrastructure, identify physical and cybersecurity risks, and develop grid resilience strategies as a condition of receiving federal DOE funding. Dr. Udo's engagement drew on his 25+ years of experience in the U.S. electric utility sector, energy policy, and sustainability leadership.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Federal mandate compliance under Section 40108 of the Bipartisan Infrastructure Law</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>State energy infrastructure assessment and grid resilience strategy development</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Physical and cybersecurity risk identification for New Jersey's energy systems</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Collaboration with Rowan University Department of Electrical and Computer Engineering and state energy officials</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Application of 25+ years of utility operations, policy, and sustainability expertise to state-level energy security planning</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2019 – 2025</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Director of Sustainability</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Bucknell University — Lewisburg, Pennsylvania, USA</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Hired to help Bucknell pursue a key initiative in its Strategic Plan: broad-based environmental sustainability addressing energy use and sourcing, biodiversity and natural habitat, waste minimization and recycling, and achieving carbon neutrality by 2030.</p><p class=\"text-xs italic text-muted-foreground mt-0 mb-4\">Concluded February 2025. Currently focused full-time on VEU AI Studio, Afri Decarbonization Corporation, and the Abasi People Foundation.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Strategic, tactical, and operational leadership of Bucknell's environmental sustainability objective through simultaneous planning and implementation of a 10-year comprehensive sustainability plan</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Establishment and leadership of four multi-disciplinary campus-wide working groups: carbon neutrality, zero waste, ecological conservation/restoration, and socially responsible investing — using an ESG and DEI framework</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Completed carbon footprint inventory update (Scopes 1, 2, and 3) across the 500-acre campus</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Developed a decarbonization strategy white paper and AASHE/STARS report improvement from Silver to Gold Rating</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Achieved Princeton Review Top 50 Green Universities ranking</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Completed a 1.76MW Solar Farm representing 8% energy and carbon emission reduction</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Exceeded carbon commitment goal of 20% reduction by 2020 with 29% actual reduction — on track for 2030 carbon neutrality goal</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Identified and developed a list of over 30 projects for fundraising campaign</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Leading a consortium including Goldman Sachs to explore nature-based decarbonization opportunities in Africa</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Co-Chair of Bucknell's Legal/Finance &amp; Administration DEI Council and Diversity, Equity and Justice Working Group of the SDSN</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Established and implemented 'Green Tank' innovation process</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Publication of Sustainability @ Bucknell e-newsletter every semester since Spring 2020</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2016 – 2019</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Senior Special Assistant to the Governor on Planning</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Akwa Ibom State Government — Nigeria</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Appointed to lead 50 Heads of Planning, Research, and Statistics (PRS) across State Ministries, Departments, and Agencies (MDAs), reporting directly to the State Governor.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>First-ever Senior Specialist Assistant on Planning to the Akwa Ibom State Governor</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Established and executed a comprehensive sustainable development planning, implementation, and evaluation process</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Engaged stakeholders on the state government's five-point strategic agenda</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Led establishment of a comprehensive planning process aligned with the UN 17 Sustainable Development Goals</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Recipient of Award for Distinguished Professional Contributions to Public Service, 2018</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Honored as Fellow, Institute of Corporate Administration, 2018</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2014 – 2016</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Managing Director / Chief Executive Officer (CEO)</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Ibom Power Company Ltd — Akwa Ibom State, Nigeria</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Electrical power generation company providing power to the national grid, with accrued average annual revenue exceeding $40M.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Transformed the company from a failing government project to a value-adding limited liability asset</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Implemented the dead-bus function to island the plant from the frequently collapsing national grid thus creating a macro grid of steady power supply for Akwa Ibom State and Calabar part of Cross River State</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Within first 100 days, stabilized technical and commercial operations — increased available capacity from barely 37MW to 115MW</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Secured expansion license from 191MW to 685MW through collaborative leadership and negotiations</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Completed and configured the second of three units, increasing available capacity to 153MW</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Made financial returns to the state government in addition to paying preexisting debts</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2012 – 2014</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Senior Special Assistant to the Governor on Power</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Akwa Ibom State Government — Nigeria</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Recruited from the USA to assist the State Governor on power sector policy, managing 25 direct reports and leading a large inter-ministerial team.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Established the Power Sector Unit — managed over $100M in cumulative investments in electric power distribution infrastructure</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Directed state involvement and investment in the $2B+ Federal Government power distribution privatization process</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Achieved 50% reduction in vandalism of power equipment through community partnerships</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Achieved 40% reliability improvement through staff training and power outage monitoring</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Steered development of Akwa Ibom State Macro-grid with Mini-grids and Pico-grids</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2009 – 2012</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Public Policy Research &amp; Development</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Pepco Holdings, Inc. (now part of Exelon) — Washington, DC</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Mid-Atlantic transmission and distribution energy firm with over $8B in annual revenues and 4,500 employees.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Led development and management of public policy initiatives</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Facilitated public policy positions on climate change, offshore wind, electric vehicles, renewable portfolio standards</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Summarized top anticipated public policy issues monthly for the Chairman/CEO and C-Suite Executives</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Led a collaborative partnership with University of Delaware, PJM on Vehicle-to-Grid (V2G) participation</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Appointed Member, New Castle County Planning Board by County Executive (now US Senator Chris Coons)</span></li></ul></div><div class=\"border-l-2 border-primary/30 pl-6\"><span class=\"text-sm font-semibold text-accent uppercase tracking-wide\">2006 – 2009</span><h3 class=\"font-heading text-2xl font-bold text-foreground mt-2 mb-1\">Manager, Enterprise Risk Governance &amp; Policy</h3><p class=\"text-sm font-medium text-muted-foreground mb-3\">Pepco Holdings, Inc. — Washington, DC</p><p class=\"text-sm text-muted-foreground leading-relaxed mb-4\">Collaborated on enterprise risk management policy and supported senior executives in managing the liquidity crisis of 2008.</p><ul class=\"space-y-2\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Supported the Chief Risk Officer and senior executives in managing the liquidity crisis of 2008</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Strategic decision to divest $1.7B energy commodity business</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Ensured key credit, market, liquidity, and business risk exposures were identified and reported to the Executive Team and Board</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1.5\">•</span><span>Successfully institutionalized Enterprise Risk Management (ERM) across the Fortune 500 energy company</span></li></ul></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Education</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Academic Credentials</h2></div><div class=\"grid md:grid-cols-2 gap-6 mb-8\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-1\">PhD — Urban Affairs and Public Policy</h3><p class=\"text-sm font-medium text-accent mb-4\">University of Delaware</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Concentration: Governance, Planning and Management of Society, Technology and Environment. Dissertation: 'Exploring Patterns of Sustainable Development, Governance and E-Infrastructure Capacities of Nations for Global Equity Praxis' (Ranked 132 countries on governance, environmental, social, and technological sustainability across 60+ variables.)</p><div class=\"mt-5 flex flex-wrap gap-3\"><a href=\"https://media.base44.com/files/public/69cae26d57b5c4bdd91128cf/71ee5fb87_VEUDissertation.docx\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 bg-accent/10 hover:bg-accent/20 text-accent font-semibold text-sm px-4 py-2.5 rounded-lg border border-accent/30 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> Download Dissertation (DOCX)</a><a href=\"https://media.base44.com/files/public/69cae26d57b5c4bdd91128cf/9cc991fb1_FindalDpre.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 bg-accent/10 hover:bg-accent/20 text-accent font-semibold text-sm px-4 py-2.5 rounded-lg border border-accent/30 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> Download Defense Presentation (PDF)</a></div></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-1\">MSc — Energy Management and Environmental Policy</h3><p class=\"text-sm font-medium text-accent mb-4\">University of Pennsylvania</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Trans-disciplinary education on the issues of energy, economics, and the environment.</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-1\">ME — Electrical Engineering</h3><p class=\"text-sm font-medium text-accent mb-4\">Howard University</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Thesis: 'Adaptive Hierarchical Control for Large-Scale Interconnected Systems'</p></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-1\">BSEE — Power Systems Analysis, Design, Simulations &amp; Evaluation</h3><p class=\"text-sm font-medium text-accent mb-4\">Howard University</p><p class=\"text-sm text-muted-foreground leading-relaxed\">Electricity generation, transmission, distribution, and utilization (load, reliability, quality, and costs)</p></div></div><div class=\"bg-secondary rounded-lg p-6\"><p class=\"text-sm font-semibold text-foreground mb-3\">Executive Training:</p><ul class=\"space-y-2 text-sm text-muted-foreground\"><li>• Harvard University — Negotiations for Senior Executives</li><li>• Paradigm Group — Enterprise-wide Energy Risk Management</li><li>• University of Idaho — Public Utilities Executives' Course</li></ul></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\" mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Purpose</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">His Aspiration</h2></div><div class=\"max-w-4xl space-y-5 text-muted-foreground leading-relaxed\"><p>Victor's relentless passion is to serve the risen Lord Jesus, the Christ of God and humanity. He leverages his background in engineering, public policy, sustainable development, and Fortune 500 energy corporations' leadership to impact society, technology and the environment - people, planet, peace, progress and profit. This work is delivered through scholarship, research, operations, administration, community leadership and AI development.</p><div><p class=\"font-semibold text-foreground mb-4\">His focus areas include:</p><ul class=\"space-y-3\"><li class=\"flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span><strong>AI Products Development</strong> — SAIGE, RelTwin, ReachSMS and PressAI</span></li><li class=\"flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span><strong>Community and Nation Building</strong> — Abasi People Nationality in Nigeria: Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo</span></li><li class=\"flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span><strong>Energy Systems Decarbonization</strong> — storage, waste to energy, electrification of transportation and buildings, and nature-based solutions</span></li><li class=\"flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span><strong>People, Process, and Technology (PPT)</strong> — assets decentralization using digitalization with IoT, Blockchain, and AI in buildings and facilities management for safety, sustainability, resilience, and cost savings</span></li><li class=\"flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span><strong>Provision of Living-Learning Opportunities</strong> for the new generation of global sustainability and ESG leaders in academia, business and community</span></li></ul></div></div></div></section><section class=\"py-20 lg:py-24 bg-secondary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Recognition</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Awards, Fellowships &amp; Professional Affiliations</h2></div><div class=\"grid md:grid-cols-2 gap-12\"><div><h3 class=\"font-heading text-lg font-bold text-foreground mb-5\">Awards &amp; Fellowships</h3><ul class=\"space-y-3\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Smart Energy Decisions DEI Impact Award — Inaugural recipient at the Net Zero Forum, September 2022. Presented by Smart Energy Decisions at the Hilton to recognize outstanding contributions to diversity, equity, and inclusion in the energy sector.</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Fellow of the Nigerian Society of Engineers (FNSE) — Highest engineering recognition in Nigeria, 2016</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Recipient, Award for Distinguished Professional Contributions to Public Service, Nigeria, 2018</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Honored as Fellow, Institute of Corporate Administration, Nigeria, 2018</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Letters of Commendation from Governor Ruth Miner of Delaware and Wilmington City Council</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Obama Organizing Fellow, Delaware for Obama — 2008 Presidential Campaign</span></li></ul></div><div><h3 class=\"font-heading text-lg font-bold text-foreground mb-5\">Professional Affiliations &amp; Board Roles</h3><ul class=\"space-y-3\"><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Advisory Council Member, Association for the Advancement of Sustainability in Higher Education (AASHE)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Co-Chair, Diversity, Equity and Justice Working Group — Sustainable Development Solutions Network (SDSN)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Advisory Board Member, Smart Energy Decisions</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Board of Advisors, Retrolux Inc., Boise, Idaho</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>General Connectional Board Member, CME Church (over 1,000 congregations in USA and Africa)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Board Member, Collins Chapel Hospital, Memphis, TN</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Board Member, Delaware People to People</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, Advisory Board of Electrical Engineering at Rowan University, New Jersey</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Chairman, Energy, Environment &amp; Engineering Network — New Jersey Technology Council (NJTC)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, International Scientific Committee on Energy &amp; Environment, USA</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, Institute of Electrical and Electronic Engineers (IEEE)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, Association of Energy Engineers</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, New Castle County Planning Board (appointed by now US Senator Chris Coons)</span><div class=\"w-full mt-3 bg-secondary rounded-lg p-4 border border-border/50\"><p class=\"text-xs font-semibold text-foreground mb-0.5\">Senator Coons' 2017 Speech in Lagos, Nigeria — U.S.-Africa Relationship</p><p class=\"text-xs text-muted-foreground mb-3\">August 2017 — Congressional delegation visit to Nigeria, Lagos speech on the deep and lasting US-Africa relationship</p><a href=\"https://www.cfr.org/blog/senator-coons-us-africa-relationship\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline\">Read at Council on Foreign Relations <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, New Jersey Governor's Renewable Energy Taskforce</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>SESP Consultant — New Jersey Board of Public Utilities / Rowan University ECE Department, 2023–2025</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, Community Advisory Board, The News Journal (largest newspaper in Delaware)</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, CEOs Monthly Meeting with the Minister of Power, Nigeria</span></li><li class=\"text-sm text-muted-foreground leading-relaxed flex gap-3\"><span class=\"text-accent flex-shrink-0 mt-1\">•</span><span>Member, CEOs Roundtable with the Nigerian Electricity Regulatory Commission (NERC)</span></li></ul></div></div><div class=\"mt-12 bg-card rounded-lg p-7 shadow-sm border border-border/50\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-3\">Nigerian Press Coverage (2012–2019)</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Dr. Victor Udo's public service leadership in Akwa Ibom State (2012–2019) was extensively covered by Nigerian press including <strong>The Nigerian Voice</strong>, <strong>Business Day Nigeria</strong>, <strong>The Ibom Pulpit</strong>, <strong>IbomPower News</strong>, and others.</p><a class=\"inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold px-5 py-2.5 rounded-lg text-sm transition-colors\" href=\"/news\">View Full Press Archive <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"mt-12\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-5\">External Profiles &amp; Research</h3><div class=\"grid sm:grid-cols-2 gap-4\"><a href=\"https://www.nj.gov/bpu/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center justify-between gap-3 bg-card rounded-lg p-4 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/40 transition-all group\"><span class=\"text-sm font-medium text-foreground leading-snug\">NJSESP Consultant Profile — State Energy Security Planning</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4 text-accent flex-shrink-0 group-hover:translate-x-0.5 transition-transform\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><a href=\"https://www.researchgate.net/profile/Victor-Udo\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center justify-between gap-3 bg-card rounded-lg p-4 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/40 transition-all group\"><span class=\"text-sm font-medium text-foreground leading-snug\">ResearchGate Profile — Peer-reviewed Publications, 687+ Citations</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4 text-accent flex-shrink-0 group-hover:translate-x-0.5 transition-transform\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><a href=\"https://www.sdsnusa.org/victor-udo\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center justify-between gap-3 bg-card rounded-lg p-4 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/40 transition-all group\"><span class=\"text-sm font-medium text-foreground leading-snug\">SDSN USA Profile — Sustainable Development Solutions Network</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4 text-accent flex-shrink-0 group-hover:translate-x-0.5 transition-transform\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><a href=\"https://www.bucknell.edu/fac-staff/victor-udo\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center justify-between gap-3 bg-card rounded-lg p-4 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/40 transition-all group\"><span class=\"text-sm font-medium text-foreground leading-snug\">Bucknell University Faculty Page</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4 text-accent flex-shrink-0 group-hover:translate-x-0.5 transition-transform\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><a href=\"https://afridecarbonization.com/victor-udo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center justify-between gap-3 bg-card rounded-lg p-4 border border-border/50 shadow-sm hover:shadow-md hover:border-primary/40 transition-all group\"><span class=\"text-sm font-medium text-foreground leading-snug\">Afri Decarbonization Corporation — Executive Profile</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-4 w-4 text-accent flex-shrink-0 group-hover:translate-x-0.5 transition-transform\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Journey</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">A Career Built Across Sectors and Continents</h2></div><div class=\"max-w-3xl mx-auto\"><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-[14px] top-3 bottom-0 w-px bg-border\"></div><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">1986</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Arrived in the USA</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Began his career in engineering and energy in the United States, starting at Miles College in Birmingham, Alabama, before pursuing graduate education at Howard University — building deep expertise in engineering, energy, and sustainable development over 25+ years.</p></div><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-[14px] top-3 bottom-0 w-px bg-border\"></div><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">1986–2012</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">American Executive Career</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">25+ years of progressive leadership across energy, utilities, risk management, and public policy at Pepco Holdings, Atlantic Electric, and other Fortune 500 companies. Managed a $2B risk portfolio and led utility transformation initiatives.</p></div><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-[14px] top-3 bottom-0 w-px bg-border\"></div><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">2011</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Returned to Nigeria to Serve</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Left corporate America to serve his people in Nigeria — engaged in national development, university administration, government relations, and community leadership for 7+ years.</p></div><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-[14px] top-3 bottom-0 w-px bg-border\"></div><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">2012–2019</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Nigerian Government &amp; Power Sector Leadership</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Served as Senior Special Assistant to the Governor on Power and Planning, transformed Ibom Power Company as CEO, and established state-wide sustainable development planning aligned with the UN SDGs.</p></div><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-[14px] top-3 bottom-0 w-px bg-border\"></div><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">2019</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Returned to the USA</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Returned with a deepened mission: to apply 25+ years of executive experience to AI platforms, nature-based decarbonization, academic leadership, and community empowerment.</p></div><div class=\"relative pl-10 pb-10 last:pb-0\"><div class=\"absolute left-0 top-1.5 w-7 h-7 rounded-full bg-primary/10 border-2 border-primary flex items-center justify-center\"><div class=\"w-2.5 h-2.5 rounded-full bg-primary\"></div></div><span class=\"eyebrow text-[10px] block mb-1\">2020–Present</span><h3 class=\"font-heading text-lg font-bold text-foreground mb-2\">Current Leadership Era</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Founding Abasi People Foundation, Chairman of Bucknell's Sustainability Council, CEO of Afri Decarbonization Corporation, and Founder of VEU AI Studio.</p></div></div></div></section></div></main><footer class=\"bg-primary text-white\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-16 lg:py-20\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><h3 class=\"font-heading text-xl font-bold mb-1\">Victor Udo, FNSE, PhD</h3><p class=\"text-white/60 text-xs leading-relaxed mb-4\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Engineer</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Executive</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">AI Builder</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/publications\">Author</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Community Leader</a></p><p class=\"text-white/50 text-xs leading-relaxed\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">Founder, VEU AI Studio</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/afri-decarbonization\">Chairman/CEO, Afri Decarbonization Corporation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Founding Chairman/President/CEO, Abasi People Foundation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council — Bucknell University (2019–2025)</a></p></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Quick Links</h4><ul class=\"space-y-2\"><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/\">Home</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/about\">About</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/blog\">Blog &amp; Insights</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Books</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/speaking\">Speaking</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/news\">News</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/gallery\">Gallery</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Publications</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Platforms &amp; Organizations</h4><ul class=\"space-y-2\"><li><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">VEU AI Studio<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://saigedemo.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">SAIGE Demo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://afridecarbonization.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Afri Decarbonization Corp<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://abasipeople.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Abasi People Foundation<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></li><li><a href=\"https://anchor.fm/sustainability-leadership\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">The Podium of Leadership (The POL) with Victor Udo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Connect</h4><ul class=\"space-y-3\"><li><a href=\"mailto:Victor.Udo@VEUAIStudio.Com\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-3.5 w-3.5\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg> Victor.Udo@VEUAIStudio.Com</a></li><li><a href=\"tel:+13028989542\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-3.5 w-3.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> +1 302 898 9542</a></li><li><a href=\"https://www.linkedin.com/in/victor-udo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-linkedin h-3.5 w-3.5\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg> LinkedIn</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Bucknell University</h4><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council (2019–2025)</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Lewisburg, Pennsylvania</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">#25 Top 50 Green Universities, USA (2022–23)</p><p class=\"text-white/50 text-xs leading-relaxed\">~30% carbon footprint reduction achieved</p></div></div></div><div class=\"border-t border-white/10\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3\"><p class=\"text-white/40 text-xs\">© 2026 Victor Udo, FNSE, PhD. All rights reserved.</p><button class=\"text-white/40 hover:text-white text-xs flex items-center gap-1.5 transition-colors group\" aria-label=\"Back to top\">↑ Back to top</button></div></div></footer></div><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></div></div></div>\n \n\n</body></html>\n","bodyText":"Victor Udo, FNSE, PhD | About | Howard, UPenn, Delaware, Bucknell Dr. Victor Udo Executive · AI Builder · Author · Community Leader Home About VEU AI Studio Abasi People Abasi People Foundation Abasi People Forum Podcast Speaking Publications Contact More ▾ Blog & Insights Carbon Calculator Afri Decarbonization Advisory Services News Gallery Mother's Memorial Work With Victor View Dr. Udo's Profile & Banner Summary → × Victor Udo, FNSE, PhD 25+ Years Leadership 4 AI Platforms 1.8M Hectares MOU 7 Peoples United ~30% Carbon Reduction 415+ V2G Citations Author Which Way Nigeria? Structure, Leadership... Sustainability Insights for Electric Power Sector Transformation... Structural and Leadership Insights for National Sustainable Development... Leadership Current and Recent Areas of Leadership Founder VEU AI Studio Building four AI platforms for organizational and personal leadership, communications, relationships and decisions for better results Visit Chairman/CEO Afri Decarbonization Corporation Leading nature-based decarbonization across West Africa. MOU with Cross River State Government covering 1.8 million hectares total — 1.6 million hectares of forest for carbon sink and 200,000 hectares for regenerative agriculture. Visit Director of Sustainability & Chairman, President's Sustainability Council (2019–2025) Bucknell University Led the 10-year carbon neutrality roadmap. ~30% reduction achieved. Ranked #25 among Top 50 Green Universities. Both roles held concurrently. Founding Chairman/CEO Abasi People Foundation Movement uniting seven peoples - Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo as Abasi Nation - the 4th largest ethnic nationality in Nigeria both at home and the global diaspora. Visit Senior Advisor Advisory & Thought Leadership Advisor to enterprises, governments, and institutions on sustainability strategy, ESG, energy transition, and AI. View Biography Victor Udo, FNSE, PhD Dr. Victor Udo is a transformational executive and founder building AI platforms for real-world decision-making across leadership, communication, relationships, governance, and enterprise impact at the intersection of society, technology, and environment. He has over 25 years of experience spanning engineering, energy, public policy, and sustainable development across the United States and West Africa, with direct P&L and executive leadership responsibilities. He is the Founder of VEU AI Studio, where he leads the development of AI-driven platforms including RelTwin, ReachSMS, PressAI, and SAIGE — an enterprise decision intelligence system for ESG, SDGs, EHS, CSR, and sustainability performance. His work focuses on helping individuals and organizations move beyond static reporting to real-time, actionable decisions across people, planet, and progress. Previously, as Director of Sustainability at Bucknell University, he led the development and execution of a comprehensive roadmap toward carbon neutrality, zero waste, and ecosystem restoration, contributing to nearly a 30% reduction in emissions from a 2008 baseline and national recognition among top green institutions in the United States. He also leads large-scale decarbonization and regenerative development initiatives in Africa as Chairman/CEO of Afri Decarbonization Corporation (ADC), including agreements with the Cross River State Government covering over 1.6 million hectares of forest and 200,000 hectares of agricultural land. These initiatives integrate carbon markets, biodiversity conservation, and community-driven economic development to deliver measurable ESG and SDG outcomes. Earlier in his career, Dr. Udo held executive and strategic roles in the energy sector, including managing multi-billion-dollar risk portfolios at Pepco Holdings and serving as CEO of a power generation company with a 700 MW license. He was appointed by then-County Executive Chris Coons (now US Senator for Delaware) to the New Castle County Planning Board, and has worked closely with government leaders across multiple jurisdictions in both the U.S. and Africa. Dr. Udo is a published author and continues to focus on building systems that enable equitable, scalable, and measurable impact across people, planet, and progress. Capabilities Areas of Strength & Expertise Nature-Based Research, Consulting & Operations P&L Management & Results Orientation Collaborative Local, State, National & Global Governance Equitable Sustainable Development Decarbonization, Decentralization & Digitalization People, Processes & Technology (PPT) Systems Energy Infrastructure & Utility Management Renewable Energy, Smart Grids & Electric Vehicles Climate Change Mitigation Risk Management & Investment Strategy Public Policy Leadership Corporate Governance & BOD Relations Multi-Year Business Plan Development & Implementation Business Startup, Transformation & Revitalization Stakeholder Relations & Customer Satisfaction ESG Governance Diversity, Equity, Inclusion & Justice (DEIJ) AI Platform Strategy Community Development & Social Advocacy Planning, Budgeting & ROI Analysis Purpose Mission, Vision & Values Mission To provide long-lasting and effective sustainability solutions — and AI-powered decision intelligence — to assist leaders, companies, organizations, and countries. And to unite and empower the Abasi Nation for equitable sustainable development. And to decarbonize Africa through nature-based solutions where no one is left behind. Vision To be a leading global voice at the intersection of sustainability, governance, nature-based decarbonization, AI, and community leadership — bringing transformational solutions to enterprises and nations across the world. Values Integrity · Excellence · Diligence · Results-Delivery · Unity · Impact · Justice Foundation Early Career — Building Expertise (1984–2006) 1984–1986 Technical Supervisor Sunshine Batteries Ltd — Ikot Ekpene, Nigeria Responsible for the plant's 4MW diesel power station including switchgears for synchronizing and controlling the factory's reactive load. 1986–1987 Energy Management Assistant Miles College — Birmingham, Alabama, USA Supporting energy management initiatives and campus operations. 1987–1991 Research Assistant Energy Network System Laboratory, Howard University — Washington DC Under Professor James Momoh. Conducting research on energy systems and network analysis. 1991–1995 Senior Engineer, System Planning / Engineer, Power Station Atlantic Electric — New Jersey Electrical engineering at B.L. England Power Station (450MW). Responsible for load-flow, stability, fault analysis, and contingency modeling. Appointed to NJ Governor's Renewable Energy Taskforce. 1995–2001 Manager, Business Performance & Senior Marketing Associate Atlantic Energy — New Jersey Introduced Balanced Scorecard to CEO, senior management, and Board. Strategic business performance management and market development. 2001–2003 Manager, Technology R&D / Manager, Planning & Performance Conectiv, Inc. — Delaware Pioneered Vehicle-to-Grid (V2G) research. Led planning and performance optimization across the organization. 2003–2004 Manager, Power Delivery Process Conectiv, Inc. — Delaware Led development of people, process, and technology integration across power delivery systems. 2004–2006 Manager, Business Planning and Research Pepco Holdings, Inc. — Washington DC Supported Chairman/CEO Team in multi-year strategic business plan development and execution. Career Complete Professional Experience (2006–Present) Born 1961 in Akwa Ibom State, Nigeria. Raised under the mentorship of his maternal grandfather Rev. E.U. Umoh, a Qua Iboe Church minister. Earned City & Guilds Certification in Electrical Installation and 8 GCE credits at Government Technical College Abak in 1981. Worked with Ekpo Electric Nigeria Ltd, Calabar from 1981 to 1982. Obtained National Diploma from the Polytechnic, Calabar (PolyCal, Ekpo Abasi) in 1983. Worked at Sunshine Batteries, Ikot Ekpene till 1986. Arrived in the United States in 1986 to pursue graduate education and a career spanning engineering, energy, sustainability, government service, and AI. 2023 – 2024 Consultant — New Jersey State Energy Security Plan (NJSESP) New Jersey Board of Public Utilities / Rowan University Department of Electrical and Computer Engineering — New Jersey, USA Appointed consultant on the New Jersey State Energy Security Plan (NJSESP) through a contract awarded by the New Jersey Board of Public Utilities (BPU) to Rowan University's Department of Electrical and Computer Engineering. The NJSESP is a federal mandate under Section 40108 of the Bipartisan Infrastructure Law, requiring all U.S. states to assess their energy infrastructure, identify physical and cybersecurity risks, and develop grid resilience strategies as a condition of receiving federal DOE funding. Dr. Udo's engagement drew on his 25+ years of experience in the U.S. electric utility sector, energy policy, and sustainability leadership. • Federal mandate compliance under Section 40108 of the Bipartisan Infrastructure Law • State energy infrastructure assessment and grid resilience strategy development • Physical and cybersecurity risk identification for New Jersey's energy systems • Collaboration with Rowan University Department of Electrical and Computer Engineering and state energy officials • Application of 25+ years of utility operations, policy, and sustainability expertise to state-level energy security planning 2019 – 2025 Director of Sustainability Bucknell University — Lewisburg, Pennsylvania, USA Hired to help Bucknell pursue a key initiative in its Strategic Plan: broad-based environmental sustainability addressing energy use and sourcing, biodiversity and natural habitat, waste minimization and recycling, and achieving carbon neutrality by 2030. Concluded February 2025. Currently focused full-time on VEU AI Studio, Afri Decarbonization Corporation, and the Abasi People Foundation. • Strategic, tactical, and operational leadership of Bucknell's environmental sustainability objective through simultaneous planning and implementation of a 10-year comprehensive sustainability plan • Establishment and leadership of four multi-disciplinary campus-wide working groups: carbon neutrality, zero waste, ecological conservation/restoration, and socially responsible investing — using an ESG and DEI framework • Completed carbon footprint inventory update (Scopes 1, 2, and 3) across the 500-acre campus • Developed a decarbonization strategy white paper and AASHE/STARS report improvement from Silver to Gold Rating • Achieved Princeton Review Top 50 Green Universities ranking • Completed a 1.76MW Solar Farm representing 8% energy and carbon emission reduction • Exceeded carbon commitment goal of 20% reduction by 2020 with 29% actual reduction — on track for 2030 carbon neutrality goal • Identified and developed a list of over 30 projects for fundraising campaign • Leading a consortium including Goldman Sachs to explore nature-based decarbonization opportunities in Africa • Co-Chair of Bucknell's Legal/Finance & Administration DEI Council and Diversity, Equity and Justice Working Group of the SDSN • Established and implemented 'Green Tank' innovation process • Publication of Sustainability @ Bucknell e-newsletter every semester since Spring 2020 2016 – 2019 Senior Special Assistant to the Governor on Planning Akwa Ibom State Government — Nigeria Appointed to lead 50 Heads of Planning, Research, and Statistics (PRS) across State Ministries, Departments, and Agencies (MDAs), reporting directly to the State Governor. • First-ever Senior Specialist Assistant on Planning to the Akwa Ibom State Governor • Established and executed a comprehensive sustainable development planning, implementation, and evaluation process • Engaged stakeholders on the state government's five-point strategic agenda • Led establishment of a comprehensive planning process aligned with the UN 17 Sustainable Development Goals • Recipient of Award for Distinguished Professional Contributions to Public Service, 2018 • Honored as Fellow, Institute of Corporate Administration, 2018 2014 – 2016 Managing Director / Chief Executive Officer (CEO) Ibom Power Company Ltd — Akwa Ibom State, Nigeria Electrical power generation company providing power to the national grid, with accrued average annual revenue exceeding $40M. • Transformed the company from a failing government project to a value-adding limited liability asset • Implemented the dead-bus function to island the plant from the frequently collapsing national grid thus creating a macro grid of steady power supply for Akwa Ibom State and Calabar part of Cross River State • Within first 100 days, stabilized technical and commercial operations — increased available capacity from barely 37MW to 115MW • Secured expansion license from 191MW to 685MW through collaborative leadership and negotiations • Completed and configured the second of three units, increasing available capacity to 153MW • Made financial returns to the state government in addition to paying preexisting debts 2012 – 2014 Senior Special Assistant to the Governor on Power Akwa Ibom State Government — Nigeria Recruited from the USA to assist the State Governor on power sector policy, managing 25 direct reports and leading a large inter-ministerial team. • Established the Power Sector Unit — managed over $100M in cumulative investments in electric power distribution infrastructure • Directed state involvement and investment in the $2B+ Federal Government power distribution privatization process • Achieved 50% reduction in vandalism of power equipment through community partnerships • Achieved 40% reliability improvement through staff training and power outage monitoring • Steered development of Akwa Ibom State Macro-grid with Mini-grids and Pico-grids 2009 – 2012 Manager, Public Policy Research & Development Pepco Holdings, Inc. (now part of Exelon) — Washington, DC Mid-Atlantic transmission and distribution energy firm with over $8B in annual revenues and 4,500 employees. • Led development and management of public policy initiatives • Facilitated public policy positions on climate change, offshore wind, electric vehicles, renewable portfolio standards • Summarized top anticipated public policy issues monthly for the Chairman/CEO and C-Suite Executives • Led a collaborative partnership with University of Delaware, PJM on Vehicle-to-Grid (V2G) participation • Appointed Member, New Castle County Planning Board by County Executive (now US Senator Chris Coons) 2006 – 2009 Manager, Enterprise Risk Governance & Policy Pepco Holdings, Inc. — Washington, DC Collaborated on enterprise risk management policy and supported senior executives in managing the liquidity crisis of 2008. • Supported the Chief Risk Officer and senior executives in managing the liquidity crisis of 2008 • Strategic decision to divest $1.7B energy commodity business • Ensured key credit, market, liquidity, and business risk exposures were identified and reported to the Executive Team and Board • Successfully institutionalized Enterprise Risk Management (ERM) across the Fortune 500 energy company Education Academic Credentials PhD — Urban Affairs and Public Policy University of Delaware Concentration: Governance, Planning and Management of Society, Technology and Environment. Dissertation: 'Exploring Patterns of Sustainable Development, Governance and E-Infrastructure Capacities of Nations for Global Equity Praxis' (Ranked 132 countries on governance, environmental, social, and technological sustainability across 60+ variables.) Download Dissertation (DOCX) Download Defense Presentation (PDF) MSc — Energy Management and Environmental Policy University of Pennsylvania Trans-disciplinary education on the issues of energy, economics, and the environment. ME — Electrical Engineering Howard University Thesis: 'Adaptive Hierarchical Control for Large-Scale Interconnected Systems' BSEE — Power Systems Analysis, Design, Simulations & Evaluation Howard University Electricity generation, transmission, distribution, and utilization (load, reliability, quality, and costs) Executive Training: • Harvard University — Negotiations for Senior Executives • Paradigm Group — Enterprise-wide Energy Risk Management • University of Idaho — Public Utilities Executives' Course Purpose His Aspiration Victor's relentless passion is to serve the risen Lord Jesus, the Christ of God and humanity. He leverages his background in engineering, public policy, sustainable development, and Fortune 500 energy corporations' leadership to impact society, technology and the environment - people, planet, peace, progress and profit. This work is delivered through scholarship, research, operations, administration, community leadership and AI development. His focus areas include: • AI Products Development — SAIGE, RelTwin, ReachSMS and PressAI • Community and Nation Building — Abasi People Nationality in Nigeria: Ibibio, Annang, Efik, Oro, Ekoi, Ekid and Obolo • Energy Systems Decarbonization — storage, waste to energy, electrification of transportation and buildings, and nature-based solutions • People, Process, and Technology (PPT) — assets decentralization using digitalization with IoT, Blockchain, and AI in buildings and facilities management for safety, sustainability, resilience, and cost savings • Provision of Living-Learning Opportunities for the new generation of global sustainability and ESG leaders in academia, business and community Recognition Awards, Fellowships & Professional Affiliations Awards & Fellowships • Smart Energy Decisions DEI Impact Award — Inaugural recipient at the Net Zero Forum, September 2022. Presented by Smart Energy Decisions at the Hilton to recognize outstanding contributions to diversity, equity, and inclusion in the energy sector. • Fellow of the Nigerian Society of Engineers (FNSE) — Highest engineering recognition in Nigeria, 2016 • Recipient, Award for Distinguished Professional Contributions to Public Service, Nigeria, 2018 • Honored as Fellow, Institute of Corporate Administration, Nigeria, 2018 • Letters of Commendation from Governor Ruth Miner of Delaware and Wilmington City Council • Obama Organizing Fellow, Delaware for Obama — 2008 Presidential Campaign Professional Affiliations & Board Roles • Advisory Council Member, Association for the Advancement of Sustainability in Higher Education (AASHE) • Co-Chair, Diversity, Equity and Justice Working Group — Sustainable Development Solutions Network (SDSN) • Advisory Board Member, Smart Energy Decisions • Board of Advisors, Retrolux Inc., Boise, Idaho • General Connectional Board Member, CME Church (over 1,000 congregations in USA and Africa) • Board Member, Collins Chapel Hospital, Memphis, TN • Board Member, Delaware People to People • Member, Advisory Board of Electrical Engineering at Rowan University, New Jersey • Chairman, Energy, Environment & Engineering Network — New Jersey Technology Council (NJTC) • Member, International Scientific Committee on Energy & Environment, USA • Member, Institute of Electrical and Electronic Engineers (IEEE) • Member, Association of Energy Engineers • Member, New Castle County Planning Board (appointed by now US Senator Chris Coons) Senator Coons' 2017 Speech in Lagos, Nigeria — U.S.-Africa Relationship August 2017 — Congressional delegation visit to Nigeria, Lagos speech on the deep and lasting US-Africa relationship Read at Council on Foreign Relations • Member, New Jersey Governor's Renewable Energy Taskforce • SESP Consultant — New Jersey Board of Public Utilities / Rowan University ECE Department, 2023–2025 • Member, Community Advisory Board, The News Journal (largest newspaper in Delaware) • Member, CEOs Monthly Meeting with the Minister of Power, Nigeria • Member, CEOs Roundtable with the Nigerian Electricity Regulatory Commission (NERC) Nigerian Press Coverage (2012–2019) Dr. Victor Udo's public service leadership in Akwa Ibom State (2012–2019) was extensively covered by Nigerian press including The Nigerian Voice , Business Day Nigeria , The Ibom Pulpit , IbomPower News , and others. View Full Press Archive External Profiles & Research NJSESP Consultant Profile — State Energy Security Planning ResearchGate Profile — Peer-reviewed Publications, 687+ Citations SDSN USA Profile — Sustainable Development Solutions Network Bucknell University Faculty Page Afri Decarbonization Corporation — Executive Profile Journey A Career Built Across Sectors and Continents 1986 Arrived in the USA Began his career in engineering and energy in the United States, starting at Miles College in Birmingham, Alabama, before pursuing graduate education at Howard University — building deep expertise in engineering, energy, and sustainable development over 25+ years. 1986–2012 American Executive Career 25+ years of progressive leadership across energy, utilities, risk management, and public policy at Pepco Holdings, Atlantic Electric, and other Fortune 500 companies. Managed a $2B risk portfolio and led utility transformation initiatives. 2011 Returned to Nigeria to Serve Left corporate America to serve his people in Nigeria — engaged in national development, university administration, government relations, and community leadership for 7+ years. 2012–2019 Nigerian Government & Power Sector Leadership Served as Senior Special Assistant to the Governor on Power and Planning, transformed Ibom Power Company as CEO, and established state-wide sustainable development planning aligned with the UN SDGs. 2019 Returned to the USA Returned with a deepened mission: to apply 25+ years of executive experience to AI platforms, nature-based decarbonization, academic leadership, and community empowerment. 2020–Present Current Leadership Era Founding Abasi People Foundation, Chairman of Bucknell's Sustainability Council, CEO of Afri Decarbonization Corporation, and Founder of VEU AI Studio. Victor Udo, FNSE, PhD Engineer · Executive · AI Builder · Author · Community Leader Founder, VEU AI Studio · Chairman/CEO, Afri Decarbonization Corporation · Founding Chairman/President/CEO, Abasi People Foundation · Former Director of Sustainability & Chairman, President's Sustainability Council — Bucknell University (2019–2025) Quick Links Home About Blog & Insights Books Speaking News Gallery Publications Contact Platforms & Organizations VEU AI Studio SAIGE Demo Afri Decarbonization Corp Abasi People Foundation Abasi People Forum Podcast The Podium of Leadership (The POL) with Victor Udo Connect Victor.Udo@VEUAIStudio.Com +1 302 898 9542 LinkedIn Bucknell University Former Director of Sustainability & Chairman, President's Sustainability Council (2019–2025) Lewisburg, Pennsylvania #25 Top 50 Green Universities, USA (2022–23) ~30% carbon footprint reduction achieved © 2026 Victor Udo, FNSE, PhD. All rights reserved. ↑ Back to top","contentTruncated":{"html":false,"bodyText":false,"maxStoredHtmlBytes":250000,"maxStoredBodyTextBytes":50000},"contentLength":97579,"findings":[]},{"url":"https://victorudo.com/veu-ai-studio","depth":1,"status":"fetched","method":"browserless","httpStatus":null,"title":"VEU AI Studio | Agentic AI Platforms Built to Support Human Decision-Making","html":"<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/754a2285a_VEULinkedINPic.jpg\" rel=\"icon\" type=\"image/jpeg\">\n  <meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n  <!-- Performance: Preconnect & DNS Prefetch -->\n  <link href=\"https://fonts.googleapis.com\" rel=\"preconnect\">\n  <link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\">\n  <link href=\"https://media.base44.com\" rel=\"dns-prefetch\">\n  <link href=\"https://www.google-analytics.com\" rel=\"dns-prefetch\">\n  <!-- Google Site Verification -->\n  <meta content=\"UPQLHTlymB5ijLSuhYAcOykBAhG7gB6gbBpg6n10KTA\" name=\"google-site-verification\">\n  <!-- Sitemap Discovery -->\n  <link href=\"https://victorudo.com/sitemap\" rel=\"sitemap\" type=\"application/xml\">\n  <!-- Primary Meta Tags -->\n  <title>VEU AI Studio | Agentic AI Platforms Built to Support Human Decision-Making</title>\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"title\">\n  <meta content=\"VEU AI Studio (Dr. Victor Udo, Founder): AI platforms for ESG, sustainability governance, and enterprise decision intelligence. SAIGE (ESG/SDGs/EHS/CSR), RelTwin (leadership intelligence), ReachSMS (community AI), PressAI (knowledge sharing). Real-world decision intelligence for organizations and leadership.\" name=\"description\">\n  <meta content=\"Victor Udo, VEU AI Studio, SAIGE, sustainability, ESG, decarbonization, AI, Abasi Nation, Ibibio, Annang, Efik, Oro, Ekoi, Ekid, Obolo, Ndito Abasi, Abasians, Abasi People Foundation, Afri Decarbonization, carbon neutrality, Nigeria, Akwa Ibom, Bucknell University\" name=\"keywords\">\n  <meta content=\"Victor Udo, FNSE, PhD\" name=\"author\">\n  <meta content=\"index, follow\" name=\"robots\">\n  <!-- Open Graph / Facebook -->\n  <meta content=\"website\" property=\"og:type\">\n  <meta content=\"https://victorudo.com/veu-ai-studio\" property=\"og:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" property=\"og:title\">\n  <meta content=\"profile\" property=\"og:type\">\n  <meta content=\"Founder of VEU AI Studio, Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation uniting Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo as Abasi Nation.\" property=\"og:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" property=\"og:image\">\n  <meta content=\"1200\" property=\"og:image:width\">\n  <meta content=\"630\" property=\"og:image:height\">\n  <meta content=\"Dr. Victor Udo\" property=\"og:site_name\">\n  <meta content=\"en_US\" property=\"og:locale\">\n  <!-- Twitter Card -->\n  <meta content=\"summary_large_image\" name=\"twitter:card\">\n  <meta content=\"https://victorudo.com/veu-ai-studio\" name=\"twitter:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"twitter:title\">\n  <meta content=\"Founder of VEU AI Studio (SAIGE, RelTwin), Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation.\" name=\"twitter:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" name=\"twitter:image\">\n  <!-- Structured Data: Person -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Person\",\n      \"name\": \"Victor Udo\",\n      \"honorificSuffix\": \"FNSE, PhD\",\n      \"jobTitle\": \"AI Platform Builder, Decarbonization Champion\",\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victorudo\",\n        \"https://www.researchgate.net/profile/Victor-Udo\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"knowsAbout\": [\"Decarbonization\", \"AI Platforms\", \"ESG\", \"Sustainability Leadership\", \"Electric Power Systems\", \"Carbon Markets\", \"Public Policy\", \"Abasi Nation\"],\n      \"alumniOf\": [\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Delaware\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Pennsylvania\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"Howard University\" }\n      ],\n      \"worksFor\": [\n        { \"@type\": \"Organization\", \"name\": \"VEU AI Studio\", \"url\": \"https://veuaistudio.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Afri Decarbonization Corporation\", \"url\": \"https://afridecarbonization.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Abasi People Foundation\", \"url\": \"https://abasipeople.org\" }\n      ],\n      \"knowsAbout\": [\"Artificial Intelligence\", \"Sustainability\", \"ESG\", \"Decarbonization\", \"Energy Systems\", \"Carbon Markets\", \"Abasi Nation\", \"Public Policy\", \"Corporate Governance\"]\n    }\n  </script>\n  <!-- Structured Data: Organization (VEU AI Studio) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Organization\",\n      \"name\": \"VEU AI Studio\",\n      \"url\": \"https://veuaistudio.com\",\n      \"founder\": { \"@type\": \"Person\", \"name\": \"Victor Udo, FNSE, PhD\" },\n      \"description\": \"Agentic AI platforms for real-world decision intelligence — SAIGE (ESG/SDGs), RelTwin, ReachSMS, and PressAI.\",\n      \"sameAs\": [\"https://veuaistudio.com\"]\n    }\n  </script>\n  <!-- Structured Data: WebSite with SearchAction (enables Google Sitelinks Search Box) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebSite\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"url\": \"https://victorudo.com\",\n      \"description\": \"Official website of Victor Udo, FNSE, PhD — AI Builder, Sustainability Leader, and Abasi Foundation Leader.\",\n      \"potentialAction\": {\n        \"@type\": \"SearchAction\",\n        \"target\": {\n          \"@type\": \"EntryPoint\",\n          \"urlTemplate\": \"https://victorudo.com/news?q={search_term_string}\"\n        },\n        \"query-input\": \"required name=search_term_string\"\n      }\n    }\n  </script>\n  <!-- Structured Data: FAQ (common searches about Victor Udo) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Who is Dr. Victor Udo?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is an AI platform builder, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is SAIGE by VEU AI Studio?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"SAIGE is an agentic AI platform for enterprise decision intelligence on ESG, SDGs, EHS, CSR, and sustainability governance. It provides real-time analytics and impact assessment for organizations managing sustainability targets and carbon neutrality goals.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Abasi People Foundation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The Abasi People Foundation, founded by Dr. Victor Udo, is a movement uniting seven peoples — Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo — as Abasi Nation, the 4th largest ethnic nationality in Nigeria with vision for sustainable development and unity.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is Afri Decarbonization Corporation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Afri Decarbonization Corporation (ADC), led by Victor Udo, FNSE, PhD as Chairman/CEO, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What topics does Dr. Victor Udo speak on?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD speaks on AI for enterprise decisions, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How can I book Dr. Victor Udo for a speaking engagement?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Use the contact form at victorudo.com/contact and select 'Speaking Engagement' as the inquiry type. Provide event details, audience size, and preferred topics. Victor Udo, FNSE, PhD personally reviews all speaking requests and responds within 48 hours.\" } as the inquiry type. Provide event details, audience size, and preferred topics. Dr. Udo personally reviews all speaking requests and responds within 48 hours.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What are Dr. Victor Udo's published books?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is author of 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" } 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Bucknell Carbon Neutrality initiative?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"As Director of Sustainability at Bucknell University, Victor Udo, FNSE, PhD led the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" } the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" }\n        }\n      ]\n    }\n  </script>\n  <!-- Structured Data: LocalBusiness (Lewisburg Office) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"description\": \"AI platform builder, sustainability executive, and community leader. Consulting and advisory services for ESG, decarbonization, and enterprise AI decision intelligence.\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Lewisburg\",\n        \"addressRegion\": \"PA\",\n        \"postalCode\": \"17837\",\n        \"addressCountry\": \"US\"\n      },\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"telephone\": \"+1-570-577-1234\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victor-udo/\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"knowsAbout\": [\n        \"Artificial Intelligence\",\n        \"Enterprise AI\",\n        \"Sustainability\",\n        \"ESG Governance\",\n        \"Decarbonization\",\n        \"Carbon Markets\",\n        \"Energy Transition\",\n        \"Corporate Leadership\",\n        \"Public Policy\",\n        \"African Development\"\n      ]\n    }\n  </script>\n  <!-- Structured Data: ProfessionalService (Consulting & Advisory) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ProfessionalService\",\n      \"name\": \"Victor Udo, FNSE, PhD — Sustainability & AI Consulting\",\n      \"provider\": {\n        \"@type\": \"Person\",\n        \"name\": \"Victor Udo\",\n        \"honorificSuffix\": \"FNSE, PhD\",\n        \"email\": \"info@victorudo.com\",\n        \"url\": \"https://victorudo.com\"\n      },\n      \"serviceType\": [\"Advisory Services\", \"Strategic Consulting\", \"ESG Governance\", \"Sustainability Leadership\", \"Enterprise AI Decision Intelligence\"],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"description\": \"Executive advisory and strategic consulting services for organizations pursuing carbon neutrality, ESG excellence, and AI-enabled decision intelligence.\"\n    }\n  </script>\n  <script crossorigin=\"\" src=\"/assets/index-R2wm1Vio.js\" type=\"module\">\n  </script>\n  <link crossorigin=\"\" href=\"/assets/index-DUFtFU2C.css\" rel=\"stylesheet\">\n  <script type=\"module\">\n   if (window.self === window.top) {\n  let lastPath = \"\";\n  function getPageNameFromPath(path) {\n    const segments = path.split(\"/\").filter(Boolean);\n    return segments[0] || null;\n  }\n  function trackPageView() {\n    const path = window.location.pathname;\n    if (path === lastPath) return;\n    lastPath = path;\n    const pageName = getPageNameFromPath(path) || \"home\";\n    const appId = \"69cae26d57b5c4bdd91128cf\";\n    if (!appId) return;\n    fetch(`/api/app-logs/${appId}/log-user-in-app/${pageName}`, {\n      method: \"POST\",\n    }).catch(() => {});\n  }\n  const originalPushState = history.pushState.bind(history);\n  history.pushState = function (...args) {\n    originalPushState(...args);\n    trackPageView();\n  };\n  const originalReplaceState = history.replaceState.bind(history);\n  history.replaceState = function (...args) {\n    originalReplaceState(...args);\n    trackPageView();\n  };\n  window.addEventListener(\"popstate\", trackPageView);\n  trackPageView();\n}\n  </script>\n  <meta content=\"yes\" name=\"mobile-web-app-capable\">\n  <meta content=\"black\" name=\"apple-mobile-web-app-status-bar-style\">\n  <meta content=\"VictorUdo.Com\" name=\"apple-mobile-web-app-title\">\n  <link href=\"https://victorudo.com/veu-ai-studio\" rel=\"canonical\">\n  <script data-seo-source=\"builder\" type=\"application/ld+json\">\n   {\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://victorudo.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"veu ai studio\", \"item\": \"https://victorudo.com/veu-ai-studio\"}]}\n  </script>\n <script type=\"application/ld+json\" data-schema=\"breadcrumb-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorudo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"VEU AI Studio\",\"item\":\"https://victorudo.com/veu-ai-studio\"}]}</script><script type=\"application/ld+json\" data-schema=\"webpage-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"VEU AI Studio — Agentic AI Platforms\",\"description\":\"VEU AI Studio builds four agentic AI platforms: SAIGE, RelTwin, ReachSMS, and PressAI — for enterprise impact, sustainability intelligence, and decision-making.\",\"url\":\"https://victorudo.com/veu-ai-studio\",\"isPartOf\":{\"@type\":\"WebSite\",\"url\":\"https://victorudo.com\",\"name\":\"Dr. Victor Udo\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorudo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"VEU AI Studio\",\"item\":\"https://victorudo.com/veu-ai-studio\"}]}}</script><script type=\"application/ld+json\" data-schema=\"faq-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is SAIGE?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"SAIGE is an enterprise AI platform for ESG, SDGs, EHS, CSR, and Sustainability governance. It introduces Enterprise Impact Performance (EIP) — a unified AI intelligence layer for real-time decision-making.\"}},{\"@type\":\"Question\",\"name\":\"What is RelTwin?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"RelTwin is a relationship intelligence platform using Relationship Digital Twins (RDT) to improve organizational leadership, communication, and team performance.\"}},{\"@type\":\"Question\",\"name\":\"What is VEU AI Studio?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"VEU AI Studio, founded by Dr. Victor Udo, builds agentic AI platforms — SAIGE, RelTwin, ReachSMS, and PressAI — that help organizations move from information to knowledge to decisions to measurable impact.\"}}]}</script></head>\n <body>\n  <div id=\"root\"><div class=\"min-h-screen flex flex-col\"><div class=\"fixed top-0 left-0 right-0 z-50\"><nav class=\"transition-all duration-500 bg-primary\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"flex items-center justify-between h-16 lg:h-20\"><a class=\"flex-shrink-0\" href=\"/\"><div class=\"text-white\"><div class=\"font-heading text-lg lg:text-xl font-bold leading-tight\">Dr. Victor Udo</div><div class=\"text-white/60 text-[10px] tracking-wide hidden sm:block whitespace-nowrap\">Executive · AI Builder · Author · Community Leader</div></div></a><div class=\"hidden lg:flex items-center gap-1\"><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/\">Home</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/about\">About</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white bg-white/15\" aria-current=\"page\" href=\"/veu-ai-studio\">VEU AI Studio</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/abasi-people\">Abasi People</a><div class=\"absolute left-0 mt-0 w-52 bg-primary border border-white/20 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50\"><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-colors\" href=\"/abasi-people\">Abasi People Foundation</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-colors\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></div></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/speaking\">Speaking</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/publications\">Publications</a></div><div class=\"relative group\"><a class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap text-white/75 hover:text-white hover:bg-white/10\" href=\"/contact\">Contact</a></div><a title=\"Carbon Footprint Calculator\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/carbon-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf h-4 w-4\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg></a><a title=\"Dr. Udo's Banner &amp; Profile Summary\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\" href=\"/linkedin-banner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-square-user-round h-4 w-4\"><path d=\"M18 21a6 6 0 0 0-12 0\"></path><circle cx=\"12\" cy=\"11\" r=\"4\"></circle><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"></rect></svg></a><div class=\"relative hidden xl:block\"><button title=\"Search books, news...\" class=\"px-2 py-1.5 rounded-md text-white/70 hover:text-white hover:bg-white/10 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search h-4 w-4\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></button></div><div class=\"relative group\"><button class=\"px-2.5 py-1.5 text-xs sm:text-sm font-medium rounded-md transition-colors text-white/75 hover:text-white hover:bg-white/10\" aria-expanded=\"false\" aria-haspopup=\"menu\">More ▾</button><div class=\"absolute right-0 mt-0 w-52 bg-primary border border-white/20 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50\"><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/blog\">Blog &amp; Insights</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/carbon-calculator\">Carbon Calculator</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/afri-decarbonization\">Afri Decarbonization</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/advisory\">Advisory Services</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/news\">News</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/gallery\">Gallery</a><a class=\"block px-4 py-2.5 text-xs sm:text-sm font-medium transition-colors text-white/75 hover:text-white hover:bg-white/10\" href=\"/mothers-memorial\">Mother's Memorial</a></div></div></div><div class=\"flex items-center gap-3\"><a href=\"/contact\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold text-xs sm:text-sm px-4 sm:px-6 h-9 sm:h-10 rounded-lg shadow-md\">Work With Victor</button></a><button class=\"lg:hidden text-white p-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></div></nav></div><div class=\"fixed top-16 lg:top-20 left-0 right-0 z-40 bg-accent text-accent-foreground flex items-center justify-center py-1.5 px-8\"><a class=\"text-xs font-semibold hover:underline flex-1 text-center\" href=\"/linkedin-banner\">View Dr. Udo's Profile &amp; Banner Summary →</a><button class=\"absolute right-3 text-accent-foreground/70 hover:text-accent-foreground text-base leading-none\" aria-label=\"Dismiss\">×</button></div><main class=\"flex-1 pt-24 lg:pt-28 transition-all duration-300\"><div><div class=\"relative bg-primary text-white py-20 lg:py-28 overflow-hidden\"><div class=\"absolute inset-0 pointer-events-none\" aria-hidden=\"true\"><div class=\"absolute -top-32 -right-32 w-96 h-96 rounded-full bg-white/[0.03]\"></div><div class=\"absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-accent/[0.07]\"></div></div><div class=\"relative max-w-[1200px] mx-auto px-4 sm:px-6 text-center\"><h1 class=\"font-heading text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight\">VEU AI Studio</h1><p class=\"text-white/70 text-lg lg:text-xl max-w-3xl mx-auto leading-relaxed\">Agentic AI Platforms Built to Support Human Decision-Making and Real-World Impact</p></div></div><div class=\"bg-primary/5 border-t border-primary/10 border-b py-4\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 text-center\"><p class=\"text-lg font-bold text-primary\">Intelligent Platforms Built for Real Work</p></div></div><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"max-w-3xl mx-auto\"><div class=\"bg-card rounded-lg p-8 md:p-10 shadow-sm border border-border/50 relative\"><div class=\"text-6xl text-accent/20 font-heading absolute top-4 left-6\">\"</div><div class=\"relative space-y-4 text-muted-foreground leading-relaxed pl-4\"><p>I founded VEU AI Studio to build AI platforms that solve real problems for real organizations. After 25+ years watching enterprises struggle to translate information into action — across energy, sustainability, government, and community development — I set out to create a new class of decision intelligence tools grounded in governance, sustainability, and human impact.</p><p>Every platform we build follows one principle: take organizations from information to knowledge to decisions to measurable real-world impact.</p></div><p class=\"mt-6 font-semibold text-foreground text-sm pl-4\">— Victor Udo, PhD, FNSE | Founder, VEU AI Studio</p></div></div></div></section><section class=\"bg-secondary py-14 lg:py-16\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"flex items-center justify-center gap-3 md:gap-6 flex-wrap\"><div class=\"flex items-center gap-3 md:gap-6\"><span class=\"bg-primary text-primary-foreground px-5 py-3 rounded-lg font-semibold text-sm md:text-base shadow-sm\">Information</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-3 md:gap-6\"><span class=\"bg-primary text-primary-foreground px-5 py-3 rounded-lg font-semibold text-sm md:text-base shadow-sm\">Knowledge</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-3 md:gap-6\"><span class=\"bg-primary text-primary-foreground px-5 py-3 rounded-lg font-semibold text-sm md:text-base shadow-sm\">Decisions</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 text-accent hidden sm:block\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><div class=\"flex items-center gap-3 md:gap-6\"><span class=\"bg-primary text-primary-foreground px-5 py-3 rounded-lg font-semibold text-sm md:text-base shadow-sm\">Impact</span></div></div></div></section><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12 lg:mb-16\" style=\"opacity: 0;\"><span class=\"eyebrow  mb-3 block\" style=\"opacity: 0; transform: translateY(15px);\">Platforms</span><h2 class=\"font-heading text-3xl md:text-4xl lg:text-[42px] font-bold leading-tight text-foreground\" style=\"opacity: 0; transform: translateY(15px);\">Four AI Platforms for Organizational and Personal Impacts</h2></div><div class=\"grid md:grid-cols-2 gap-6 mb-14\"><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">SAIGE</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">SAIGE is an enterprise AI platform for ESG, SDGs, EHS, CSR, and Sustainability governance. It introduces Enterprise Impact Performance (EIP) — a unified AI intelligence layer helping school districts, universities, governments, businesses, agencies, and NGOs understand their full enterprise impact. Features: AI-surfaced insights, unified EIP score, role-based context, scenario modelling, interactive dashboards, report generator, and justification kit.</p><div class=\"flex flex-wrap gap-4\"><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Register Interest <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">RelTwin</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Relationship intelligence platform using Relationship Digital Twins (RDT) to improve organizational leadership, communication, and performance.</p><div class=\"flex flex-wrap gap-4\"><a href=\"https://reltwin.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">ReachSMS</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">SMS-first community management platform for online communities — enabling value exchange, services delivery, and community development for large or distributed member bases.</p><div class=\"flex flex-wrap gap-4\"><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div><div class=\"bg-card rounded-lg p-7 shadow-sm border border-border/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300\"><span class=\"inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 bg-blue-100 text-blue-800\">🔵 Launching Soon</span><h3 class=\"font-heading text-2xl font-bold text-foreground mb-3\">PressAI</h3><p class=\"text-sm text-muted-foreground leading-relaxed mb-5\">Virtual end-to-end publishing and knowledge-sharing infrastructure — amplifying underrepresented voices through AI-powered content creation, editorial management, and distribution.</p><div class=\"flex flex-wrap gap-4\"><a href=\"https://ourpublishingai.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent font-semibold text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3.5 w-3.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></div><div class=\"bg-secondary rounded-lg p-8 md:p-10 text-center mb-14\"><h3 class=\"font-heading text-xl font-bold text-foreground mb-4\">Operating Model</h3><p class=\"text-sm text-muted-foreground leading-relaxed max-w-3xl mx-auto mb-6\">VEU AI Studio works with a focused group of operating partners responsible for product execution, commercialization, and enterprise deployment. We are selectively engaging partners with experience in Platform development, enterprise sales, and domain-specific implementation.</p><a href=\"https://veuaistudio.com/#contact\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 py-2 bg-accent hover:bg-accent/90 text-accent-foreground font-semibold px-8 h-12 text-base rounded-lg shadow-md\">Partner With VEU AI Studio <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div><div class=\"mt-16 pt-12 border-t border-border\"><h3 class=\"font-heading text-lg font-bold text-foreground mb-6\">Learn More</h3><div class=\"grid sm:grid-cols-2 md:grid-cols-3 gap-4\"><a class=\"group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-all\" href=\"/about\"><span class=\"text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex-1\">About Dr. Victor Udo</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-all\" href=\"/afri-decarbonization\"><span class=\"text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex-1\">Afri Decarbonization</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-all\" href=\"/publications\"><span class=\"text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex-1\">Publications &amp; Research</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-all\" href=\"/advisory\"><span class=\"text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex-1\">Advisory Services</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-all\" href=\"/speaking\"><span class=\"text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex-1\">Speaking Engagements</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors group-hover:translate-x-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section></div></main><footer class=\"bg-primary text-white\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-16 lg:py-20\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><h3 class=\"font-heading text-xl font-bold mb-1\">Victor Udo, FNSE, PhD</h3><p class=\"text-white/60 text-xs leading-relaxed mb-4\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Engineer</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Executive</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">AI Builder</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/publications\">Author</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Community Leader</a></p><p class=\"text-white/50 text-xs leading-relaxed\"><a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/veu-ai-studio\">Founder, VEU AI Studio</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/afri-decarbonization\">Chairman/CEO, Afri Decarbonization Corporation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/abasi-people\">Founding Chairman/President/CEO, Abasi People Foundation</a> · <a class=\"underline decoration-white/30 hover:text-white hover:decoration-white transition-colors\" href=\"/about\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council — Bucknell University (2019–2025)</a></p></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Quick Links</h4><ul class=\"space-y-2\"><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/\">Home</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/about\">About</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/blog\">Blog &amp; Insights</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Books</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/speaking\">Speaking</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/news\">News</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/gallery\">Gallery</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/publications\">Publications</a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors\" href=\"/contact\">Contact</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Platforms &amp; Organizations</h4><ul class=\"space-y-2\"><li><a href=\"https://veuaistudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">VEU AI Studio<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://saigedemo.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">SAIGE Demo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://afridecarbonization.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Afri Decarbonization Corp<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a href=\"https://abasipeople.org\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">Abasi People Foundation<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li><li><a class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\" href=\"/abasi-people-forum-podcast\">Abasi People Forum Podcast</a></li><li><a href=\"https://anchor.fm/sustainability-leadership\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-1\">The Podium of Leadership (The POL) with Victor Udo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-2.5 w-2.5\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Connect</h4><ul class=\"space-y-3\"><li><a href=\"mailto:Victor.Udo@VEUAIStudio.Com\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-3.5 w-3.5\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg> Victor.Udo@VEUAIStudio.Com</a></li><li><a href=\"tel:+13028989542\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-3.5 w-3.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> +1 302 898 9542</a></li><li><a href=\"https://www.linkedin.com/in/victor-udo/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/50 hover:text-white text-xs transition-colors inline-flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-linkedin h-3.5 w-3.5\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg> LinkedIn</a></li></ul></div><div><h4 class=\"text-sm font-semibold mb-4 text-white/90\">Bucknell University</h4><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Former Director of Sustainability &amp; Chairman, President's Sustainability Council (2019–2025)</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">Lewisburg, Pennsylvania</p><p class=\"text-white/50 text-xs leading-relaxed mb-2\">#25 Top 50 Green Universities, USA (2022–23)</p><p class=\"text-white/50 text-xs leading-relaxed\">~30% carbon footprint reduction achieved</p></div></div></div><div class=\"border-t border-white/10\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3\"><p class=\"text-white/40 text-xs\">© 2026 Victor Udo, FNSE, PhD. All rights reserved.</p><button class=\"text-white/40 hover:text-white text-xs flex items-center gap-1.5 transition-colors group\" aria-label=\"Back to top\">↑ Back to top</button></div></div></footer></div><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"><div class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></div></div></div>\n \n\n</body></html>\n","bodyText":"VEU AI Studio | Agentic AI Platforms Built to Support Human Decision-Making Dr. Victor Udo Executive · AI Builder · Author · Community Leader Home About VEU AI Studio Abasi People Abasi People Foundation Abasi People Forum Podcast Speaking Publications Contact More ▾ Blog & Insights Carbon Calculator Afri Decarbonization Advisory Services News Gallery Mother's Memorial Work With Victor View Dr. Udo's Profile & Banner Summary → × VEU AI Studio Agentic AI Platforms Built to Support Human Decision-Making and Real-World Impact Intelligent Platforms Built for Real Work \" I founded VEU AI Studio to build AI platforms that solve real problems for real organizations. After 25+ years watching enterprises struggle to translate information into action — across energy, sustainability, government, and community development — I set out to create a new class of decision intelligence tools grounded in governance, sustainability, and human impact. Every platform we build follows one principle: take organizations from information to knowledge to decisions to measurable real-world impact. — Victor Udo, PhD, FNSE | Founder, VEU AI Studio Information Knowledge Decisions Impact Platforms Four AI Platforms for Organizational and Personal Impacts 🔵 Launching Soon SAIGE SAIGE is an enterprise AI platform for ESG, SDGs, EHS, CSR, and Sustainability governance. It introduces Enterprise Impact Performance (EIP) — a unified AI intelligence layer helping school districts, universities, governments, businesses, agencies, and NGOs understand their full enterprise impact. Features: AI-surfaced insights, unified EIP score, role-based context, scenario modelling, interactive dashboards, report generator, and justification kit. Learn More Register Interest 🔵 Launching Soon RelTwin Relationship intelligence platform using Relationship Digital Twins (RDT) to improve organizational leadership, communication, and performance. Learn More 🔵 Launching Soon ReachSMS SMS-first community management platform for online communities — enabling value exchange, services delivery, and community development for large or distributed member bases. Learn More 🔵 Launching Soon PressAI Virtual end-to-end publishing and knowledge-sharing infrastructure — amplifying underrepresented voices through AI-powered content creation, editorial management, and distribution. Learn More Operating Model VEU AI Studio works with a focused group of operating partners responsible for product execution, commercialization, and enterprise deployment. We are selectively engaging partners with experience in Platform development, enterprise sales, and domain-specific implementation. Partner With VEU AI Studio Learn More About Dr. Victor Udo Afri Decarbonization Publications & Research Advisory Services Speaking Engagements Victor Udo, FNSE, PhD Engineer · Executive · AI Builder · Author · Community Leader Founder, VEU AI Studio · Chairman/CEO, Afri Decarbonization Corporation · Founding Chairman/President/CEO, Abasi People Foundation · Former Director of Sustainability & Chairman, President's Sustainability Council — Bucknell University (2019–2025) Quick Links Home About Blog & Insights Books Speaking News Gallery Publications Contact Platforms & Organizations VEU AI Studio SAIGE Demo Afri Decarbonization Corp Abasi People Foundation Abasi People Forum Podcast The Podium of Leadership (The POL) with Victor Udo Connect Victor.Udo@VEUAIStudio.Com +1 302 898 9542 LinkedIn Bucknell University Former Director of Sustainability & Chairman, President's Sustainability Council (2019–2025) Lewisburg, Pennsylvania #25 Top 50 Green Universities, USA (2022–23) ~30% carbon footprint reduction achieved © 2026 Victor Udo, FNSE, PhD. All rights reserved. ↑ Back to top","contentTruncated":{"html":false,"bodyText":false,"maxStoredHtmlBytes":250000,"maxStoredBodyTextBytes":50000},"contentLength":49141,"findings":[]},{"url":"https://victorudo.com/abasi-people","depth":1,"status":"fetched","method":"browserless","httpStatus":null,"title":"Abasi People Foundation | Ibibio, Annang, Efik, Oro, Ekid, Ekoi, Obolo & Abasians","html":"<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/754a2285a_VEULinkedINPic.jpg\" rel=\"icon\" type=\"image/jpeg\">\n  <meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n  <!-- Performance: Preconnect & DNS Prefetch -->\n  <link href=\"https://fonts.googleapis.com\" rel=\"preconnect\">\n  <link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\">\n  <link href=\"https://media.base44.com\" rel=\"dns-prefetch\">\n  <link href=\"https://www.google-analytics.com\" rel=\"dns-prefetch\">\n  <!-- Google Site Verification -->\n  <meta content=\"UPQLHTlymB5ijLSuhYAcOykBAhG7gB6gbBpg6n10KTA\" name=\"google-site-verification\">\n  <!-- Sitemap Discovery -->\n  <link href=\"https://victorudo.com/sitemap\" rel=\"sitemap\" type=\"application/xml\">\n  <!-- Primary Meta Tags -->\n  <title>Abasi People Foundation | Ibibio, Annang, Efik, Oro, Ekid, Ekoi, Obolo &amp; Abasians</title>\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"title\">\n  <meta content=\"Abasi People Foundation &amp; Abasi Nation — uniting Ibibio, Annang, Efik, Oro, Ekid, Ekoi, Obolo (Ndito Abasi). Movement for cultural identity, self-determination, equitable development across Akwa Ibom, Cross River (Calabar, Uyo, Itu, Oron, Eket, Ibeno, Ikot Ekpene, Obot Akara), Nigeria &amp; diaspora. Founded by Dr. Victor Udo.\" name=\"description\">\n  <meta content=\"Abasi People, Abasi Nation, Ndito Abasi, Abasian, Ibibio, Annang, Efik, Oro, Ekoi, Ekid, Obolo, Akwa Ibom, Cross River, Calabar, Uyo, Itu, Oron, Eket, Ibeno, Ikot Ekpene, Obot Akara, ethnic identity, cultural movement, Nigeria indigenous peoples, Dr. Victor Udo\" name=\"keywords\">\n  <meta content=\"Victor Udo, FNSE, PhD\" name=\"author\">\n  <meta content=\"index, follow\" name=\"robots\">\n  <!-- Open Graph / Facebook -->\n  <meta content=\"website\" property=\"og:type\">\n  <meta content=\"https://victorudo.com/abasi-people\" property=\"og:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" property=\"og:title\">\n  <meta content=\"profile\" property=\"og:type\">\n  <meta content=\"Founder of VEU AI Studio, Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation uniting Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo as Abasi Nation.\" property=\"og:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" property=\"og:image\">\n  <meta content=\"1200\" property=\"og:image:width\">\n  <meta content=\"630\" property=\"og:image:height\">\n  <meta content=\"Dr. Victor Udo\" property=\"og:site_name\">\n  <meta content=\"en_US\" property=\"og:locale\">\n  <!-- Twitter Card -->\n  <meta content=\"summary_large_image\" name=\"twitter:card\">\n  <meta content=\"https://victorudo.com/abasi-people\" name=\"twitter:url\">\n  <meta content=\"Victor Udo, FNSE, PhD | AI Platform Builder · Sustainability Leader · Abasi Foundation Leader · Power Sector Executive\" name=\"twitter:title\">\n  <meta content=\"Founder of VEU AI Studio (SAIGE, RelTwin), Chairman/CEO of Afri Decarbonization Corporation, and Founding Chairman/President/CEO of the Abasi People Foundation.\" name=\"twitter:description\">\n  <meta content=\"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/79572d658_VEULinkedINPic.jpg/v1/fill/w_1200,h_630/79572d658_VEULinkedINPic.jpg\" name=\"twitter:image\">\n  <!-- Structured Data: Person -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Person\",\n      \"name\": \"Victor Udo\",\n      \"honorificSuffix\": \"FNSE, PhD\",\n      \"jobTitle\": \"AI Platform Builder, Decarbonization Champion\",\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victorudo\",\n        \"https://www.researchgate.net/profile/Victor-Udo\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"knowsAbout\": [\"Decarbonization\", \"AI Platforms\", \"ESG\", \"Sustainability Leadership\", \"Electric Power Systems\", \"Carbon Markets\", \"Public Policy\", \"Abasi Nation\"],\n      \"alumniOf\": [\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Delaware\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"University of Pennsylvania\" },\n        { \"@type\": \"CollegeOrUniversity\", \"name\": \"Howard University\" }\n      ],\n      \"worksFor\": [\n        { \"@type\": \"Organization\", \"name\": \"VEU AI Studio\", \"url\": \"https://veuaistudio.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Afri Decarbonization Corporation\", \"url\": \"https://afridecarbonization.com\" },\n        { \"@type\": \"Organization\", \"name\": \"Abasi People Foundation\", \"url\": \"https://abasipeople.org\" }\n      ],\n      \"knowsAbout\": [\"Artificial Intelligence\", \"Sustainability\", \"ESG\", \"Decarbonization\", \"Energy Systems\", \"Carbon Markets\", \"Abasi Nation\", \"Public Policy\", \"Corporate Governance\"]\n    }\n  </script>\n  <!-- Structured Data: Organization (VEU AI Studio) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Organization\",\n      \"name\": \"VEU AI Studio\",\n      \"url\": \"https://veuaistudio.com\",\n      \"founder\": { \"@type\": \"Person\", \"name\": \"Victor Udo, FNSE, PhD\" },\n      \"description\": \"Agentic AI platforms for real-world decision intelligence — SAIGE (ESG/SDGs), RelTwin, ReachSMS, and PressAI.\",\n      \"sameAs\": [\"https://veuaistudio.com\"]\n    }\n  </script>\n  <!-- Structured Data: WebSite with SearchAction (enables Google Sitelinks Search Box) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebSite\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"url\": \"https://victorudo.com\",\n      \"description\": \"Official website of Victor Udo, FNSE, PhD — AI Builder, Sustainability Leader, and Abasi Foundation Leader.\",\n      \"potentialAction\": {\n        \"@type\": \"SearchAction\",\n        \"target\": {\n          \"@type\": \"EntryPoint\",\n          \"urlTemplate\": \"https://victorudo.com/news?q={search_term_string}\"\n        },\n        \"query-input\": \"required name=search_term_string\"\n      }\n    }\n  </script>\n  <!-- Structured Data: FAQ (common searches about Victor Udo) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Who is Dr. Victor Udo?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is an AI platform builder, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }, sustainability executive, and community leader with 25+ years of experience in energy, ESG, and decarbonization. He is the Founder of VEU AI Studio (SAIGE, RelTwin, ReachSMS, PressAI), Chairman/CEO of Afri Decarbonization Corporation, and Founding President of the Abasi People Foundation.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is SAIGE by VEU AI Studio?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"SAIGE is an agentic AI platform for enterprise decision intelligence on ESG, SDGs, EHS, CSR, and sustainability governance. It provides real-time analytics and impact assessment for organizations managing sustainability targets and carbon neutrality goals.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Abasi People Foundation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The Abasi People Foundation, founded by Dr. Victor Udo, is a movement uniting seven peoples — Ibibio, Annang, Efik, Oro, Ekoi, Ekid, and Obolo — as Abasi Nation, the 4th largest ethnic nationality in Nigeria with vision for sustainable development and unity.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is Afri Decarbonization Corporation?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Afri Decarbonization Corporation (ADC), led by Victor Udo, FNSE, PhD as Chairman/CEO, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }, drives nature-based decarbonization and carbon market solutions across West Africa, with 1.6M hectare forest carbon sink MOU and regenerative agriculture initiatives.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What topics does Dr. Victor Udo speak on?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD speaks on AI for enterprise decisions, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }, sustainability leadership, ESG governance, nature-based decarbonization, energy transition, carbon neutrality in higher education, and African development. He has delivered keynotes at Fortune 500 companies, universities, and government forums.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How can I book Dr. Victor Udo for a speaking engagement?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Use the contact form at victorudo.com/contact and select 'Speaking Engagement' as the inquiry type. Provide event details, audience size, and preferred topics. Victor Udo, FNSE, PhD personally reviews all speaking requests and responds within 48 hours.\" } as the inquiry type. Provide event details, audience size, and preferred topics. Dr. Udo personally reviews all speaking requests and responds within 48 hours.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What are Dr. Victor Udo's published books?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Victor Udo, FNSE, PhD is author of 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" } 'Which Way Nigeria? Structure, Leadership & Sustainable Development' (Fulton Books, 2020), 'Sustainability Insights for Electric Power Sector Transformation', and 'Structural and Leadership Insights for National Sustainable Development'. Available on Amazon and major book retailers.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the Bucknell Carbon Neutrality initiative?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"As Director of Sustainability at Bucknell University, Victor Udo, FNSE, PhD led the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" } the university toward carbon neutrality by 2030, achieving ~30% carbon reduction and installing a 1.76 MW solar farm. The strategy integrates renewable energy, energy efficiency, and nature-based solutions.\" }\n        }\n      ]\n    }\n  </script>\n  <!-- Structured Data: LocalBusiness (Lewisburg Office) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Victor Udo, FNSE, PhD\",\n      \"image\": \"https://media.base44.com/images/public/69cae26d57b5c4bdd91128cf/889d7d086_hgj.jpg\",\n      \"description\": \"AI platform builder, sustainability executive, and community leader. Consulting and advisory services for ESG, decarbonization, and enterprise AI decision intelligence.\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Lewisburg\",\n        \"addressRegion\": \"PA\",\n        \"postalCode\": \"17837\",\n        \"addressCountry\": \"US\"\n      },\n      \"email\": \"info@victorudo.com\",\n      \"url\": \"https://victorudo.com\",\n      \"telephone\": \"+1-570-577-1234\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/in/victor-udo/\",\n        \"https://veuaistudio.com\",\n        \"https://afridecarbonization.com\",\n        \"https://abasipeople.org\"\n      ],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"knowsAbout\": [\n        \"Artificial Intelligence\",\n        \"Enterprise AI\",\n        \"Sustainability\",\n        \"ESG Governance\",\n        \"Decarbonization\",\n        \"Carbon Markets\",\n        \"Energy Transition\",\n        \"Corporate Leadership\",\n        \"Public Policy\",\n        \"African Development\"\n      ]\n    }\n  </script>\n  <!-- Structured Data: ProfessionalService (Consulting & Advisory) -->\n  <script type=\"application/ld+json\">\n   {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ProfessionalService\",\n      \"name\": \"Victor Udo, FNSE, PhD — Sustainability & AI Consulting\",\n      \"provider\": {\n        \"@type\": \"Person\",\n        \"name\": \"Victor Udo\",\n        \"honorificSuffix\": \"FNSE, PhD\",\n        \"email\": \"info@victorudo.com\",\n        \"url\": \"https://victorudo.com\"\n      },\n      \"serviceType\": [\"Advisory Services\", \"Strategic Consulting\", \"ESG Governance\", \"Sustainability Leadership\", \"Enterprise AI Decision Intelligence\"],\n      \"areaServed\": [\"US\", \"Nigeria\", \"West Africa\"],\n      \"description\": \"Executive advisory and strategic consulting services for organizations pursuing carbon neutrality, ESG excellence, and AI-enabled decision intelligence.\"\n    }\n  </script>\n  <script crossorigin=\"\" src=\"/assets/index-R2wm1Vio.js\" type=\"module\">\n  </script>\n  <link crossorigin=\"\" href=\"/assets/index-DUFtFU2C.css\" rel=\"stylesheet\">\n  <script type=\"module\">\n   if (window.self === window.top) {\n  let lastPath = \"\";\n  function getPageNameFromPath(path) {\n    const segments = path.split(\"/\").filter(Boolean);\n    return segments[0] || null;\n  }\n  function trackPageView() {\n    const path = window.location.pathname;\n    if (path === lastPath) return;\n    lastPath = path;\n    const pageName = getPageNameFromPath(path) || \"home\";\n    const appId = \"69cae26d57b5c4bdd91128cf\";\n    if (!appId) return;\n    fetch(`/api/app-logs/${appId}/log-user-in-app/${pageName}`, {\n      method: \"POST\",\n    }).catch(() => {});\n  }\n  const originalPushState = history.pushState.bind(history);\n  history.pushState = function (...args) {\n    originalPushState(...args);\n    trackPageView();\n  };\n  const originalReplaceState = history.replaceState.bind(history);\n  history.replaceState = function (...args) {\n    originalReplaceState(...args);\n    trackPageView();\n  };\n  window.addEventListener(\"popstate\", trackPageView);\n  trackPageView();\n}\n  </script>\n  <meta content=\"yes\" name=\"mobile-web-app-capable\">\n  <meta content=\"black\" name=\"apple-mobile-web-app-status-bar-style\">\n  <meta content=\"VictorUdo.Com\" name=\"apple-mobile-web-app-title\">\n  <link href=\"https://victorudo.com/abasi-people\" rel=\"canonical\">\n  <script data-seo-source=\"builder\" type=\"application/ld+json\">\n   {\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://victorudo.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"abasi people\", \"item\": \"https://victorudo.com/abasi-people\"}]}\n  </script>\n <script type=\"application/ld+json\" data-schema=\"breadcrumb-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://victorud