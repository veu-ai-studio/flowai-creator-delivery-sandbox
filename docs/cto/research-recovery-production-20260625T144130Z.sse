20 -left-20 w-64 h-64 rounded-full bg-accent/[0.07]\"></div></div><div class=\"relative max-w-[1200px] mx-auto px-4 sm:px-6 text-center\"><h1 class=\"font-heading text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight\">Get In Touch</h1><p class=\"text-white/70 text-lg lg:text-xl max-w-3xl mx-auto leading-relaxed\">Every message is read personally.</p></div></div><section class=\"py-20 lg:py-24 bg-background\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><p class=\"text-lg text-muted-foreground leading-relaxed max-w-3xl mx-auto text-center mb-16\">Whether you're exploring a partnership with VEU AI Studio, ADC nature-based projects, advisory or consulting support, inviting Victor to speak, connecting with the Abasi People Foundation, or reaching out about a book — every message receives a personal response.</p><div class=\"grid lg:grid-cols-5 gap-12 lg:gap-16\"><div class=\"lg:col-span-3\"><form class=\"space-y-5 max-w-2xl\" novalidate=\"\" aria-label=\"Contact form\"><div><label class=\"text-sm font-medium text-foreground mb-1.5 block\">Full Name *</label><input class=\"flex w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm h-11\" required=\"\" value=\"\"></div><div><label for=\"email\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Email Address <span aria-label=\"required\">*</span></label><input type=\"email\" class=\"flex w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm h-11\" id=\"email\" required=\"\" aria-required=\"true\" aria-invalid=\"false\" value=\"\"></div><div><label for=\"phone\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Phone</label><input type=\"tel\" class=\"flex w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm h-11\" id=\"phone\" placeholder=\"+1 (___) ___-____\" aria-invalid=\"false\" value=\"\"></div><div><label for=\"organization\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Organization</label><input class=\"flex w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm h-11\" id=\"organization\" value=\"\"></div><div><label for=\"inquiry_type\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Nature of Inquiry <span aria-label=\"required\">*</span></label><button type=\"button\" role=\"combobox\" aria-controls=\"radix-:r0:\" aria-expanded=\"false\" aria-required=\"true\" aria-autocomplete=\"none\" dir=\"ltr\" data-state=\"closed\" data-placeholder=\"\" class=\"flex w-full items-center justify-between whitespace-nowrap rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm ring-offset-background data-[placeholder]:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50 [&amp;&gt;span]:line-clamp-1 h-11\" id=\"inquiry_type\" aria-invalid=\"true\"><span style=\"pointer-events: none;\">Select inquiry type</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down h-4 w-4 opacity-50\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><select aria-hidden=\"true\" required=\"\" tabindex=\"-1\" style=\"position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; overflow-wrap: normal;\"><option value=\"VEU AI Studio — Partnership / Investment\">VEU AI Studio — Partnership / Investment</option><option value=\"Afri Decarbonization Corporation — Project Inquiry\">Afri Decarbonization Corporation — Project Inquiry</option><option value=\"Advisory / Consulting Engagement\">Advisory / Consulting Engagement</option><option value=\"Speaking Engagement\">Speaking Engagement</option><option value=\"Abasi People Foundation\">Abasi People Foundation</option><option value=\"Book / Media / Press Inquiry\">Book / Media / Press Inquiry</option><option value=\"General Message\">General Message</option></select></div><div><label for=\"message\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Message <span aria-label=\"required\">*</span></label><textarea class=\"flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm\" id=\"message\" required=\"\" rows=\"5\" aria-required=\"true\" aria-describedby=\"message_hint\"></textarea><p id=\"message_hint\" class=\"text-xs text-muted-foreground mt-1\">Please provide details about your inquiry (minimum 10 characters)</p></div><div><label for=\"file_upload\" class=\"text-sm font-medium text-foreground mb-1.5 block\">Attachmen